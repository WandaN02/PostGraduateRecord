<!-- BACK TO DASHBOARD -->
<!-- ========================================= -->

<a href="@Url.Action("Dashboard", "Admin")"
   class="back-button">

    <i class="fa-solid fa-arrow-left"></i>

    Back to Dashboard

</a>

<style>
    /* =========================================
       REPORT PAGE HEADER
    ========================================= */

    .reports-page .page-header {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 30px;
    }

        .reports-page .page-header > div:first-child {
            flex: 1;
        }

        .reports-page .page-header h2 {
            margin: 0;
            color: #001B44;
            font-size: 28px;
            font-weight: 700;
        }

        .reports-page .page-header p {
            margin: 7px 0 0;
            color: #6c757d;
            font-size: 14px;
        }


    /* =========================================
       GENERATE DYNAMIC REPORT BUTTON
    ========================================= */

    .reports-page .generate-dynamic-report-btn {
        margin-left: auto;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        min-width: 220px;
        height: 48px;
        padding: 0 22px;
        background: #001B44;
        color: #ffffff !important;
        border: 2px solid #001B44;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 700;
        text-decoration: none !important;
        white-space: nowrap;
        cursor: pointer;
        box-shadow: 0 5px 14px rgba(0, 27, 68, 0.18);
        transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease, transform 0.25s ease, box-shadow 0.25s ease;
    }


        /* ICON */

        .reports-page .generate-dynamic-report-btn i {
            font-size: 16px;
        }


        /* HOVER */

        .reports-page .generate-dynamic-report-btn:hover {
            background: #FDB913;
            border-color: #FDB913;
            color: #001B44 !important;
            transform: translateY(-2px);
            box-shadow: 0 8px 18px rgba(253, 185, 19, 0.30);
        }


        /* ACTIVE */

        .reports-page .generate-dynamic-report-btn:active {
            transform: translateY(0);
            box-shadow: 0 4px 8px rgba(0, 27, 68, 0.15);
        }


        /* FOCUS */

        .reports-page .generate-dynamic-report-btn:focus {
            outline: none;
            color: #ffffff !important;
            box-shadow: 0 0 0 3px rgba(253, 185, 19, 0.25), 0 5px 14px rgba(0, 27, 68, 0.18);
        }


    /* =========================================
       MOBILE
    ========================================= */

    @@media (max-width: 768px) {

        .reports-page .page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .reports-page .generate-dynamic-report-btn {
            margin-left: 0;
            width: 100%;
        }
    }
</style>