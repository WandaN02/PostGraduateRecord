    <!-- =========================================
         ETHICS APPLICATION STATUS
    ========================================== -->

    <div class="report-section">

        <div class="report-section-header">

            <div>

                <h3>
                    <i class="fas fa-balance-scale"></i>
                    Ethics Application Status
                </h3>

                <p>
                    Overview of student ethics applications.
                </p>

            </div>

        </div>


        <div class="status-grid">

            <div class="status-box pending">

                <span>Pending</span>

                <strong>
                    @Model.PendingEthics
                </strong>

            </div>


            <div class="status-box submitted">

                <span>Submitted</span>

                <strong>
                    @Model.SubmittedEthics
                </strong>

            </div>


            <div class="status-box approved">

                <span>Approved</span>

                <strong>
                    @Model.ApprovedEthics
                </strong>

            </div>


            <div class="status-box rejected">

                <span>Rejected</span>

                <strong>
                    @Model.RejectedEthics
                </strong>

            </div>


            <div class="status-box revision">

                <span>Revision Required</span>

                <strong>
                    @Model.RevisionRequiredEthics
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================
         EVALUATION STATUS
    ========================================== -->

    <div class="report-section">

        <div class="report-section-header">

            <div>

                <h3>
                    <i class="fas fa-clipboard-check"></i>
                    Evaluation Status
                </h3>

                <p>
                    Overview of research proposal evaluations.
                </p>

            </div>

        </div>


        <div class="status-grid">

            <div class="status-box pending">

                <span>Pending</span>

                <strong>
                    @Model.PendingEvaluations
                </strong>

            </div>


            <div class="status-box review">

                <span>In Progress</span>

                <strong>
                    @Model.InProgressEvaluations
                </strong>

            </div>


            <div class="status-box approved">

                <span>Completed</span>

                <strong>
                    @Model.CompletedEvaluations
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================
         STUDENT PROGRESS
    ========================================== -->

    <div class="report-section">

        <div class="report-section-header">

            <div>

                <h3>
                    <i class="fas fa-chart-line"></i>
                    Student Progress
                </h3>

                <p>
                    Individual postgraduate student research progress.
                </p>

            </div>

        </div>


        <div class="table-wrapper">

            <table class="report-table">

                <thead>

                    <tr>

                        <th>Student</th>

                        <th>Student Number</th>

                        <th>Research Title</th>

                        <th>Progress</th>

                        <th>Status</th>

                        <th>Admin Message</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.StudentProgress != null &&
                         Model.StudentProgress.Any())
                    {

                        foreach (var student in Model.StudentProgress)
                        {

                            <tr>

                                <td>

                                    <strong>
                                        @student.StudentName
                                    </strong>

                                </td>


                                <td>
                                    @student.StudentNumber
                                </td>


                                <td>
                                    @student.ResearchTitle
                                </td>


                                <td>

                                    <div class="progress-container">

                                        <div class="progress-bar">

                                            <div class="progress-fill"
                                                 style="width:@student.ProgressPercentage%;">
                                            </div>

                                        </div>


                                        <span>
                                            @student.ProgressPercentage%
                                        </span>

                                    </div>

                                </td>


                                <td>

                                    @if (student.Status == "Completed")
                                    {

                                        <span class="status-badge completed">
                                            Completed
                                        </span>

                                    }
                                    else if (student.Status == "In Progress")
                                    {

                                        <span class="status-badge in-progress">
                                            In Progress
                                        </span>

                                    }
                                    else if (student.Status == "Proposal Stage")
                                    {

                                        <span class="status-badge proposal">
                                            Proposal Stage
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge not-started">
                                            Not Started
                                        </span>

                                    }

                                </td>
                                <td>

                                    @if (student.Status != "Completed")
                                    {
                                        using (Html.BeginForm(
                                            "SendProgressNotification",
                                            "Admin",
                                            FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="studentId"
                                                   value="@student.StudentID" />

                                            <div class="admin-message-box">

                                                <textarea name="message"
                                                          class="admin-message-input"
                                                          placeholder="Write a message to this student..."
                                                          rows="2"
                                                          required></textarea>

                                                <button type="submit"
                                                        class="admin-message-button">

                                                    <i class="fas fa-paper-plane"></i>
                                                    Send

                                                </button>

                                            </div>
                                        }
                                    }
                                    else
                                    {
                                        <span class="completed-message">
                                            No message required
                                        </span>
                                    }

                                </td>
                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="6"
                                class="empty-message">

                                No student progress information is available.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================
         SUPERVISOR WORKLOAD
    ========================================== -->

    <div class="report-section">

        <div class="report-section-header">

            <div>

                <h3>
                    <i class="fas fa-user-tie"></i>
                    Supervisor Workload
                </h3>

                <p>
                    Overview of supervisor student assignments and reviews.
                </p>

            </div>

        </div>


        <div class="table-wrapper">

            <table class="report-table">

                <thead>

                    <tr>

                        <th>Supervisor</th>

                        <th>Assigned Students</th>

                        <th>Pending Reviews</th>

                    </tr>

                </thead>


                <tbody>

                    @if (Model.SupervisorWorkload != null &&
                         Model.SupervisorWorkload.Any())
                    {

                        foreach (var supervisor in Model.SupervisorWorkload)
                        {

                            <tr>

                                <td>

                                    <strong>
                                        @supervisor.SupervisorName
                                    </strong>

                                </td>


                                <td>
                                    @supervisor.AssignedStudents
                                </td>


                                <td>

                                    @if (supervisor.PendingReviews > 0)
                                    {

                                        <span class="status-badge in-progress">
                                            @supervisor.PendingReviews
                                        </span>

                                    }
                                    else
                                    {

                                        <span class="status-badge completed">
                                            0
                                        </span>

                                    }

                                </td>

                            </tr>

                        }

                    }
                    else
                    {

                        <tr>

                            <td colspan="3"
                                class="empty-message">

                                No supervisor workload information is available.

                            </td>

                        </tr>

                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

<br />
