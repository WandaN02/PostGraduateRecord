@model PostGraduateRecord.ViewModels.ReportFilterViewModel

@{
    ViewBag.Title = "Dynamic Reports";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="dynamic-reports-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <div class="dynamic-page-header">

        <div class="dynamic-title-row">

            <div class="dynamic-title-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>

                <span class="page-kicker">
                    SPGS MANAGEMENT REPORTING
                </span>

                <h2>
                    Dynamic Reports
                </h2>

                <p>
                    Generate filtered postgraduate reports and
                    management insights from the SPGS database.
                </p>

            </div>

        </div>


        <a href="@Url.Action("Reports", "Admin")"
           class="back-report-button">

            <i class="fas fa-arrow-left"></i>

            Back to Reports

        </a>

    </div>


    <!-- =========================================================
         MAIN FILTER CARD
    ========================================================== -->

    <div class="dynamic-report-card">

        <div class="dynamic-card-header">

            <div class="header-icon">
                <i class="fas fa-filter"></i>
            </div>

            <div>

                <h3>
                    Report Configuration
                </h3>

                <p>
                    Select a report type and apply one or more
                    filters to generate targeted information.
                </p>

            </div>

        </div>


        @using (Html.BeginForm(
            "DynamicReports",
            "Admin",
            FormMethod.Post,
            new { @class = "dynamic-report-form" }))
        {
            @Html.AntiForgeryToken()


            <!-- REPORT TYPE -->

            <div class="filter-group report-type-group">

                <label for="ReportType">
                    Report Type
                    <span>*</span>
                </label>

                @Html.DropDownListFor(
                    m => m.ReportType,
                    Model.ReportTypes ??
                    Enumerable.Empty<SelectListItem>(),
                    "-- Select Report Type --",
                    new
                    {
                        @class = "filter-input",
                        id = "ReportType"
                    })

                @Html.ValidationMessageFor(
                    m => m.ReportType,
                    "",
                    new
                    {
                        @class = "validation-message"
                    })

            </div>


            <!-- FILTER GRID -->

            <div class="filter-section-title">

                <i class="fas fa-sliders"></i>

                Additional Filters

            </div>


            <div class="filter-grid">

                <!-- DEPARTMENT -->

                <div class="filter-group">

                    <label for="DepartmentID">
                        Department
                    </label>

                    @Html.DropDownListFor(
                        m => m.DepartmentID,
                        Model.Departments ??
                        Enumerable.Empty<SelectListItem>(),
                        "-- All Departments --",
                        new
                        {
                            @class = "filter-input",
                            id = "DepartmentID"
                        })

                </div>


                <!-- REGISTRATION YEAR -->

                <div class="filter-group">

                    <label for="RegistrationYear">
                        Registration Year
                    </label>

                    @Html.DropDownListFor(
                        m => m.RegistrationYear,
                        Model.RegistrationYears ??
                        Enumerable.Empty<SelectListItem>(),
                        "-- All Years --",
                        new
                        {
                            @class = "filter-input",
                            id = "RegistrationYear"
                        })

                </div>


                <!-- QUALIFICATION -->

                <div class="filter-group">

                    <label for="Qualification">
                        Qualification
                    </label>

                    @Html.DropDownListFor(
                        m => m.Qualification,
                        Model.Qualifications ??
                        Enumerable.Empty<SelectListItem>(),
                        "-- All Qualifications --",
                        new
                        {
                            @class = "filter-input",
                            id = "Qualification"
                        })

                </div>


                <!-- STUDY TYPE -->

                <div class="filter-group">

                    <label for="StudyType">
                        Study Type
                    </label>

                    @Html.DropDownListFor(
                        m => m.StudyType,
                        Model.StudyTypes ??
                        Enumerable.Empty<SelectListItem>(),
                        "-- All Study Types --",
                        new
                        {
                            @class = "filter-input",
                            id = "StudyType"
                        })

                </div>


                <!-- STATUS -->

                <div class="filter-group">

                    <label for="Status">
                        Status
                    </label>

                    @Html.DropDownListFor(
                        m => m.Status,
                        Model.Statuses ??
                        Enumerable.Empty<SelectListItem>(),
                        "-- All Statuses --",
                        new
                        {
                            @class = "filter-input",
                            id = "Status"
                        })

                </div>


                <!-- START DATE -->

                <div class="filter-group">

                    <label for="StartDate">
                        Start Date
                    </label>

                    @Html.TextBoxFor(
                        m => m.StartDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "filter-input",
                            id = "StartDate",
                            type = "date"
                        })

                </div>


                <!-- END DATE -->

                <div class="filter-group">

                    <label for="EndDate">
                        End Date
                    </label>

                    @Html.TextBoxFor(
                        m => m.EndDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "filter-input",
                            id = "EndDate",
                            type = "date"
                        })

                </div>


                <!-- SEARCH -->

                <div class="filter-group search-group">

                    <label for="Search">
                        Search
                    </label>

                    <div class="search-input-wrapper">

                        <i class="fas fa-search"></i>

                        @Html.TextBoxFor(
                            m => m.Search,
                            new
                            {
                                @class = "filter-input",
                                id = "Search",
                                placeholder =
                                    "Student name, number, title..."
                            })

                    </div>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="filter-actions">

                <button type="submit"
                        class="generate-report-button">

                    <i class="fas fa-chart-column"></i>

                    Generate Report

                </button>


                <a href="@Url.Action(
                    "DynamicReports",
                    "Admin")"
                   class="reset-report-button">

                    <i class="fas fa-rotate-left"></i>

                    Reset Filters

                </a>

            </div>

        }

    </div>


    <!-- =========================================================
         REPORT TYPES
    ========================================================== -->

    <div class="available-reports">

        <div class="section-heading">

            <span>
                AVAILABLE REPORTS
            </span>

            <h3>
                What can you analyse?
            </h3>

        </div>


        <div class="report-type-grid">

            <div class="report-type-card">

                <div class="report-type-icon">
                    <i class="fas fa-user-graduate"></i>
                </div>

                <h4>
                    Students
                </h4>

                <p>
                    Analyse postgraduate students by department,
                    qualification, study type and registration year.
                </p>

            </div>


            <div class="report-type-card">

                <div class="report-type-icon">
                    <i class="fas fa-file-circle-check"></i>
                </div>

                <h4>
                    Applications
                </h4>

                <p>
                    Monitor applications, submission dates,
                    research fields and application outcomes.
                </p>

            </div>


            <div class="report-type-card">

                <div class="report-type-icon">
                    <i class="fas fa-file-signature"></i>
                </div>

                <h4>
                    Proposals
                </h4>

                <p>
                    Analyse proposal submissions and identify
                    proposals requiring further review.
                </p>

            </div>


            <div class="report-type-card">

                <div class="report-type-icon">
                    <i class="fas fa-clipboard-check"></i>
                </div>

                <h4>
                    Evaluations
                </h4>

                <p>
                    Review evaluation scores, recommendations
                    and outstanding evaluation outcomes.
                </p>

            </div>


            <div class="report-type-card">

                <div class="report-type-icon">
                    <i class="fas fa-chart-line"></i>
                </div>

                <h4>
                    Progress Reports
                </h4>

                <p>
                    Monitor postgraduate progress and identify
                    students who may require additional attention.
                </p>

            </div>

        </div>

    </div>


    <!-- =========================================================
         INFORMATION
    ========================================================== -->

    <div class="dynamic-information-card">

        <div class="information-icon">
            <i class="fas fa-lightbulb"></i>
        </div>

        <div>

            <span class="info-label">
                REPORTING TIP
            </span>

            <h4>
                Use multiple filters for targeted analysis
            </h4>

            <p>
                For example, you can generate a Progress Report
                for a specific department, qualification and
                registration year to identify trends within a
                particular postgraduate group.
            </p>

        </div>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
    ========================================================== */

    .dynamic-reports-page {
        padding: 10px 5px 45px;
    }


    /* =========================================================
       HEADER
    ========================================================== */

    .dynamic-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 28px;
    }

    .dynamic-title-row {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .dynamic-title-icon {
        width: 54px;
        height: 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #001B44;
        color: #FDB913;
        border-radius: 13px;
        font-size: 22px;
        flex-shrink: 0;
    }

    .page-kicker,
    .section-heading span,
    .info-label {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        color: #7b8494;
    }

    .dynamic-page-header h2 {
        margin: 3px 0 5px;
        color: #001B44;
        font-size: 28px;
        font-weight: 750;
    }

    .dynamic-page-header p {
        margin: 0;
        color: #6b7280;
        font-size: 13px;
    }


    /* =========================================================
       BACK
    ========================================================== */

    .back-report-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 17px;
        border: 1px solid #d9dee7;
        border-radius: 8px;
        background: #fff;
        color: #001B44;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        transition: all .2s ease;
    }

        .back-report-button:hover {
            background: #001B44;
            color: #fff;
            text-decoration: none;
        }


    /* =========================================================
       MAIN CARD
    ========================================================== */

    .dynamic-report-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 14px;
        box-shadow: 0 4px 18px rgba(0,0,0,.05);
        overflow: hidden;
    }

    .dynamic-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 22px 25px;
        border-bottom: 1px solid #edf0f4;
        background: #fafbfd;
    }

    .header-icon {
        width: 40px;
        height: 40px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #001B44;
        color: #FDB913;
    }

    .dynamic-card-header h3 {
        margin: 0 0 4px;
        color: #001B44;
        font-size: 18px;
    }

    .dynamic-card-header p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
    }


    /* =========================================================
       FORM
    ========================================================== */

    .dynamic-report-form {
        padding: 25px;
    }

    .filter-group {
        display: flex;
        flex-direction: column;
    }

    .report-type-group {
        max-width: 600px;
    }

    .filter-group label {
        margin-bottom: 7px;
        color: #374151;
        font-size: 12px;
        font-weight: 700;
    }

        .filter-group label span {
            color: #dc2626;
        }

    .filter-section-title {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-top: 25px;
        padding-bottom: 10px;
        border-bottom: 1px solid #edf0f4;
        color: #001B44;
        font-size: 13px;
        font-weight: 800;
    }

        .filter-section-title i {
            color: #FDB913;
        }

    .filter-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 19px;
        margin-top: 20px;
    }

    .filter-input {
        width: 100%;
        min-height: 43px;
        padding: 10px 12px;
        border: 1px solid #d8dee8;
        border-radius: 8px;
        background: #fff;
        color: #1f2937;
        font-size: 13px;
        outline: none;
        transition: all .2s ease;
    }

        .filter-input:focus {
            border-color: #001B44;
            box-shadow: 0 0 0 3px rgba(0,27,68,.08);
        }

        .filter-input::placeholder {
            color: #9ca3af;
        }


    /* =========================================================
       SEARCH
    ========================================================== */

    .search-input-wrapper {
        position: relative;
    }

        .search-input-wrapper > i {
            position: absolute;
            left: 13px;
            top: 14px;
            color: #9ca3af;
            font-size: 13px;
            z-index: 2;
        }

        .search-input-wrapper .filter-input {
            padding-left: 36px;
        }


    /* =========================================================
       ACTIONS
    ========================================================== */

    .filter-actions {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-top: 28px;
        padding-top: 21px;
        border-top: 1px solid #edf0f4;
    }

    .generate-report-button,
    .reset-report-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 44px;
        padding: 10px 19px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: all .2s ease;
    }

    .generate-report-button {
        border: none;
        background: #001B44;
        color: #fff;
    }

        .generate-report-button i {
            color: #FDB913;
        }

        .generate-report-button:hover {
            background: #FDB913;
            color: #001B44;
            transform: translateY(-1px);
        }

            .generate-report-button:hover i {
                color: #001B44;
            }

    .reset-report-button {
        border: 1px solid #d8dee8;
        background: #fff;
        color: #374151;
    }

        .reset-report-button:hover {
            background: #f3f4f6;
            color: #001B44;
            text-decoration: none;
        }


    /* =========================================================
       AVAILABLE REPORTS
    ========================================================== */

    .available-reports {
        margin-top: 30px;
    }

    .section-heading {
        margin-bottom: 14px;
    }

        .section-heading h3 {
            margin: 3px 0 0;
            color: #001B44;
            font-size: 19px;
        }

    .report-type-grid {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
    }

    .report-type-card {
        padding: 18px;
        background: #fff;
        border: 1px solid #e7eaf0;
        border-radius: 12px;
        box-shadow: 0 4px 14px rgba(0,0,0,.035);
        transition: all .2s ease;
    }

        .report-type-card:hover {
            transform: translateY(-2px);
            border-color: #f0d17c;
            box-shadow: 0 7px 18px rgba(0,0,0,.07);
        }

    .report-type-icon {
        width: 39px;
        height: 39px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 12px;
        border-radius: 9px;
        background: #fff5d9;
        color: #b17b00;
    }

    .report-type-card h4 {
        margin: 0 0 6px;
        color: #001B44;
        font-size: 14px;
    }

    .report-type-card p {
        margin: 0;
        color: #737d8d;
        font-size: 11px;
        line-height: 1.55;
    }


    /* =========================================================
       INFORMATION
    ========================================================== */

    .dynamic-information-card {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        margin-top: 22px;
        padding: 19px 20px;
        border: 1px solid #e6eaf0;
        border-radius: 12px;
        background: #f8fafc;
    }

    .information-icon {
        width: 38px;
        height: 38px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 9px;
        background: #001B44;
        color: #FDB913;
    }

    .dynamic-information-card h4 {
        margin: 3px 0 4px;
        color: #001B44;
        font-size: 14px;
    }

    .dynamic-information-card p {
        margin: 0;
        color: #6b7280;
        font-size: 12px;
        line-height: 1.6;
    }


    /* =========================================================
       VALIDATION
    ========================================================== */

    .validation-message {
        margin-top: 5px;
        color: #dc2626;
        font-size: 11px;
    }


    /* =========================================================
       RESPONSIVE
    ========================================================== */

    @@media (max-width: 1200px) {

        .report-type-grid {
            grid-template-columns: repeat(3, 1fr);
        }
    }

    @@media (max-width: 850px) {

        .dynamic-page-header {
            align-items: flex-start;
            flex-direction: column;
        }

        .filter-grid {
            grid-template-columns: 1fr;
        }

        .report-type-grid {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 550px) {

        .dynamic-title-row {
            align-items: flex-start;
        }

        .dynamic-title-icon {
            width: 45px;
            height: 45px;
        }

        .dynamic-page-header h2 {
            font-size: 23px;
        }

        .dynamic-report-form {
            padding: 18px;
        }

        .filter-actions {
            align-items: stretch;
            flex-direction: column;
        }

        .generate-report-button,
        .reset-report-button {
            width: 100%;
        }

        .report-type-grid {
            grid-template-columns: 1fr;
        }
    }
</style>