@model PostGraduateRecord.ViewModels.DynamicReportViewModel

@{
    ViewBag.Title = "Dynamic Report";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="report-page">

    <!-- =========================================================
         REPORT HEADER
    ========================================================== -->

    <div class="report-header">

        <div class="report-heading">

            <div class="report-title-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>
                <div class="report-kicker">
                    SPGS MANAGEMENT REPORT
                </div>

                <h2>@Model.ReportTitle</h2>

                <p>
                    Generated on @Model.GeneratedDate
                </p>

            </div>

        </div>


        <div class="report-actions">

            <a href="@Url.Action("DynamicReports", "Admin")"
               class="btn-secondary">

                <i class="fas fa-plus"></i>

                New Report

            </a>


            <a href="@Url.Action("ExportDynamicReportToExcel", "Admin")"
               class="btn-excel">

                <i class="fas fa-file-excel"></i>

                Excel

            </a>


            <button type="button"
                    class="btn-primary"
                    onclick="window.print();">

                <i class="fas fa-print"></i>

                Print / PDF

            </button>

        </div>

    </div>


    <!-- =========================================================
         REPORT DESCRIPTION
    ========================================================== -->

    @if (!string.IsNullOrWhiteSpace(Model.ReportDescription))
    {
        <div class="report-description-card">

            <div class="description-icon">
                <i class="fas fa-circle-info"></i>
            </div>

            <div>

                <span class="description-label">
                    REPORT OVERVIEW
                </span>

                <p>
                    @Model.ReportDescription
                </p>

            </div>

        </div>
    }


    <!-- =========================================================
         SUMMARY CARDS
    ========================================================== -->

    <div class="summary-grid">

        <div class="summary-card">

            <div class="summary-icon navy">
                <i class="fas fa-database"></i>
            </div>

            <div class="summary-content">

                <span>Total Records</span>

                <strong>
                    @Model.TotalRecords
                </strong>

                <small>
                    Records matching the selected filters
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon blue">
                <i class="fas fa-spinner"></i>
            </div>

            <div class="summary-content">

                <span>Active Records</span>

                <strong>
                    @Model.ActiveRecords
                </strong>

                <small>
                    Records requiring ongoing attention
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon orange">
                <i class="fas fa-clock"></i>
            </div>

            <div class="summary-content">

                <span>Pending</span>

                <strong>
                    @Model.PendingRecords
                </strong>

                <small>
                    Records awaiting completion or action
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon green">
                <i class="fas fa-check-circle"></i>
            </div>

            <div class="summary-content">

                <span>Completed</span>

                <strong>
                    @Model.CompletedRecords
                </strong>

                <small>
                    Completed or approved records
                </small>

            </div>

        </div>


        <div class="summary-card">

            <div class="summary-icon red">
                <i class="fas fa-triangle-exclamation"></i>
            </div>

            <div class="summary-content">

                <span>At Risk</span>

                <strong>
                    @Model.AtRiskRecords
                </strong>

                <small>
                    Records requiring additional attention
                </small>

            </div>

        </div>

    </div>


    <!-- =========================================================
         APPLIED FILTERS
    ========================================================== -->

    <div class="filter-summary">

        <div class="filter-summary-header">

            <div>

                <h3>
                    <i class="fas fa-filter"></i>
                    Applied Filters
                </h3>

                <p>
                    Criteria used to generate this report
                </p>

            </div>

            <a href="@Url.Action("DynamicReports", "Admin")"
               class="change-filter-link">

                <i class="fas fa-sliders"></i>

                Change Filters

            </a>

        </div>


        <div class="filter-items">

            @if (!string.IsNullOrWhiteSpace(Model.Filters.Search))
            {
                <span class="filter-badge">

                    <i class="fas fa-search"></i>

                    Search:
                    <strong>@Model.Filters.Search</strong>

                </span>
            }


            @if (Model.Filters.DepartmentID.HasValue)
            {
                var department =
                    Model.Filters.Departments
                        .FirstOrDefault(d =>
                            d.Value ==
                            Model.Filters.DepartmentID.Value.ToString());

                if (department != null)
                {
                    <span class="filter-badge">

                        <i class="fas fa-building"></i>

                        Department:
                        <strong>@department.Text</strong>

                    </span>
                }
            }


            @if (Model.Filters.RegistrationYear.HasValue)
            {
                <span class="filter-badge">

                    <i class="fas fa-calendar"></i>

                    Registration Year:
                    <strong>@Model.Filters.RegistrationYear</strong>

                </span>
            }


            @if (!string.IsNullOrWhiteSpace(Model.Filters.Qualification))
            {
                <span class="filter-badge">

                    <i class="fas fa-graduation-cap"></i>

                    Qualification:
                    <strong>@Model.Filters.Qualification</strong>

                </span>
            }


            @if (!string.IsNullOrWhiteSpace(Model.Filters.StudyType))
            {
                <span class="filter-badge">

                    <i class="fas fa-clock"></i>

                    Study Type:
                    <strong>@Model.Filters.StudyType</strong>

                </span>
            }


            @if (!string.IsNullOrWhiteSpace(Model.Filters.Status))
            {
                <span class="filter-badge">

                    <i class="fas fa-tag"></i>

                    Status:
                    <strong>@Model.Filters.Status</strong>

                </span>
            }


            @if (Model.Filters.StartDate.HasValue)
            {
                <span class="filter-badge">

                    <i class="fas fa-calendar-days"></i>

                    From:
                    <strong>
                        @Model.Filters.StartDate.Value.ToString("dd MMM yyyy")
                    </strong>

                </span>
            }


            @if (Model.Filters.EndDate.HasValue)
            {
                <span class="filter-badge">

                    <i class="fas fa-calendar-days"></i>

                    To:
                    <strong>
                        @Model.Filters.EndDate.Value.ToString("dd MMM yyyy")
                    </strong>

                </span>
            }


            @if (
                string.IsNullOrWhiteSpace(Model.Filters.Search)
                && !Model.Filters.DepartmentID.HasValue
                && !Model.Filters.RegistrationYear.HasValue
                && string.IsNullOrWhiteSpace(Model.Filters.Qualification)
                && string.IsNullOrWhiteSpace(Model.Filters.StudyType)
                && string.IsNullOrWhiteSpace(Model.Filters.Status)
                && !Model.Filters.StartDate.HasValue
                && !Model.Filters.EndDate.HasValue
            )
            {
                <span class="no-filter-badge">

                    <i class="fas fa-globe"></i>

                    All available records

                </span>
            }

        </div>

    </div>


    <!-- =========================================================
         ANALYTICS / CHARTS
    ========================================================== -->

    @if (Model.Charts != null && Model.Charts.Any())
    {
        <div class="section-heading">

            <div>

                <span class="section-kicker">
                    DATA ANALYSIS
                </span>

                <h3>
                    Report Analytics
                </h3>

                <p>
                    Visual representation of the information contained
                    in the generated report.
                </p>

            </div>

        </div>


        <div class="charts-grid">

            @for (int i = 0; i < Model.Charts.Count; i++)
            {
                var chart = Model.Charts[i];

                <div class="chart-card">

                    <div class="chart-card-header">

                        <div>

                            <h4>
                                @chart.Title
                            </h4>

                            <span>
                                Distribution of report data
                            </span>

                        </div>

                        <div class="chart-icon">
                            <i class="fas fa-chart-column"></i>
                        </div>

                    </div>

                    <div class="chart-container">

                        <canvas id="reportChart_@i"></canvas>

                    </div>

                </div>
            }

        </div>
    }


    <!-- =========================================================
         KEY FINDINGS
    ========================================================== -->

    @if (Model.KeyFindings != null && Model.KeyFindings.Any())
    {
        <div class="analysis-card">

            <div class="analysis-header">

                <div class="analysis-icon">
                    <i class="fas fa-lightbulb"></i>
                </div>

                <div>

                    <span class="section-kicker">
                        MANAGEMENT INSIGHT
                    </span>

                    <h3>
                        Key Findings
                    </h3>

                </div>

            </div>


            <div class="findings-list">

                @foreach (var finding in Model.KeyFindings)
                {
                    <div class="finding-item">

                        <div class="finding-number">
                            <i class="fas fa-check"></i>
                        </div>

                        <p>
                            @finding
                        </p>

                    </div>
                }

            </div>

        </div>
    }


    <!-- =========================================================
         REPORT TABLE
    ========================================================== -->

    <div class="report-card">

        <div class="report-card-header">

            <div>

                <span class="section-kicker">
                    DETAILED RECORDS
                </span>

                <h3>
                    @Model.ReportTitle
                </h3>

                <p>
                    @Model.TotalRecords record(s) found
                    based on the selected criteria.
                </p>

            </div>

            <div class="record-count">

                <strong>
                    @Model.TotalRecords
                </strong>

                <span>
                    Records
                </span>

            </div>

        </div>


        @if (Model.Rows != null && Model.Rows.Any())
        {
            <div class="table-wrapper">

                <table class="report-table">

                    <thead>

                        <tr>

                            @foreach (var column in Model.Columns)
                            {
                                <th>
                                    @column
                                </th>
                            }

                        </tr>

                    </thead>


                    <tbody>

                        @foreach (var row in Model.Rows)
                        {
                            <tr>

                                @foreach (var column in Model.Columns)
                                {
                                    <td>

                                        @if (row.ContainsKey(column))
                                        {
                                            @row[column]
                                        }
                                        else
                                        {
                                            <span class="empty-cell">
                                                -
                                            </span>
                                        }

                                    </td>
                                }

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-report">

                <div class="empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h3>
                    No Records Found
                </h3>

                <p>
                    No records matched the selected report filters.
                    Try changing the filters and generate the report again.
                </p>

                <a href="@Url.Action("DynamicReports", "Admin")"
                   class="btn-primary">

                    <i class="fas fa-filter"></i>

                    Change Filters

                </a>

            </div>
        }

    </div>


    <!-- =========================================================
         REPORT FOOTER
    ========================================================== -->

    <div class="report-footer">

        <div>

            <strong>
                SPGS Postgraduate Record-Keeping System
            </strong>

            <span>
                Dynamic Management Report
            </span>

        </div>

        <div>

            Generated:
            <strong>@Model.GeneratedDate</strong>

        </div>

    </div>

</div>


<!-- =============================================================
     CHART.JS
============================================================== -->

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>

    document.addEventListener("DOMContentLoaded", function () {

        var charts = @Html.Raw(
            Newtonsoft.Json.JsonConvert.SerializeObject(Model.Charts)
        );

        charts.forEach(function (chart, index) {

            var canvas =
                document.getElementById("reportChart_" + index);

            if (!canvas) {
                return;
            }

            var chartType =
                chart.ChartType || "bar";

            if (chartType === "column") {
                chartType = "bar";
            }

            if (chartType === "doughnut") {

                new Chart(canvas, {

                    type: "doughnut",

                    data: {
                        labels: chart.Labels,
                        datasets: [{
                            data: chart.Values
                        }]
                    },

                    options: {

                        responsive: true,

                        maintainAspectRatio: false,

                        plugins: {

                            legend: {
                                position: "bottom"
                            }

                        }

                    }

                });

                return;
            }


            new Chart(canvas, {

                type: chartType,

                data: {

                    labels: chart.Labels,

                    datasets: [{

                        label: chart.Title,

                        data: chart.Values

                    }]

                },

                options: {

                    responsive: true,

                    maintainAspectRatio: false,

                    scales: {

                        y: {
                            beginAtZero: true,

                            ticks: {
                                precision: 0
                            }
                        }

                    },

                    plugins: {

                        legend: {
                            display: false
                        }

                    }

                }

            });

        });

    });

</script>


<style>

