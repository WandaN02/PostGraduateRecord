<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewBag.Title - SPGS Record System</title>

    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/Student.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" rel="stylesheet" />
</head>
<body>

    <div class="wrapper">

        <!-- Sidebar -->
        <div class="sidebar">

            <h2>SPGS</h2>

            <ul>

                <li>
                    <a href="@Url.Action("Dashboard","Student")">
                        <i class="fa-solid fa-house"></i> Dashboard
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Create","Proposal")">
                        <i class="fa-solid fa-file-lines"></i> Proposal
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Ethics","Student")">
                        <i class="fa-solid fa-scale-balanced"></i> Ethics
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("NewApplication","Student")">
                        <i class="fa-solid fa-square-plus"></i> New Application
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Submissions","Student")">
                        <i class="fa-solid fa-upload"></i> Submission
                    </a>
                </li>

                <li>
                    <a href="@Url.Action("Logout","Account")">
                        <i class="fa-solid fa-right-from-bracket"></i> Logout
                    </a>
                </li>

            </ul>

        </div>

        <!-- Main -->
        <div class="main">

            <!-- Topbar -->
            <div class="topbar">

                <h3>🎓 SPGS Record Management System</h3>

                <div style="display:flex;align-items:center;gap:25px;">

                    <!-- Notifications -->
                    <div class="notification-container">

                        <div class="notification-icon" onclick="toggleNotifications()">

                            <i class="fa-solid fa-bell"></i>

                            <span class="notification-badge">
                                3
                            </span>

                        </div>

                        <div class="notification-panel" id="notificationPanel">

                            <h5>Notifications</h5>

                            <hr />

                            <p>No new notifications.</p>

                        </div>

                    </div>

                    <!-- User -->
                    <div class="user-area">
                        <a href="@Url.Action("Index","Profile")"
                           style="display:flex;align-items:center;gap:10px;text-decoration:none;color:inherit;">

                            <i class="fa-solid fa-circle-user fa-2x"></i>

                            <div style="display:flex;flex-direction:column;text-align:right;">

                                <div class="student-name">
                                    @Session["StudentName"]
                                </div>

                                <small>
                                    @DateTime.Now.ToString("dd MMMM yyyy")
                                </small>

                            </div>

                        </a>

                    </div>

                </div>

            </div>

            <!-- Content -->
            <div class="content">

                @RenderBody()

            </div>

        </div>

    </div>

    <script>

        function toggleNotifications() {

            var panel = document.getElementById("notificationPanel");

            if (panel.style.display === "block") {
                panel.style.display = "none";
            }
            else {
                panel.style.display = "block";
            }
        }

        window.onclick = function (event) {

            if (!event.target.closest('.notification-container')) {

                var panel = document.getElementById("notificationPanel");

                if (panel) {
                    panel.style.display = "none";
                }

            }

        };

    </script>

</body>
</html>
