@{
    ViewBag.Title = "Submit Proposal";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h2>Submit Research Proposal</h2>

@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        <strong>Success!</strong> @ViewBag.SuccessMessage
    </div>
}
<hr />

@if (ViewBag.Message != null)
{
    <div class="alert alert-danger">
        @ViewBag.Message
    </div>
}

@using (Html.BeginForm("Create",
                       "Proposal",
                       FormMethod.Post,
                       new { enctype = "multipart/form-data" }))
{
    <div class="form-group">

        <label>Proposal Title</label>

        <input type="text"
               name="title"
               class="form-control"
               placeholder="Enter proposal title"
               required />

    </div>


    <div class="form-group">

        <label>Research Field</label>

        <input type="text"
               name="researchField"
               class="form-control"
               placeholder="e.g. Artificial Intelligence"
               required />

    </div>


    <div class="form-group">

        <label>Abstract</label>

        <textarea name="abstractText"
                  class="form-control"
                  rows="6"
                  placeholder="Enter research abstract"
                  required></textarea>

    </div>


    <div class="form-group">

        <label>Keywords</label>

        <input type="text"
               name="keywords"
               class="form-control"
               placeholder="Example: AI, Machine Learning, Security"
               required />

    </div>
    <div class="form-group">

        <label>Proposal Document (PDF or DOCX)</label>

        <input type="file"
               name="proposalFile"
               class="form-control"
               accept=".pdf,.doc,.docx" />

    </div>


    <br />

    <button type="submit" class="btn btn-primary">
        Submit Proposal
    </button>

}
