@model IEnumerable<PostGraduateRecord.Models.EthicsApplication>

@{
    ViewBag.Title = "Ethics Applications";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}


<div class="ethics-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="page-header">

        <div>

            <div class="page-label">

                <i class="fa-solid fa-scale-balanced"></i>

                SUPERVISOR WORKSPACE

            </div>

            <h2>

                Ethics Applications

            </h2>

            <p>

                Review ethics applications submitted by your assigned students.

            </p>

        </div>


        <div class="header-icon">

            <i class="fa-solid fa-scale-balanced"></i>

        </div>

    </div>


    <!-- =========================================================
         ETHICS APPLICATIONS
         ========================================================= -->

    @if (Model != null && Model.Any())
    {
        <div class="ethics-list">

            @foreach (var item in Model)
            {
                <div class="ethics-card">


                    <!-- =================================================
                         CARD HEADER
                         ================================================= -->

                    <div class="ethics-header">

                        <div class="ethics-title">

                            <div class="ethics-icon">

                                <i class="fa-solid fa-file-shield"></i>

                            </div>


                            <div>

                                <span class="application-type">

                                    ETHICS APPLICATION

                                </span>

                                <h3>

                                    @item.ResearchTitle

                                </h3>

                            </div>

                        </div>


                        <!-- STATUS -->

                        @if (item.Status == "Approved")
                        {
                            <span class="status approved">

                                <i class="fa-solid fa-circle-check"></i>

                                Approved

                            </span>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <span class="status rejected">

                                <i class="fa-solid fa-circle-xmark"></i>

                                Rejected

                            </span>
                        }
                        else
                        {
                            <span class="status pending">

                                <i class="fa-solid fa-clock"></i>

                                @(string.IsNullOrWhiteSpace(item.Status)
                                    ? "Pending"
                                    : item.Status)

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         DETAILS
                         ================================================= -->

                    <div class="ethics-details">


                        <!-- STUDENT -->

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="fa-solid fa-user-graduate"></i>

                            </div>

                            <div>

                                <span class="detail-label">
                                    STUDENT
                                </span>

                                <strong>

                                    @if (item.Student != null &&
                                         item.Student.User != null)
                                    {
                                        @item.Student.User.FirstName
                                        @item.Student.User.LastName
                                    }
                                    else
                                    {
                                        <span>
                                            Not available
                                        </span>
                                    }

                                </strong>

                            </div>

                        </div>


                        <!-- SUBMITTED DATE -->

                        <div class="detail-item">

                            <div class="detail-icon">

                                <i class="fa-solid fa-calendar"></i>

                            </div>

                            <div>

                                <span class="detail-label">
                                    SUBMITTED
                                </span>

                                <strong>

                                    @(item.SubmissionDate.HasValue
                                        ? item.SubmissionDate.Value.ToString("dd MMM yyyy")
                                        : "N/A")

                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTIONS
                         ================================================= -->

                    <div class="ethics-actions">


                        @if (!string.IsNullOrWhiteSpace(item.DocumentPath))
                        {
                            <a href="@Url.Content(item.DocumentPath)"
                               target="_blank"
                               class="view-button">

                                <i class="fa-solid fa-file-pdf"></i>

                                View Document

                                <i class="fa-solid fa-arrow-up-right-from-square external-icon"></i>

                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="view-button disabled-button"
                                    disabled>

                                <i class="fa-solid fa-file-circle-xmark"></i>

                                No Document

                            </button>
                        }


                        <a href="@Url.Action(
                                    "ReviewEthics",
                                    "Supervisors",
                                    new { id = item.EthicsID })"
                           class="review-button">

                            <i class="fa-solid fa-clipboard-check"></i>

                            Review Ethics

                            <i class="fa-solid fa-arrow-right arrow"></i>

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- =========================================================
             EMPTY STATE
             ========================================================= -->

        <div class="empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-scale-balanced"></i>

            </div>

            <h3>

                No Ethics Applications

            </h3>

            <p>

                No ethics applications have been submitted by your
                assigned students.

            </p>

        </div>
    }


    <!-- =========================================================
         BOTTOM BACK BUTTON
         ========================================================= -->

    <div class="bottom-back-container">

        <a href="@Url.Action("Dashboard", "Supervisors")"
           class="bottom-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .ethics-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 25px 10px 60px;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .page-header {
        background: #002b5c;
        color: white;
        border-radius: 14px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .page-label {
        color: #FDB913;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }


    .page-header h2 {
        margin: 0;
        color: white;
        font-size: 27px;
        font-weight: 700;
    }


    .page-header p {
        margin: 5px 0 0;
        color: #d8e3ee;
        font-size: 13px;
    }


    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 11px;
        background: #FDB913;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /* =========================================================
       LIST
       ========================================================= */

    .ethics-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }


    /* =========================================================
       CARD
       ========================================================= */

    .ethics-card {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        overflow: hidden;
        transition: .2s ease;
    }


        .ethics-card:hover {
            border-color: #b9c7d5;
            box-shadow: 0 5px 16px rgba(0,0,0,.06);
            transform: translateY(-1px);
        }


    /* =========================================================
       CARD HEADER
       ========================================================= */

    .ethics-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e9ee;
        gap: 20px;
    }


    .ethics-title {
        display: flex;
        align-items: center;
        min-width: 0;
    }


    .ethics-icon {
        width: 46px;
        height: 46px;
        border-radius: 10px;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
        margin-right: 13px;
        flex-shrink: 0;
    }


    .application-type {
        display: block;
        color: #7b8997;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        margin-bottom: 3px;
    }


    .ethics-title h3 {
        margin: 0;
        color: #172b4d;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        flex-shrink: 0;
    }


        .status.approved {
            background: #e8f6ed;
            color: #278653;
        }


        .status.rejected {
            background: #fdecec;
            color: #c0392b;
        }


        .status.pending {
            background: #fff4d6;
            color: #9a6900;
        }


    /* =========================================================
       DETAILS
       ========================================================= */

    .ethics-details {
        display: flex;
        flex-wrap: wrap;
        gap: 35px;
        padding: 18px 20px;
    }


    .detail-item {
        display: flex;
        align-items: center;
        min-width: 220px;
    }


    .detail-icon {
        width: 37px;
        height: 37px;
        border-radius: 8px;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 10px;
        flex-shrink: 0;
    }


    .detail-label {
        display: block;
        color: #8793a0;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .5px;
    }


    .detail-item strong {
        display: block;
        color: #26384d;
        font-size: 12px;
        margin-top: 2px;
    }


    /* =========================================================
       ACTIONS
       ========================================================= */

    .ethics-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding: 15px 20px;
        background: #fbfcfd;
        border-top: 1px solid #e5e9ee;
    }


    .view-button,
    .review-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 13px;
        border-radius: 7px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s ease;
    }


    /* =========================================================
       VIEW DOCUMENT
       ========================================================= */

    .view-button {
        background: white;
        color: #005a9c;
        border: 1px solid #ccd9e5;
    }


        .view-button:hover {
            background: #eef6ff;
            color: #005a9c;
            border-color: #005a9c;
            text-decoration: none !important;
        }


    .external-icon {
        font-size: 9px;
    }


    .disabled-button {
        opacity: .55;
        cursor: not-allowed;
    }


    /* =========================================================
       REVIEW BUTTON
       ========================================================= */

    .review-button {
        background: #002b5c;
        color: white;
        border: 1px solid #002b5c;
    }


        .review-button:hover {
            background: #001f43;
            color: white;
            text-decoration: none !important;
        }


        .review-button .arrow {
            color: #FDB913;
            margin-left: 2px;
        }


    /* =========================================================
       EMPTY STATE
       ========================================================= */

    .empty-state {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        text-align: center;
        padding: 55px 20px;
    }


    .empty-icon {
        width: 62px;
        height: 62px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }


    .empty-state h3 {
        margin: 0 0 6px;
        color: #172b4d;
        font-size: 19px;
    }


    .empty-state p {
        margin: 0;
        color: #7c8996;
        font-size: 13px;
    }


    /* =========================================================
       BOTTOM BACK BUTTON
       ========================================================= */

    .bottom-back-container {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        margin-top: 30px;
        margin-bottom: 10px;
    }


    .bottom-back-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 20px;
        background: #002147;
        color: white;
        border: 1px solid #002147;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .bottom-back-button:hover {
            background: #00152f;
            color: white;
            border-color: #00152f;
            text-decoration: none !important;
        }


        .bottom-back-button i {
            font-size: 12px;
        }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 768px) {

        .ethics-page {
            padding: 15px;
        }


        .page-header {
            padding: 20px;
        }


        .header-icon {
            display: none;
        }


        .ethics-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .status {
            align-self: flex-start;
        }


        .ethics-details {
            flex-direction: column;
            gap: 15px;
        }


        .detail-item {
            min-width: 100%;
        }


        .ethics-actions {
            flex-direction: column;
            align-items: stretch;
        }


        .view-button,
        .review-button {
            width: 100%;
        }


        .bottom-back-container {
            justify-content: stretch;
        }


        .bottom-back-button {
            width: 100%;
        }
    }
</style>