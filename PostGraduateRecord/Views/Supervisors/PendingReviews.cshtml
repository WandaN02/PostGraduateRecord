@model IEnumerable<PostGraduateRecord.ViewModels.SupervisorPendingReviewViewModel>

@{
    ViewBag.Title = "Pending Reviews";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}

<div class="container">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="dashboard-header">

        <h2>
            <i class="fa-solid fa-clock"></i>
            Pending Reviews
        </h2>

        <p>
            Review postgraduate submissions requiring your attention.
        </p>

    </div>


    <!-- =====================================================
         REVIEWS
         ===================================================== -->

    @if (Model != null && Model.Any())
    {
        <div class="pending-review-grid">

            @foreach (var review in Model)
            {
                <a href="@Url.Action(
                    review.Action,
                    review.Controller,
                    new
                    {
                        id = review.ReviewID,
                        type = review.ReviewType
                    })"
                   class="pending-review-link">

                    <div class="pending-review-card">

                        <!-- =================================================
                             CARD HEADER
                             ================================================= -->

                        <div class="review-card-header">

                            <span class="review-type">
                                @review.ReviewType
                            </span>

                            <span class="review-status">
                                @review.Status
                            </span>

                        </div>


                        <!-- =================================================
                             CARD BODY
                             ================================================= -->

                        <div class="review-card-body">

                            <h4>
                                @review.Title
                            </h4>


                            <!-- STUDENT -->

                            <div class="review-detail">

                                <div class="review-detail-icon">

                                    <i class="fa-solid fa-user-graduate"></i>

                                </div>

                                <div>

                                    <span class="detail-label">
                                        Student
                                    </span>

                                    <strong>
                                        @review.StudentName
                                    </strong>

                                </div>

                            </div>


                            <!-- SUBMITTED DATE -->

                            <div class="review-detail">

                                <div class="review-detail-icon">
                                    <i class="fa-solid fa-calendar"></i>
                                </div>

                                <div>

                                    <span class="detail-label">
                                        Submitted
                                    </span>

                                    <strong>
                                        @review.SubmittedDate
                                    </strong>

                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             CARD FOOTER
                             ================================================= -->

                        <div class="review-card-footer">

                            <span>
                                Review Submission
                            </span>

                            <i class="fa-solid fa-arrow-right"></i>

                        </div>

                    </div>

                </a>
            }

        </div>
    }
    else
    {
        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->

        <div class="empty-reviews">

            <div class="empty-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <h4>
                No Pending Reviews
            </h4>

            <p>
                There are currently no postgraduate submissions
                requiring your attention.
            </p>

        </div>
    }


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <div class="back-button-container">

        <a href="@Url.Action("Dashboard", "Supervisors")"
           class="back-dashboard-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>


<style>

    /* =====================================================
       PAGE
       ===================================================== */

    .container {
        max-width: 1100px;
        margin: 0 auto;
        padding: 25px 10px 50px;
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .dashboard-header {
        margin-bottom: 25px;
    }


        .dashboard-header h2 {
            margin: 0 0 6px;
            color: #002147;
            font-size: 27px;
            font-weight: 700;
        }


            .dashboard-header h2 i {
                color: #FDB913;
                margin-right: 8px;
            }


        .dashboard-header p {
            margin: 0;
            color: #6c757d;
            font-size: 14px;
        }


    /* =====================================================
       REVIEW GRID
       ===================================================== */

    .pending-review-grid {
        display: grid;
        grid-template-columns: repeat( auto-fit, minmax(320px, 1fr) );
        gap: 20px;
    }


    /* =====================================================
       REVIEW LINK
       ===================================================== */

    .pending-review-link {
        display: block;
        color: inherit;
        text-decoration: none !important;
    }


        .pending-review-link:hover {
            color: inherit;
            text-decoration: none !important;
        }


    /* =====================================================
       REVIEW CARD
       ===================================================== */

    .pending-review-card {
        height: 100%;
        display: flex;
        flex-direction: column;
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 14px;
        padding: 20px;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.06);
        transition: all .2s ease;
    }


    .pending-review-link:hover .pending-review-card {
        transform: translateY(-4px);
        border-color: #b9c7d5;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.10);
    }


    /* =====================================================
       CARD HEADER
       ===================================================== */

    .review-card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 20px;
    }


    .review-type {
        display: inline-block;
        background: #002147;
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    .review-status {
        display: inline-block;
        background: #fff4d6;
        color: #9a6900;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    /* =====================================================
       CARD BODY
       ===================================================== */

    .review-card-body {
        flex: 1;
    }


        .review-card-body h4 {
            margin: 0 0 20px;
            color: #172b4d;
            font-size: 17px;
            font-weight: 700;
            line-height: 1.4;
        }


    /* =====================================================
       REVIEW DETAILS
       ===================================================== */

    .review-detail {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 15px;
    }


    .review-detail-icon {
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #eef4f9;
        color: #002147;
        border-radius: 8px;
        font-size: 14px;
    }


    .review-detail div:last-child {
        display: flex;
        flex-direction: column;
    }


    .detail-label {
        display: block;
        margin-bottom: 2px;
        color: #8793a0;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .5px;
    }


    .review-detail strong {
        color: #34495e;
        font-size: 13px;
        font-weight: 600;
    }


    /* =====================================================
       CARD FOOTER
       ===================================================== */

    .review-card-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-top: 10px;
        padding-top: 15px;
        border-top: 1px solid #e8edf1;
        color: #002147;
        font-size: 12px;
        font-weight: 700;
    }


        .review-card-footer i {
            color: #FDB913;
            transition: transform .2s ease;
        }


    .pending-review-link:hover
    .review-card-footer i {
        transform: translateX(4px);
    }


    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .empty-reviews {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 14px;
        padding: 60px 20px;
        text-align: center;
        box-shadow: 0 3px 12px rgba(0, 0, 0, 0.05);
    }


    .empty-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #eef8f1;
        color: #198754;
        font-size: 26px;
    }


    .empty-reviews h4 {
        margin: 0 0 7px;
        color: #172b4d;
        font-size: 19px;
        font-weight: 700;
    }


    .empty-reviews p {
        margin: 0;
        color: #7c8996;
        font-size: 13px;
    }


    /* =====================================================
       BACK BUTTON
       ===================================================== */

    .back-button-container {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        margin-top: 30px;
    }


    .back-dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        background: #002147;
        color: white;
        border: 1px solid #002147;
        border-radius: 7px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .back-dashboard-button:hover {
            background: #FDB913;
            color: #002147;
            border-color: #FDB913;
            text-decoration: none !important;
        }


        .back-dashboard-button i {
            font-size: 12px;
            transition: transform .2s ease;
        }


        .back-dashboard-button:hover i {
            transform: translateX(-3px);
        }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 700px) {

        .container {
            padding: 20px 15px 40px;
        }


        .pending-review-grid {
            grid-template-columns: 1fr;
        }


        .review-card-header {
            align-items: flex-start;
        }


        .back-button-container {
            justify-content: stretch;
        }


        .back-dashboard-button {
            width: 100%;
        }
    }
</style>