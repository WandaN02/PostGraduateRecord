@model PostGraduateRecord.ViewModels.SupervisorProgressReportViewModel

@{
    ViewBag.Title = "Issue Progress Report";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}

<style>

    /* =====================================================
       PAGE
       ===================================================== */

    .progress-report-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px;
    }

    .page-header {
        margin-bottom: 25px;
    }

    .page-label {
        color: #FDB913;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 8px;
    }

    .page-title {
        color: #001B44;
        font-size: 30px;
        font-weight: 700;
        margin: 0;
    }

    .page-description {
        color: #6c757d;
        margin-top: 8px;
        font-size: 15px;
    }


    /* =====================================================
       CARDS
       ===================================================== */

    .report-card {
        background: #ffffff;
        border-radius: 14px;
        padding: 28px;
        margin-bottom: 22px;
        box-shadow: 0 4px 18px rgba(0, 27, 68, 0.08);
        border: 1px solid #e8edf3;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #001B44;
        font-size: 19px;
        font-weight: 700;
        margin: 0 0 22px 0;
        padding-bottom: 14px;
        border-bottom: 2px solid #FDB913;
    }

        .section-title i {
            color: #FDB913;
        }


    /* =====================================================
       FORM LAYOUT
       ===================================================== */

    .form-row {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 20px;
    }

    .form-group {
        margin-bottom: 20px;
    }

        .form-group:last-child {
            margin-bottom: 0;
        }

    .form-label {
        display: block;
        color: #001B44;
        font-weight: 600;
        font-size: 14px;
        margin-bottom: 8px;
    }

    .required {
        color: #dc3545;
    }


    /* =====================================================
       INPUTS
       ===================================================== */

    .form-control-custom {
        width: 100%;
        min-height: 46px;
        padding: 10px 13px;
        border: 1px solid #d7dee8;
        border-radius: 8px;
        background: #ffffff;
        color: #333333;
        font-size: 14px;
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    textarea.form-control-custom {
        min-height: 130px;
        resize: vertical;
    }

    .form-control-custom:focus {
        outline: none;
        border-color: #001B44;
        box-shadow: 0 0 0 3px rgba(0, 27, 68, 0.08);
    }

    .form-control-custom[readonly] {
        background: #f5f7fa;
        color: #555555;
        cursor: not-allowed;
    }

    select.form-control-custom {
        cursor: pointer;
        appearance: auto;
    }

    .field-help {
        margin-top: 6px;
        font-size: 12px;
        color: #7a8491;
        line-height: 1.5;
    }


    /* =====================================================
       STUDENT INFORMATION
       ===================================================== */

    .student-info {
        background: #f5f7fa;
        border-radius: 10px;
        padding: 18px;
    }

    .info-item {
        margin-bottom: 14px;
    }

        .info-item:last-child {
            margin-bottom: 0;
        }

    .info-label {
        display: block;
        color: #6c757d;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 3px;
        text-transform: uppercase;
        letter-spacing: 0.4px;
    }

    .info-value {
        color: #001B44;
        font-size: 14px;
        font-weight: 600;
    }


    /* =====================================================
       VALIDATION
       ===================================================== */

    .validation-summary {
        background: #fff3f3;
        border: 1px solid #f0b8b8;
        color: #842029;
        border-radius: 8px;
        padding: 15px 18px;
        margin-bottom: 20px;
    }

    .field-validation-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
    }


    /* =====================================================
       REPORT STATUS
       ===================================================== */

    .status-box {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #f5f7fa;
        border-radius: 10px;
        padding: 15px 18px;
    }

    .status-badge {
        display: inline-block;
        background: #FDB913;
        color: #001B44;
        padding: 7px 14px;
        border-radius: 6px;
        font-size: 13px;
        font-weight: 700;
    }

    .status-description {
        color: #6c757d;
        font-size: 13px;
    }


    /* =====================================================
       ALERTS
       ===================================================== */

    .alert-success-custom {
        background: #eaf7ee;
        border: 1px solid #b9e4c6;
        color: #216e39;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
    }

    .alert-error-custom {
        background: #fff3f3;
        border: 1px solid #f0b8b8;
        color: #842029;
        border-radius: 8px;
        padding: 14px 18px;
        margin-bottom: 20px;
    }


    /* =====================================================
       BUTTONS
       ===================================================== */

    .button-row {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 10px;
        margin-bottom: 30px;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 46px;
        padding: 0 22px;
        border-radius: 8px;
        border: 1px solid #d7dee8;
        background: #ffffff;
        color: #555555;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: all 0.2s ease;
    }

        .btn-cancel:hover {
            background: #f5f7fa;
            color: #001B44;
            text-decoration: none;
        }

    .btn-submit {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 46px;
        padding: 0 24px;
        border: none;
        border-radius: 8px;
        background: #001B44;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: background 0.2s ease;
    }

        .btn-submit:hover {
            background: #002b68;
            color: #ffffff;
        }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 768px) {

        .progress-report-page {
            padding: 20px 15px;
        }

        .page-title {
            font-size: 25px;
        }

        .report-card {
            padding: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 0;
        }

        .button-row {
            flex-direction: column;
        }

        .btn-cancel,
        .btn-submit {
            width: 100%;
        }

        .status-box {
            align-items: flex-start;
            flex-direction: column;
        }
    }
</style>


<div class="progress-report-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div class="page-label">
            <i class="fa-solid fa-file-circle-check"></i>
            SUPERVISOR WORKSPACE
        </div>

        <h1 class="page-title">
            Issue Progress Report
        </h1>

        <div class="page-description">
            Prepare and issue a research progress report to the assigned student.
        </div>

    </div>


    <!-- =====================================================
         VALIDATION
         ===================================================== -->

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="validation-summary">
            @Html.ValidationSummary(false, "Please correct the following errors:")
        </div>
    }


  


    @using (Html.BeginForm(
        "CreateProgressReport",
        "Supervisors",
        FormMethod.Post,
        new { @class = "progress-report-form" }))
    {
        @Html.AntiForgeryToken()

        @Html.HiddenFor(m => m.StudentID)

        @Html.HiddenFor(m => m.ProposalID)

        @Html.HiddenFor(m => m.Status)


        <!-- =================================================
             STUDENT INFORMATION
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-user-graduate"></i>

                Student Information

            </h2>


            <div class="student-info">

                <div class="form-row">

                    <div class="info-item">

                        <span class="info-label">
                            Student Name
                        </span>

                        <span class="info-value">
                            @Model.StudentName
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Student Number
                        </span>

                        <span class="info-value">
                            @Model.StudentNumber
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Qualification
                        </span>

                        <span class="info-value">
                            @Model.Qualification
                        </span>

                    </div>


                    <div class="info-item">

                        <span class="info-label">
                            Study Type
                        </span>

                        <span class="info-value">
                            @Model.StudyType
                        </span>

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             RESEARCH INFORMATION
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-book-open"></i>

                Research Information

            </h2>


            <div class="form-group">

                <label class="form-label">
                    Research Title
                </label>

                @Html.TextBoxFor(
                    m => m.ResearchTitle,
                    new
                    {
                        @class = "form-control-custom",
                        @readonly = "readonly"
                    })

            </div>

        </div>


        <!-- =================================================
             REPORT INFORMATION
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-calendar-days"></i>

                Report Information

            </h2>


            <div class="form-row">


                <!-- REPORT NUMBER -->

                <div class="form-group">

                    <label class="form-label">

                        Report Number

                        <span class="required">*</span>

                    </label>

                    @Html.TextBoxFor(
                        m => m.ReportNumber,
                        new
                        {
                            @class = "form-control-custom",
                            type = "number",
                            min = "1"
                        })

                    @Html.ValidationMessageFor(
                        m => m.ReportNumber)

                    <div class="field-help">
                        The sequential progress report number for this student.
                    </div>

                </div>


                <!-- REPORT DATE -->

                <div class="form-group">

                    <label class="form-label">

                        Report Date

                        <span class="required">*</span>

                    </label>

                    @Html.TextBoxFor(
                        m => m.ReportDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control-custom",
                            type = "date",
                            min = DateTime.Today.ToString("yyyy-MM-dd")
                        })

                    @Html.ValidationMessageFor(
                        m => m.ReportDate)

                    <div class="field-help">
                        Date on which the supervisor issues the report.
                        Previous dates cannot be selected.
                    </div>

                </div>

            </div>


            <!-- REPORTING PERIOD -->

            <div class="form-group">

                <label class="form-label">

                    Reporting Period

                    <span class="required">*</span>

                </label>

                @Html.TextBoxFor(
                    m => m.ReportingPeriod,
                    new
                    {
                        @class = "form-control-custom",
                        placeholder = "e.g. July - September 2026"
                    })

                @Html.ValidationMessageFor(
                    m => m.ReportingPeriod)

                <div class="field-help">
                    Specify the period covered by this progress report.
                </div>

            </div>

        </div>


        <!-- =================================================
             RESEARCH PROGRESS
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-chart-line"></i>

                Research Progress

            </h2>


            <!-- PROGRESS SUMMARY -->

            <div class="form-group">

                <label class="form-label">

                    Progress Summary

                    <span class="required">*</span>

                </label>

                @Html.TextAreaFor(
                    m => m.Summary,
                    new
                    {
                        @class = "form-control-custom",
                        rows = "5",
                        placeholder = "Provide a general summary of the student's progress during this reporting period."
                    })

                @Html.ValidationMessageFor(
                    m => m.Summary)

            </div>


            <!-- CURRENT PROGRESS -->

            <div class="form-group">

                <label class="form-label">

                    Current Progress

                    <span class="required">*</span>

                </label>

                @Html.TextAreaFor(
                    m => m.CurrentProgress,
                    new
                    {
                        @class = "form-control-custom",
                        rows = "5",
                        placeholder = "Describe the research work completed and the student's current stage of progress."
                    })

                @Html.ValidationMessageFor(
                    m => m.CurrentProgress)

            </div>


            <!-- =================================================
                 PROGRESS ASSESSMENT DROPDOWN
                 ================================================= -->

            <div class="form-group">

                <label class="form-label">

                    Progress Assessment

                    <span class="required">*</span>

                </label>


                @Html.DropDownListFor(
                    m => m.ProgressStatus,
                    new SelectList(
                        new[]
                        {
                            new
                            {
                                Value = "",
                                Text = "-- Select Progress Assessment --"
                            },

                            new
                            {
                                Value = "On Track",
                                Text = "On Track"
                            },

                            new
                            {
                                Value = "Needs Attention",
                                Text = "Needs Attention"
                            },

                            new
                            {
                                Value = "At Risk",
                                Text = "At Risk"
                            },

                            new
                            {
                                Value = "Off Track",
                                Text = "Off Track"
                            }
                        },
                        "Value",
                        "Text",
                        Model.ProgressStatus
                    ),
                    new
                    {
                        @class = "form-control-custom"
                    }
                )


                @Html.ValidationMessageFor(
                    m => m.ProgressStatus)


                <div class="field-help">

                    <strong>On Track:</strong>
                    Research is progressing according to the expected timeline and milestones.

                    <br />

                    <strong>Needs Attention:</strong>
                    Progress is acceptable, but some areas need improvement or attention.

                    <br />

                    <strong>At Risk:</strong>
                    Significant delays or issues could affect completion if not addressed.

                    <br />

                    <strong>Off Track:</strong>
                    Progress is substantially behind schedule or major issues require intervention.

                </div>

            </div>


            <!-- CHALLENGES -->

            <div class="form-group">

                <label class="form-label">
                    Challenges
                </label>

                @Html.TextAreaFor(
                    m => m.Challenges,
                    new
                    {
                        @class = "form-control-custom",
                        rows = "4",
                        placeholder = "Describe any challenges, delays or difficulties affecting the research."
                    })

                @Html.ValidationMessageFor(
                    m => m.Challenges)

            </div>

        </div>


        <!-- =================================================
             SUPERVISOR FEEDBACK
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-comment-dots"></i>

                Supervisor Feedback

            </h2>


            <!-- SUPERVISOR COMMENTS -->

            <div class="form-group">

                <label class="form-label">
                    Supervisor Comments
                </label>

                @Html.TextAreaFor(
                    m => m.SupervisorComments,
                    new
                    {
                        @class = "form-control-custom",
                        rows = "5",
                        placeholder = "Provide feedback and guidance to the student."
                    })

                @Html.ValidationMessageFor(
                    m => m.SupervisorComments)

            </div>


            <!-- NEXT STEPS -->

            <div class="form-group">

                <label class="form-label">
                    Next Steps
                </label>

                @Html.TextAreaFor(
                    m => m.NextSteps,
                    new
                    {
                        @class = "form-control-custom",
                        rows = "5",
                        placeholder = "Describe the work the student should focus on during the next reporting period."
                    })

                @Html.ValidationMessageFor(
                    m => m.NextSteps)

            </div>

        </div>


        <!-- =================================================
             REPORT STATUS
             ================================================= -->

        <div class="report-card">

            <h2 class="section-title">

                <i class="fa-solid fa-circle-check"></i>

                Report Status

            </h2>


            <div class="status-box">

                <span class="status-badge">
                    Issued
                </span>

                <span class="status-description">

                    This report will be issued to the student after submission.

                </span>

            </div>

        </div>


        <!-- =================================================
             ACTIONS
             ================================================= -->

        <div class="button-row">

            @Html.ActionLink(
                "Cancel",
                "Students",
                "Supervisors",
                null,
                new
                {
                    @class = "btn-cancel"
                })


            <button type="submit" class="btn-submit">

                <i class="fa-solid fa-paper-plane"></i>

                Issue Progress Report

            </button>

        </div>

    }

</div>