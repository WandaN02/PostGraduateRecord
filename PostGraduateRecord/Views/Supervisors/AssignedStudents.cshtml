@model IEnumerable<PostGraduateRecord.Models.Student>

@{
    ViewBag.Title = "Assigned Students";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}

<div class="assigned-students-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div>

            <div class="page-label">

                <i class="fa-solid fa-user-graduate"></i>

                SUPERVISOR WORKSPACE

            </div>

            <h2>
                Assigned Students
            </h2>

            <p>
                Students currently assigned to you for supervision.
            </p>

        </div>

        <div class="header-icon">

            <i class="fa-solid fa-users"></i>

        </div>

    </div>


    <!-- =====================================================
         STUDENT LIST
         ===================================================== -->

    @if (Model != null && Model.Any())
    {
        <div class="student-list">

            @foreach (var student in Model)
            {
                <div class="student-card">

                    <!-- STUDENT ICON -->

                    <div class="student-icon">

                        <i class="fa-solid fa-user-graduate"></i>

                    </div>


                    <!-- STUDENT INFORMATION -->

                    <div class="student-main">

                        <div class="student-label">
                            POSTGRADUATE STUDENT
                        </div>

                        <h3>
                            @student.User.FirstName
                            @student.User.LastName
                        </h3>


                        <div class="student-details">

                            <!-- STUDENT NUMBER -->

                            <div class="detail-item">

                                <span class="detail-label">
                                    Student Number
                                </span>

                                <span class="detail-value">

                                    <i class="fa-solid fa-id-card"></i>

                                    @student.User.StudentNumber

                                </span>

                            </div>


                            <!-- QUALIFICATION -->

                            <div class="detail-item">

                                <span class="detail-label">
                                    Qualification
                                </span>

                                <span class="detail-value">

                                    <i class="fa-solid fa-graduation-cap"></i>

                                    @student.Qualification

                                </span>

                            </div>


                            <!-- EMAIL -->

                            <div class="detail-item">

                                <span class="detail-label">
                                    Email
                                </span>

                                <span class="detail-value">

                                    <i class="fa-solid fa-envelope"></i>

                                    @student.User.Email

                                </span>

                            </div>

                        </div>


                        <!-- =================================================
                             ACTION BUTTONS
                             ================================================= -->

                        <div class="student-actions">

                            <a href="@Url.Action("Timeline", "Supervisors", new { studentId = student.StudentID })"
                               class="student-action btn-timeline">

                                <i class="fa-solid fa-calendar-days"></i>

                                View Timeline

                            </a>


                            <a href="@Url.Action("CreateProgressReport", "Supervisors", new { studentId = student.StudentID })"
                               class="student-action btn-progress">

                                <i class="fa-solid fa-file-circle-plus"></i>

                                Issue Progress Report

                            </a>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="student-status">

                        <span>
                            <i class="fa-solid fa-circle-check"></i>
                            Assigned
                        </span>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- =================================================
             EMPTY STATE
             ================================================= -->

        <div class="empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-user-slash"></i>

            </div>

            <h3>
                No Assigned Students
            </h3>

            <p>
                You currently have no postgraduate students assigned to you.
            </p>

        </div>
    }


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <div class="back-button-container">

        <a href="@Url.Action("Dashboard", "Supervisors")"
           class="back-dashboard-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>


<style>

    /* =====================================================
       PAGE
       ===================================================== */

    .assigned-students-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 25px 10px 50px;
    }


    /* =====================================================
       PAGE HEADER
       ===================================================== */

    .page-header {
        background: #002b5c;
        color: white;
        border-radius: 14px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .page-label {
        color: #FDB913;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }


    .page-header h2 {
        margin: 0;
        color: white;
        font-size: 27px;
        font-weight: 700;
    }


    .page-header p {
        margin: 5px 0 0;
        color: #d8e3ee;
        font-size: 13px;
    }


    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 11px;
        background: #FDB913;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /* =====================================================
       STUDENT LIST
       ===================================================== */

    .student-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }


    /* =====================================================
       STUDENT CARD
       ===================================================== */

    .student-card {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: flex-start;
        gap: 18px;
        transition: .2s ease;
    }


        .student-card:hover {
            border-color: #b9c7d5;
            box-shadow: 0 5px 16px rgba(0, 0, 0, .06);
            transform: translateY(-1px);
        }


    /* =====================================================
       STUDENT ICON
       ===================================================== */

    .student-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 11px;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }


    /* =====================================================
       MAIN INFORMATION
       ===================================================== */

    .student-main {
        flex: 1;
        min-width: 0;
    }


    .student-label {
        color: #7b8997;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        margin-bottom: 3px;
    }


    .student-main h3 {
        margin: 0 0 13px;
        color: #172b4d;
        font-size: 18px;
        font-weight: 700;
    }


    /* =====================================================
       DETAILS
       ===================================================== */

    .student-details {
        display: flex;
        flex-wrap: wrap;
        gap: 22px;
    }


    .detail-item {
        display: flex;
        flex-direction: column;
        min-width: 150px;
    }


    .detail-label {
        color: #8793a0;
        font-size: 9px;
        font-weight: 600;
        margin-bottom: 4px;
    }


    .detail-value {
        color: #435466;
        font-size: 12px;
        font-weight: 600;
    }


        .detail-value i {
            color: #002b5c;
            margin-right: 5px;
        }


    /* =====================================================
       ACTION BUTTONS
       ===================================================== */

    .student-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 9px;
        margin-top: 18px;
    }


    .student-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 38px;
        padding: 0 14px;
        border-radius: 8px;
        text-decoration: none !important;
        font-size: 11px;
        font-weight: 700;
        transition: all .2s ease;
    }


    /* TIMELINE BUTTON */

    .btn-timeline {
        background: #eef1f5;
        color: #435466;
        border: 1px solid #dce2e8;
    }


        .btn-timeline:hover {
            background: #e2e7ec;
            color: #172b4d;
            text-decoration: none !important;
        }


        .btn-timeline i {
            color: #002b5c;
        }


    /* PROGRESS REPORT BUTTON */

    .btn-progress {
        background: #002147;
        color: white;
        border: 1px solid #002147;
    }


        .btn-progress i {
            color: #FDB913;
        }


        .btn-progress:hover {
            background: #FDB913;
            color: #002147;
            border-color: #FDB913;
            text-decoration: none !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 10px rgba(0, 33, 71, .15);
        }


            .btn-progress:hover i {
                color: #002147;
            }


    /* =====================================================
       STATUS
       ===================================================== */

    .student-status {
        flex-shrink: 0;
    }


        .student-status span {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            background: #e8f6ed;
            color: #278653;
            padding: 6px 10px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 700;
        }


        .student-status i {
            font-size: 9px;
        }


    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .empty-state {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        text-align: center;
        padding: 55px 20px;
    }


    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }


    .empty-state h3 {
        margin: 0 0 6px;
        color: #172b4d;
        font-size: 19px;
    }


    .empty-state p {
        margin: 0;
        color: #7c8996;
        font-size: 13px;
    }


    /* =====================================================
       BACK BUTTON
       ===================================================== */

    .back-button-container {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        margin-top: 30px;
    }


    .back-dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        background: #002147;
        color: white;
        border: 1px solid #002147;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .back-dashboard-button:hover {
            background: #FDB913;
            color: #002147;
            border-color: #FDB913;
            text-decoration: none !important;
        }


        .back-dashboard-button i {
            font-size: 12px;
            transition: transform .2s ease;
        }


        .back-dashboard-button:hover i {
            transform: translateX(-3px);
        }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 800px) {

        .assigned-students-page {
            padding: 20px 15px 40px;
        }


        .page-header {
            padding: 20px;
        }


            .page-header h2 {
                font-size: 24px;
            }


        .header-icon {
            width: 45px;
            height: 45px;
            font-size: 18px;
        }


        .student-card {
            align-items: flex-start;
            flex-wrap: wrap;
        }


        .student-main {
            width: calc(100% - 70px);
        }


        .student-details {
            flex-direction: column;
            gap: 10px;
        }


        .student-actions {
            flex-direction: column;
            align-items: stretch;
        }


        .student-action {
            width: 100%;
        }


        .student-status {
            width: 100%;
            margin-left: 70px;
        }


        .back-button-container {
            justify-content: stretch;
        }


        .back-dashboard-button {
            width: 100%;
        }
    }
</style>