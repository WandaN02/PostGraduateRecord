@model IEnumerable<PostGraduateRecord.Models.Proposal>

@{
    ViewBag.Title = "Research Proposals";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";

    string currentStatus = Request["status"];

    bool isAll =
        string.IsNullOrWhiteSpace(currentStatus) ||
        currentStatus.Equals("All", StringComparison.OrdinalIgnoreCase);
}


<div class="supervisor-proposals-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div>

            <div class="page-label">

                <i class="fa-solid fa-file-signature"></i>

                SUPERVISOR WORKSPACE

            </div>

            <h2>
                Research Proposals
            </h2>

            <p>
                Manage and review postgraduate research proposals assigned to you.
            </p>

        </div>

        <div class="header-icon">

            <i class="fa-solid fa-file-lines"></i>

        </div>

    </div>


    <!-- =====================================================
         FILTERS
         ===================================================== -->

    <div class="proposal-filters">

        <a href="@Url.Action("Proposals", "Supervisors", new { status = "All" })"
           class="filter @(isAll ? "active" : "")">

            All

        </a>


        <a href="@Url.Action("Proposals", "Supervisors", new { status = "Pending" })"
           class="filter @(currentStatus == "Pending" ? "active" : "")">

            <i class="fa-solid fa-clock"></i>

            Pending

        </a>


        <a href="@Url.Action("Proposals", "Supervisors", new { status = "Approved" })"
           class="filter @(currentStatus == "Approved" ? "active" : "")">

            <i class="fa-solid fa-check"></i>

            Approved

        </a>


        <a href="@Url.Action("Proposals", "Supervisors", new { status = "Revision Required" })"
           class="filter @(currentStatus == "Revision Required" ? "active" : "")">

            <i class="fa-solid fa-rotate"></i>

            Revision Required

        </a>


        <a href="@Url.Action("Proposals", "Supervisors", new { status = "Rejected" })"
           class="filter @(currentStatus == "Rejected" ? "active" : "")">

            <i class="fa-solid fa-xmark"></i>

            Rejected

        </a>

    </div>




    <!-- =====================================================
         PROPOSALS
         ===================================================== -->

    @if (Model != null && Model.Any())
    {
        <div class="proposal-list">

            @foreach (var item in Model)
            {
                var document = item.ProposalDocuments
                    .OrderByDescending(d => d.UploadDate)
                    .FirstOrDefault();


                <div class="proposal-card">

                    <!-- =================================================
                         CARD HEADER
                         ================================================= -->

                    <div class="proposal-card-header">

                        <div class="proposal-title-section">

                            <div class="proposal-icon">

                                <i class="fa-solid fa-file-lines"></i>

                            </div>

                            <div>

                                <span class="proposal-label">
                                    POSTGRADUATE RESEARCH PROPOSAL
                                </span>

                                <h3>
                                    @item.Title
                                </h3>

                            </div>

                        </div>


                        <!-- STATUS -->

                        @if (item.Status == "Approved")
                        {
                            <span class="status approved">

                                <i class="fa-solid fa-check"></i>

                                Approved

                            </span>
                        }
                        else if (item.Status == "Rejected")
                        {
                            <span class="status rejected">

                                <i class="fa-solid fa-xmark"></i>

                                Rejected

                            </span>
                        }
                        else if (item.Status == "Revision Required")
                        {
                            <span class="status revision">

                                <i class="fa-solid fa-rotate"></i>

                                Revision Required

                            </span>
                        }
                        else
                        {
                            <span class="status pending">

                                <i class="fa-solid fa-clock"></i>

                                Pending

                            </span>
                        }

                    </div>


                    <!-- =================================================
                         DETAILS
                         ================================================= -->

                    <div class="proposal-details">


                        <!-- STUDENT -->

                        <div class="detail-item">

                            <span class="detail-label">
                                Student
                            </span>

                            <span class="detail-value">

                                <i class="fa-solid fa-user-graduate"></i>

                                @item.Student.User.FirstName
                                @item.Student.User.LastName

                            </span>

                        </div>


                        <!-- QUALIFICATION -->

                        <div class="detail-item">

                            <span class="detail-label">
                                Qualification
                            </span>

                            <span class="detail-value">

                                <i class="fa-solid fa-graduation-cap"></i>

                                @item.Student.Qualification

                            </span>

                        </div>


                        <!-- RESEARCH FIELD -->

                        <div class="detail-item">

                            <span class="detail-label">
                                Research Field
                            </span>

                            <span class="detail-value">

                                <i class="fa-solid fa-flask"></i>

                                @item.ResearchField

                            </span>

                        </div>


                        <!-- SUBMITTED -->

                        <div class="detail-item">

                            <span class="detail-label">
                                Submitted
                            </span>

                            <span class="detail-value">

                                <i class="fa-solid fa-calendar"></i>

                                @if (item.SubmissionDate.HasValue)
                                {
                                    @item.SubmissionDate.Value.ToString("dd MMM yyyy")
                                }
                                else
                                {
                                    <span>Not specified</span>
                                }

                            </span>

                        </div>

                    </div>


                    <!-- =================================================
                         ACTIONS
                         ================================================= -->

                    <div class="proposal-actions">


                        @if (document != null)
                        {
                            <a href="@Url.Action(
                                        "ViewDocument",
                                        "Supervisors",
                                        new { id = item.ProposalID })"
                               target="_blank"
                               class="btn-view">

                                <i class="fa-solid fa-file-pdf"></i>

                                View Document

                            </a>
                        }
                        else
                        {
                            <button type="button"
                                    class="btn-view disabled"
                                    disabled>

                                <i class="fa-solid fa-file-circle-xmark"></i>

                                No Document

                            </button>
                        }


                        <a href="@Url.Action(
                                    "Review",
                                    "Supervisors",
                                    new { id = item.ProposalID })"
                           class="btn-review">

                            <i class="fa-solid fa-comment-dots"></i>

                            Review Proposal

                            <i class="fa-solid fa-arrow-right arrow"></i>

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->

        <div class="empty-state">

            <div class="empty-icon">

                <i class="fa-solid fa-folder-open"></i>

            </div>

            <h3>
                No Research Proposals
            </h3>

            <p>
                There are currently no proposals matching the selected filter.
            </p>

        </div>
    }


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <div class="back-button-container">

        <a href="@Url.Action("Dashboard", "Supervisors")"
           class="back-dashboard-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>

</div>


<style>

    /* =====================================================
       PAGE
       ===================================================== */

    .supervisor-proposals-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 25px 10px 50px;
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .page-header {
        background: #002b5c;
        color: white;
        border-radius: 14px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
    }


    .page-label {
        color: #FDB913;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }


    .page-header h2 {
        margin: 0;
        color: white;
        font-size: 27px;
        font-weight: 700;
    }


    .page-header p {
        margin: 5px 0 0;
        color: #d8e3ee;
        font-size: 13px;
    }


    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 11px;
        background: #FDB913;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /* =====================================================
       FILTERS
       ===================================================== */

    .proposal-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 22px;
    }


    .filter {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 14px;
        border: 1px solid #dce2e8;
        border-radius: 20px;
        background: white;
        color: #526273;
        text-decoration: none !important;
        font-size: 11px;
        font-weight: 600;
        transition: .2s ease;
    }


        .filter:hover {
            border-color: #002b5c;
            color: #002b5c;
            background: #f5f8fb;
        }


        .filter.active {
            background: #002b5c;
            border-color: #002b5c;
            color: white;
        }


        .filter i {
            font-size: 10px;
        }


    /* =====================================================
       SUCCESS MESSAGE
       ===================================================== */

    .success-message {
        display: flex;
        align-items: center;
        gap: 9px;
        background: #e8f6ed;
        border: 1px solid #ccebd7;
        color: #277d4d;
        border-radius: 8px;
        padding: 11px 14px;
        margin-bottom: 20px;
        font-size: 12px;
        font-weight: 600;
    }


        .success-message i {
            font-size: 15px;
        }


    /* =====================================================
       PROPOSAL LIST
       ===================================================== */

    .proposal-list {
        display: flex;
        flex-direction: column;
        gap: 15px;
    }


    /* =====================================================
       PROPOSAL CARD
       ===================================================== */

    .proposal-card {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        overflow: hidden;
        transition: .2s ease;
    }


        .proposal-card:hover {
            border-color: #b9c7d5;
            box-shadow: 0 5px 16px rgba(0,0,0,.06);
            transform: translateY(-1px);
        }


    /* =====================================================
       CARD HEADER
       ===================================================== */

    .proposal-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        padding: 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e5e9ee;
    }


    .proposal-title-section {
        display: flex;
        align-items: center;
        gap: 13px;
        min-width: 0;
    }


    .proposal-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 10px;
        background: #002b5c;
        color: #FDB913;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }


    .proposal-label {
        display: block;
        color: #7b8997;
        font-size: 9px;
        font-weight: 700;
        letter-spacing: .8px;
        margin-bottom: 3px;
    }


    .proposal-title-section h3 {
        margin: 0;
        color: #172b4d;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
    }


    /* =====================================================
       STATUS
       ===================================================== */

    .status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        flex-shrink: 0;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }


        .status.approved {
            background: #e8f6ed;
            color: #278653;
        }


        .status.rejected {
            background: #fdecec;
            color: #c13c3c;
        }


        .status.revision {
            background: #fff4d6;
            color: #9a6900;
        }


        .status.pending {
            background: #fff4d6;
            color: #9a6900;
        }


    /* =====================================================
       DETAILS
       ===================================================== */

    .proposal-details {
        display: flex;
        flex-wrap: wrap;
        gap: 25px;
        padding: 19px 20px;
    }


    .detail-item {
        display: flex;
        flex-direction: column;
        min-width: 145px;
    }


    .detail-label {
        color: #8793a0;
        font-size: 9px;
        font-weight: 600;
        margin-bottom: 5px;
    }


    .detail-value {
        color: #435466;
        font-size: 12px;
        font-weight: 600;
    }


        .detail-value i {
            color: #002b5c;
            margin-right: 5px;
        }


    /* =====================================================
       ACTIONS
       ===================================================== */

    .proposal-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 9px;
        padding: 14px 20px;
        border-top: 1px solid #eef1f4;
        background: #fbfcfd;
    }


    .btn-view,
    .btn-review {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 6px;
        font-size: 11px;
        font-weight: 600;
        text-decoration: none !important;
        transition: .2s ease;
    }


    .btn-view {
        background: #eef2f5;
        color: #435466;
        border: 1px solid #dce2e8;
    }


        .btn-view:hover {
            background: #e1e7ec;
            color: #26384d;
            text-decoration: none !important;
        }


        .btn-view.disabled {
            opacity: .55;
            cursor: not-allowed;
        }


    .btn-review {
        background: #002b5c;
        color: white;
        border: 1px solid #002b5c;
    }


        .btn-review:hover {
            background: #001f43;
            color: white;
            text-decoration: none !important;
        }


        .btn-review .arrow {
            color: #FDB913;
            margin-left: 3px;
        }


    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .empty-state {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        text-align: center;
        padding: 55px 20px;
    }


    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }


    .empty-state h3 {
        margin: 0 0 6px;
        color: #172b4d;
        font-size: 19px;
    }


    .empty-state p {
        margin: 0;
        color: #7c8996;
        font-size: 13px;
    }


    /* =====================================================
       BACK TO DASHBOARD
       ===================================================== */

    .back-button-container {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        margin-top: 30px;
    }


    .back-dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        background: #002147;
        color: white;
        border: 1px solid #002147;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .back-dashboard-button:hover {
            background: #FDB913;
            color: #002147;
            border-color: #FDB913;
            text-decoration: none !important;
        }


        .back-dashboard-button i {
            font-size: 12px;
            transition: transform .2s ease;
        }


        .back-dashboard-button:hover i {
            transform: translateX(-3px);
        }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 800px) {

        .supervisor-proposals-page {
            padding: 20px 15px 40px;
        }


        .page-header {
            padding: 20px;
        }


            .page-header h2 {
                font-size: 24px;
            }


        .header-icon {
            width: 45px;
            height: 45px;
            font-size: 18px;
        }


        .proposal-card-header {
            align-items: flex-start;
            flex-direction: column;
        }


        .proposal-title-section {
            width: 100%;
        }


        .status {
            align-self: flex-start;
        }


        .proposal-details {
            flex-direction: column;
            gap: 12px;
        }


        .proposal-actions {
            flex-direction: column;
            align-items: stretch;
        }


        .btn-view,
        .btn-review {
            width: 100%;
        }


        .back-button-container {
            justify-content: stretch;
        }


        .back-dashboard-button {
            width: 100%;
        }
    }
</style>