@model PostGraduateRecord.ViewModels.SupervisorDashboardViewModel

@{
    ViewBag.Title = "Supervisor Dashboard";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}

<div class="container">

    <!-- =====================================================
         DASHBOARD HEADER + SEARCH
    ====================================================== -->

    <div class="dashboard-top">

        <div class="dashboard-header">

            <h2>
                Supervisor Dashboard
            </h2>

            <h2>
                Welcome, @ViewBag.SupervisorName
            </h2>

        </div>

        <div class="dashboard-search">

            <div class="search-box">

                <i class="fa-solid fa-magnifying-glass search-icon"></i>

                <input type="text"
                       id="supervisorSearch"
                       placeholder="Search students or research titles..."
                       autocomplete="off" />

                <button type="button"
                        id="clearSearch"
                        class="search-clear"
                        title="Clear search">

                    <i class="fa-solid fa-xmark"></i>

                </button>

            </div>

        </div>

    </div>

    <hr />


    <!-- =====================================================
         DASHBOARD CARDS
    ====================================================== -->

    <div class="dashboard-cards">

        <a href="@Url.Action("AssignedStudents", "Supervisors")"
           class="dashboard-card-link">

            <div class="dashboard-card">

                <div class="card-icon">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>

                <div class="card-content">

                    <h2>
                        @Model.AssignedStudents
                    </h2>

                    <p>
                        Assigned Students
                    </p>

                </div>

            </div>

        </a>


        <a href="@Url.Action("Proposals", "Supervisors", new { status = "All" })"
           class="dashboard-card-link">

            <div class="dashboard-card">

                <div class="card-icon">
                    <i class="fa-solid fa-file-lines"></i>
                </div>

                <div class="card-content">

                    <h2>
                        @Model.ActiveProposals
                    </h2>

                    <p>
                        Active Proposals
                    </p>

                </div>

            </div>

        </a>


        <a href="@Url.Action("PendingReviews", "Supervisors")"
           class="dashboard-card-link">

            <div class="dashboard-card">

                <div class="card-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>

                <div class="card-content">

                    <h2>
                        @Model.PendingReviews
                    </h2>

                    <p>
                        Pending Reviews
                    </p>

                </div>

            </div>

        </a>


        <a href="@Url.Action("Deadlines", "Supervisors")"
           class="dashboard-card-link">

            <div class="dashboard-card">

                <div class="card-icon">
                    <i class="fa-solid fa-calendar-days"></i>
                </div>

                <div class="card-content">

                    <h2>
                        @Model.UpcomingDeadlines
                    </h2>

                    <p>
                        Upcoming Deadlines
                    </p>

                </div>

            </div>

        </a>

    </div>


    <hr />


    <!-- =====================================================
         DASHBOARD PANELS
    ====================================================== -->

    <div class="dashboard-panels">

        <div class="dashboard-panel">

            <div class="panel-header">

                <div class="panel-icon">
                    <i class="fa-solid fa-user-graduate"></i>
                </div>

                <h3>
                    Assigned Students
                </h3>

            </div>

            @if (Model.Assignments != null &&
                 Model.Assignments.Any())
            {
                <ul class="panel-list">

                    @foreach (var assignment in Model.Assignments.Take(5))
                    {
                        <li class="searchable-item">

                            <div>

                                <strong>
                                    @assignment.Application.Student.User.FirstName
                                    @assignment.Application.Student.User.LastName
                                </strong>

                                <span>
                                    @assignment.Application.ResearchTitle
                                </span>

                            </div>

                        </li>
                    }

                </ul>

                <a href="@Url.Action("AssignedStudents", "Supervisors")"
                   class="panel-link">

                    View All →

                </a>
            }
            else
            {
                <p>
                    No assigned students.
                </p>
            }

        </div>


        <div class="dashboard-panel">

            <div class="panel-header">

                <div class="panel-icon">
                    <i class="fa-solid fa-clipboard-check"></i>
                </div>

                <h3>
                    Pending Reviews
                </h3>

            </div>

            @if (Model.PendingReviewList != null &&
                 Model.PendingReviewList.Any())
            {
                <ul class="panel-list">

                    @foreach (var review in Model.PendingReviewList.Take(5))
                    {
                        <li class="searchable-item">

                            <div>

                                <strong>
                                    @review.ProposalTitle
                                </strong>

                                <span>
                                    @review.StudentName
                                </span>

                            </div>

                            <span class="badge bg-warning text-dark">
                                @review.Status
                            </span>

                        </li>
                    }

                </ul>

                <a href="@Url.Action("PendingReviews", "Supervisors")"
                   class="panel-link">

                    Review All →

                </a>
            }
            else
            {
                <p>
                    No pending reviews.
                </p>
            }

        </div>

    </div>

</div>


<!-- =========================================================
     AI ASSISTANT BUTTON
========================================================= -->

<button type="button"
        id="openSupervisorAI"
        class="ai-floating-button"
        title="Open SPGS AI Assistant">

    <span class="ai-sparkle">✦</span>

    <span>
        AI Assistant
    </span>

</button>


<!-- =========================================================
     AI ASSISTANT PANEL
========================================================= -->

<div id="supervisorAI"
     class="ai-assistant-panel">

    <div class="ai-header">

        <div class="ai-header-title">

            <div class="ai-icon">
                ✦
            </div>

            <div>

                <strong>
                    SPGS AI Assistant
                </strong>

                <small>
                    Supervisor Assistant
                </small>

            </div>

        </div>

        <button type="button"
                id="closeSupervisorAI"
                class="ai-close"
                title="Close">

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <div class="ai-status">

        <span class="ai-online-dot"></span>

        Ready to assist

    </div>


    <div id="supervisorAIChat"
         class="ai-chat-body">

        <div class="ai-message ai-message-bot">

            <div class="ai-message-icon">
                ✦
            </div>

            <div class="ai-message-content">

                <strong>
                    Hello!
                </strong>

                <p>
                    I'm your SPGS Supervisor AI Assistant.
                    I can help you understand your dashboard,
                    students, proposals, evaluations and deadlines.
                </p>

            </div>

        </div>


        <div class="ai-suggestions">

            <button type="button"
                    class="ai-suggestion"
                    data-question="What requires my attention?">

                What requires my attention?

            </button>

            <button type="button"
                    class="ai-suggestion"
                    data-question="Show me my pending proposal reviews.">

                Show my pending proposal reviews

            </button>

            <button type="button"
                    class="ai-suggestion"
                    data-question="What are my upcoming deadlines?">

                Upcoming deadlines

            </button>

            <button type="button"
                    class="ai-suggestion"
                    data-question="Give me a summary of my students.">

                Summarise my students

            </button>

        </div>

    </div>


    <div class="ai-input-area">

        <input type="text"
               id="supervisorAIInput"
               placeholder="Ask the AI Assistant..."
               autocomplete="off" />

        <button type="button"
                id="supervisorAISend"
                title="Send">

            <i class="fa-solid fa-paper-plane"></i>

        </button>

    </div>

</div>


<!-- =========================================================
     PAGE STYLING
========================================================= -->

<style>

    /* =========================================================
       HEADER + SEARCH
    ========================================================= */

    .dashboard-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 30px;
        margin-bottom: 10px;
    }

    .dashboard-header {
        margin: 0;
    }

        .dashboard-header h2 {
            margin-bottom: 4px;
        }

    .dashboard-search {
        display: flex;
        align-items: center;
        justify-content: flex-end;
    }

    .search-box {
        position: relative;
        width: 380px;
        height: 44px;
    }

        .search-box input {
            display: block;
            width: 100%;
            height: 44px;
            box-sizing: border-box;
            border: 1px solid #cfd7e3;
            border-radius: 12px;
            background: #ffffff;
            padding: 0 45px;
            font-size: 14px;
            color: #002b5c;
            outline: none;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .search-box input::placeholder {
                color: #8b95a5;
            }

            .search-box input:focus {
                border-color: #002b5c;
                box-shadow: 0 0 0 3px rgba(0, 43, 92, 0.08);
            }

        .search-box .search-icon {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            width: 18px;
            height: 18px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #002b5c;
            font-size: 15px;
            z-index: 5;
            pointer-events: none;
        }

        .search-box .search-clear {
            position: absolute;
            right: 9px;
            top: 50%;
            transform: translateY(-50%);
            width: 28px;
            height: 28px;
            display: none;
            align-items: center;
            justify-content: center;
            border: none;
            border-radius: 50%;
            background: transparent;
            color: #7a8491;
            cursor: pointer;
            padding: 0;
            z-index: 6;
        }

            .search-box .search-clear:hover {
                background: #eef2f7;
                color: #002b5c;
            }

    .searchable-item.search-hidden {
        display: none;
    }


    /* =========================================================
       DASHBOARD CARDS
    ========================================================= */

    .dashboard-card-link {
        text-decoration: none;
        color: inherit;
        display: block;
    }

        .dashboard-card-link:hover {
            text-decoration: none;
            color: inherit;
        }

        .dashboard-card-link .dashboard-card {
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease;
        }

        .dashboard-card-link:hover .dashboard-card {
            transform: translateY(-4px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.12);
        }

    .dashboard-panel {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .dashboard-panel:hover {
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.10);
        }

    .panel-link {
        text-decoration: none;
    }

        .panel-link:hover {
            text-decoration: none;
        }


    /* =========================================================
       AI FLOATING BUTTON
    ========================================================= */

    .ai-floating-button {
        position: fixed;
        right: 30px;
        bottom: 30px;
        z-index: 9998;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 13px 19px;
        border: none;
        border-radius: 30px;
        background: #001B44;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(0, 27, 68, 0.30);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .ai-floating-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 27, 68, 0.38);
        }

    .ai-sparkle {
        color: #FDB913;
        font-size: 19px;
    }


    /* =========================================================
       AI PANEL
    ========================================================= */

    .ai-assistant-panel {
        position: fixed;
        right: 30px;
        bottom: 88px;
        width: 390px;
        height: 570px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.22);
        overflow: hidden;
        z-index: 9999;
        display: none;
        flex-direction: column;
        border: 1px solid #e0e5ec;
    }

        .ai-assistant-panel.ai-open {
            display: flex;
            animation: aiPanelOpen 0.2s ease;
        }


    /* =========================================================
       AI PANEL ANIMATION
    ========================================================= */

    @@keyframes aiPanelOpen {

        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
       AI HEADER
    ========================================================= */

    .ai-header {
        background: #001B44;
        color: #ffffff;
        padding: 15px 17px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ai-header-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ai-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #FDB913;
        color: #001B44;
        font-size: 20px;
        font-weight: bold;
    }

    .ai-header-title strong {
        display: block;
        font-size: 14px;
    }

    .ai-header-title small {
        display: block;
        margin-top: 2px;
        opacity: 0.75;
        font-size: 11px;
    }

    .ai-close {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #ffffff;
        cursor: pointer;
        font-size: 16px;
        transition: background 0.15s ease;
    }

        .ai-close:hover {
            background: rgba(255, 255, 255, 0.12);
        }


    /* =========================================================
       AI STATUS
    ========================================================= */

    .ai-status {
        padding: 8px 17px;
        font-size: 11px;
        color: #667085;
        border-bottom: 1px solid #edf0f4;
    }

    .ai-online-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 5px;
        border-radius: 50%;
        background: #20a464;
    }


    /* =========================================================
       CHAT BODY
    ========================================================= */

    .ai-chat-body {
        flex: 1;
        padding: 17px;
        overflow-y: auto;
        background: #f7f9fc;
        scroll-behavior: smooth;
    }

    .ai-message {
        display: flex;
        gap: 9px;
        margin-bottom: 15px;
    }

    .ai-message-icon {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #001B44;
        color: #FDB913;
        font-size: 14px;
    }


    /* =========================================================
       MESSAGE CONTENT
    ========================================================= */

    .ai-message-content {
        position: relative;
        max-width: 285px;
        background: #ffffff;
        padding: 11px 13px;
        border-radius: 4px 13px 13px 13px;
        box-shadow: 0 2px 7px rgba(0, 0, 0, 0.05);
        color: #333333;
        font-size: 13px;
        line-height: 1.5;
        word-wrap: break-word;
        overflow-wrap: break-word;
    }

        .ai-message-content strong {
            color: #001B44;
        }

        .ai-message-content p {
            margin: 4px 0 0;
        }


    /* =========================================================
       SUGGESTIONS
    ========================================================= */

    .ai-suggestions {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-left: 37px;
    }

    .ai-suggestion {
        width: 100%;
        text-align: left;
        padding: 9px 11px;
        border: 1px solid #dce3ed;
        border-radius: 9px;
        background: #ffffff;
        color: #001B44;
        font-size: 12px;
        cursor: pointer;
        transition: border-color 0.15s ease, background 0.15s ease, transform 0.15s ease;
    }

        .ai-suggestion:hover {
            border-color: #001B44;
            background: #f1f5fa;
            transform: translateY(-1px);
        }


    /* =========================================================
       USER MESSAGE
    ========================================================= */

    .ai-user-message {
        justify-content: flex-end;
        position: relative;
    }

        .ai-user-message .ai-message-content {
            position: relative;
            background: #001B44;
            color: #ffffff;
            border-radius: 13px 4px 13px 13px;
            /*
           Extra bottom space gives the edit icon
           room without covering the message text.
        */
            padding: 11px 13px 30px 13px;
        }

            .ai-user-message .ai-message-content strong {
                color: #FDB913;
            }


    /* =========================================================
       CHATGPT-STYLE EDIT BUTTON
       Hidden until the user hovers over their message.
    ========================================================= */

    .ai-edit-button {
        position: absolute;
        right: 7px;
        bottom: 6px;
        width: 25px;
        height: 25px;
        padding: 0;
        margin: 0;
        border: none;
        outline: none;
        border-radius: 6px;
        background: transparent;
        color: rgba(255, 255, 255, 0.60);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        line-height: 1;
        cursor: pointer;
        /*
           Completely hidden until
           the message is hovered.
        */
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.15s ease, visibility 0.15s ease, background 0.15s ease, color 0.15s ease;
    }


    /* =========================================================
       SHOW EDIT BUTTON ON MESSAGE HOVER
    ========================================================= */

    .ai-user-message:hover .ai-edit-button {
        opacity: 1;
        visibility: visible;
    }


    /* =========================================================
       EDIT BUTTON HOVER
    ========================================================= */

    .ai-edit-button:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
    }


    /* =========================================================
       EDIT BUTTON ACTIVE
    ========================================================= */

    .ai-edit-button:active {
        background: rgba(255, 255, 255, 0.18);
    }


    /* =========================================================
       EDIT BUTTON KEYBOARD ACCESSIBILITY
    ========================================================= */

    .ai-edit-button:focus-visible {
        opacity: 1;
        visibility: visible;
        box-shadow: 0 0 0 2px rgba(253, 185, 19, 0.35);
    }


    /* =========================================================
       INPUT
    ========================================================= */

    .ai-input-area {
        display: flex;
        padding: 11px;
        background: #ffffff;
        border-top: 1px solid #e5e9ef;
    }

        .ai-input-area input {
            flex: 1;
            height: 42px;
            border: 1px solid #d6dce5;
            border-radius: 10px 0 0 10px;
            padding: 0 12px;
            outline: none;
            font-size: 13px;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }

            .ai-input-area input:focus {
                border-color: #001B44;
                box-shadow: 0 0 0 2px rgba(0, 27, 68, 0.08);
            }


            /* =========================================================
       INPUT EDITING STATE
    ========================================================= */

            .ai-input-area input.ai-editing {
                border-color: #FDB913 !important;
                box-shadow: 0 0 0 3px rgba(253, 185, 19, 0.15) !important;
            }


        .ai-input-area button {
            width: 45px;
            border: none;
            border-radius: 0 10px 10px 0;
            background: #001B44;
            color: #FDB913;
            cursor: pointer;
            transition: background 0.15s ease;
        }

            .ai-input-area button:hover {
                background: #002b5c;
            }


    /* =========================================================
       SCROLLBAR
    ========================================================= */

    .ai-chat-body::-webkit-scrollbar {
        width: 6px;
    }

    .ai-chat-body::-webkit-scrollbar-track {
        background: transparent;
    }

    .ai-chat-body::-webkit-scrollbar-thumb {
        background: #cbd3df;
        border-radius: 10px;
    }

        .ai-chat-body::-webkit-scrollbar-thumb:hover {
            background: #aeb8c6;
        }


    /* =========================================================
       RESPONSIVE - TABLET
    ========================================================= */

    @@media (max-width: 900px) {

        .dashboard-top {
            flex-direction: column;
            align-items: stretch;
            gap: 15px;
        }

        .dashboard-search {
            width: 100%;
            justify-content: stretch;
        }

        .search-box {
            width: 100%;
        }
    }


    /* =========================================================
       RESPONSIVE - MOBILE
    ========================================================= */

    @@media (max-width: 600px) {

        .ai-assistant-panel {
            right: 10px;
            left: 10px;
            bottom: 78px;
            width: auto;
            height: 70vh;
            border-radius: 15px;
        }

        .ai-floating-button {
            right: 15px;
            bottom: 15px;
        }

        .ai-message-content {
            max-width: calc(100vw - 100px);
        }

        .ai-user-message .ai-message-content {
            max-width: calc(100vw - 75px);
        }
        /*
           On touch devices there is no true hover.
           Keep the pencil accessible when the message
           is touched/focused.
        */

        .ai-user-message:focus-within .ai-edit-button {
            opacity: 1;
            visibility: visible;
        }
    }
</style>

<script src="~/Scripts/supervisor-dashboard.js"></script>