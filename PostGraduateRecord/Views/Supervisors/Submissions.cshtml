@model IEnumerable<PostGraduateRecord.ViewModels.SupervisorSubmissionViewModel>

@{
    ViewBag.Title = "Submissions";
    Layout = "~/Views/Shared/_SupervisorLayout.cshtml";
}

<link href="~/Content/SupervisorSubmissions.css" rel="stylesheet" />

<div class="modern-submissions-page">

    <!-- =====================================================
         PAGE HEADER
    ====================================================== -->

    <div class="modern-page-header">

        <div class="header-content">

            <div class="header-icon">
                <i class="fa-solid fa-file-arrow-up"></i>
            </div>

            <div>
                <div class="header-eyebrow">
                    SUPERVISOR WORKSPACE
                </div>

                <h1>
                    Submissions
                </h1>

                <p>
                    Review research submissions and evaluator feedback
                    for your assigned postgraduate students.
                </p>
            </div>

        </div>

        <div class="submission-count">

            <span class="count-number">
                @Model.Count()
            </span>

            <span class="count-label">
                Submission@(Model.Count() == 1 ? "" : "s")
            </span>

        </div>

    </div>


    <!-- =====================================================
         TOOLBAR
    ====================================================== -->

    <div class="modern-toolbar">

        <!-- FILTERS -->

        <div class="modern-filters">

            <a href="@Url.Action("Submissions", "Supervisors", new { type = "All" })"
               class="modern-filter @(ViewBag.CurrentType == "All" ? "active" : "")">

                <i class="fa-solid fa-layer-group"></i>

                <span>All</span>

            </a>


            <a href="@Url.Action("Submissions", "Supervisors", new { type = "Research Proposal" })"
               class="modern-filter @(ViewBag.CurrentType == "Research Proposal" ? "active" : "")">

                <i class="fa-solid fa-file-lines"></i>

                <span>Research Proposals</span>

            </a>


            <a href="@Url.Action("Submissions", "Supervisors", new { type = "Evaluator Evaluation" })"
               class="modern-filter @(ViewBag.CurrentType == "Evaluator Evaluation" ? "active" : "")">

                <i class="fa-solid fa-clipboard-check"></i>

                <span>Evaluator Evaluations</span>

            </a>

        </div>


        <!-- SEARCH -->

        <div class="modern-search">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="submissionSearch"
                   placeholder="Search submissions..."
                   autocomplete="off" />

            <button type="button"
                    id="clearSubmissionSearch"
                    class="modern-search-clear"
                    title="Clear search">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

    </div>


    <!-- =====================================================
         EMPTY STATE
    ====================================================== -->

    @if (!Model.Any())
    {
        <div class="modern-empty-state">

            <div class="empty-icon">
                <i class="fa-solid fa-folder-open"></i>
            </div>

            <h3>
                No submissions available
            </h3>

            <p>
                There are currently no research submissions or evaluator
                evaluations available for your assigned students.
            </p>

        </div>
    }
    else
    {

        <!-- =================================================
             NO SEARCH RESULTS
        ================================================== -->

        <div id="noSearchResults"
             class="modern-no-results"
             style="display:none;">

            <div class="no-results-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h3>
                No matching submissions
            </h3>

            <p>
                Try searching by student name, student number,
                research title or submission type.
            </p>

        </div>


        <!-- =================================================
             SUBMISSIONS
        ================================================== -->

        <div class="submissions-list">

            @foreach (var item in Model)
            {
                <div class="modern-submission-card searchable-submission">

                    <!-- =================================================
                         CARD TOP
                    ================================================== -->

                    <div class="submission-card-top">

                        <div class="submission-main">

                            <div class="submission-type-icon
                                @(item.SubmissionType == "Evaluator Evaluation"
                                    ? "evaluation-icon"
                                    : "proposal-icon")">

                                @if (item.SubmissionType == "Evaluator Evaluation")
                                {
                                    <i class="fa-solid fa-clipboard-check"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-file-lines"></i>
                                }

                            </div>


                            <div class="submission-title-area">

                                <div class="submission-category">
                                    @item.SubmissionType
                                </div>

                                <h3>
                                    @item.DocumentName
                                </h3>

                            </div>

                        </div>


                        <!-- STATUS -->

                        <div class="submission-status">

                            @if (item.SubmissionType == "Evaluator Evaluation")
                            {
                                if (item.Status == "Approved")
                                {
                                    <span class="modern-status status-approved">
                                        <span></span>
                                        Approved
                                    </span>
                                }
                                else if (item.Status == "Approved with Changes")
                                {
                                    <span class="modern-status status-approved">
                                        <span></span>
                                        Approved with Changes
                                    </span>
                                }
                                else if (item.Status == "Revision Required")
                                {
                                    <span class="modern-status status-revision">
                                        <span></span>
                                        Revision Required
                                    </span>
                                }
                                else if (item.Status == "Rejected")
                                {
                                    <span class="modern-status status-rejected">
                                        <span></span>
                                        Rejected
                                    </span>
                                }
                                else
                                {
                                    <span class="modern-status status-pending">
                                        <span></span>
                                        Submitted
                                    </span>
                                }
                            }
                            else if (item.Status == "Approved")
                            {
                                <span class="modern-status status-approved">
                                    <span></span>
                                    Approved
                                </span>
                            }
                            else if (item.Status == "Rejected")
                            {
                                <span class="modern-status status-rejected">
                                    <span></span>
                                    Rejected
                                </span>
                            }
                            else if (item.Status == "Revision Required")
                            {
                                <span class="modern-status status-revision">
                                    <span></span>
                                    Revision Required
                                </span>
                            }
                            else
                            {
                                <span class="modern-status status-pending">
                                    <span></span>
                                    Pending
                                </span>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         DIVIDER
                    ================================================== -->

                    <div class="submission-divider"></div>


                    <!-- =================================================
                         DETAILS
                    ================================================== -->

                    <div class="modern-submission-details">

                        <!-- STUDENT -->

                        <div class="detail-item">

                            <div class="detail-icon">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>

                            <div>
                                <span>
                                    Student
                                </span>

                                <strong>
                                    @item.StudentName
                                </strong>
                            </div>

                        </div>


                        <!-- RESEARCH TITLE -->

                        <div class="detail-item detail-wide">

                            <div class="detail-icon">
                                <i class="fa-solid fa-book-open"></i>
                            </div>

                            <div>
                                <span>
                                    Research Title
                                </span>

                                <strong title="@item.ProposalTitle">
                                    @item.ProposalTitle
                                </strong>
                            </div>

                        </div>


                        <!-- DATE -->

                        <div class="detail-item">

                            <div class="detail-icon">
                                <i class="fa-regular fa-calendar"></i>
                            </div>

                            <div>
                                <span>
                                    @(item.SubmissionType == "Evaluator Evaluation"
                                        ? "Evaluation Date"
                                        : "Submitted")
                                </span>

                                <strong>
                                    @(item.SubmittedDate.HasValue
                                        ? item.SubmittedDate.Value.ToString("dd MMM yyyy")
                                        : "N/A")
                                </strong>
                            </div>

                        </div>


                        <!-- STUDENT NUMBER -->

                        <div class="detail-item">

                            <div class="detail-icon">
                                <i class="fa-solid fa-id-card"></i>
                            </div>

                            <div>
                                <span>
                                    Student Number
                                </span>

                                <strong>
                                    @item.StudentNumber
                                </strong>
                            </div>

                        </div>


                        <!-- QUALIFICATION -->

                        <div class="detail-item">

                            <div class="detail-icon">
                                <i class="fa-solid fa-graduation-cap"></i>
                            </div>

                            <div>
                                <span>
                                    Qualification
                                </span>

                                <strong>
                                    @item.Qualification
                                </strong>
                            </div>

                        </div>


                        <!-- STUDY TYPE -->

                        @if (!string.IsNullOrWhiteSpace(item.StudyType))
                        {
                            <div class="detail-item">

                                <div class="detail-icon">
                                    <i class="fa-solid fa-layer-group"></i>
                                </div>

                                <div>
                                    <span>
                                        Study Type
                                    </span>

                                    <strong>
                                        @item.StudyType
                                    </strong>
                                </div>

                            </div>
                        }

                    </div>


                    <!-- =================================================
                         EVALUATOR FEEDBACK
                    ================================================== -->

                    @if (item.SubmissionType == "Evaluator Evaluation" &&
                         !string.IsNullOrWhiteSpace(item.Feedback))
                    {
                        <div class="modern-feedback">

                            <div class="feedback-icon">
                                <i class="fa-solid fa-comment-dots"></i>
                            </div>

                            <div class="feedback-content">

                                <span>
                                    Evaluator Feedback
                                </span>

                                <p>
                                    @item.Feedback
                                </p>

                            </div>

                        </div>
                    }


                    <!-- =================================================
                         ACTIONS
                    ================================================== -->

                    <div class="modern-submission-footer">

                        <div class="submission-footer-info">

                            @if (item.SubmissionType == "Evaluator Evaluation")
                            {
                                <span>
                                    <i class="fa-solid fa-user-check"></i>
                                    Evaluator submission
                                </span>
                            }
                            else
                            {
                                <span>
                                    <i class="fa-solid fa-file-lines"></i>
                                    Research proposal
                                </span>
                            }

                        </div>


                        <div class="modern-actions">

                            @if (item.SubmissionType == "Evaluator Evaluation")
                            {
                                <a href="@Url.Action(
                                    "EvaluationDetails",
                                    "Supervisors",
                                    new { id = item.SubmissionID })"
                                   class="modern-action primary-action">

                                    <i class="fa-solid fa-clipboard-check"></i>

                                    Review Evaluation

                                    <i class="fa-solid fa-arrow-right action-arrow"></i>

                                </a>
                            }
                            else if (!string.IsNullOrWhiteSpace(item.FilePath))
                            {
                                                    <a href="@Url.Action(
                                    "ViewDocument",
                                    "Supervisors",
                                    new { id = item.ProposalID})"
                                                       target="_blank"
                                   class="modern-action secondary-action">

                                    <i class="fa-solid fa-eye"></i>

                                    View

                                </a>


                                                    <a href="@Url.Action(
                                        "ViewDocument",
                                        "Supervisors",
                                        new { id = item.ProposalID })"
                                           class="modern-action secondary-action">

                                                        <i class="fa-solid fa-download"></i>

                                                        Download

                                                    </a>
                            }
                            else
                            {
                                <span class="modern-no-document">

                                    <i class="fa-solid fa-file-circle-xmark"></i>

                                    Document unavailable

                                </span>
                            }

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>


<!-- =========================================================
     MODERN PAGE STYLING
========================================================= -->

<style>

    /* =====================================================
       PAGE
    ====================================================== */

    .modern-submissions-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 10px 5px 50px;
        color: #26364a;
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .modern-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        margin-bottom: 28px;
        padding: 28px 32px;
        background: linear-gradient(135deg, #001B44 0%, #07366d 100%);
        border-radius: 18px;
        box-shadow: 0 10px 30px rgba(0, 27, 68, 0.16);
        overflow: hidden;
        position: relative;
    }


        .modern-page-header::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            right: -80px;
            top: -110px;
            border-radius: 50%;
            background: rgba(253, 185, 19, 0.12);
        }


    .header-content {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 2;
    }


    .header-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 15px;
        background: rgba(253, 185, 19, 0.15);
        border: 1px solid rgba(253, 185, 19, 0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #FDB913;
        font-size: 23px;
    }


    .header-eyebrow {
        color: #FDB913;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: 1.5px;
        margin-bottom: 5px;
    }


    .modern-page-header h1 {
        margin: 0 0 5px;
        color: #ffffff;
        font-size: 30px;
        font-weight: 750;
        letter-spacing: -0.5px;
    }


    .modern-page-header p {
        margin: 0;
        color: rgba(255,255,255,0.76);
        font-size: 14px;
        line-height: 1.5;
    }


    .submission-count {
        position: relative;
        z-index: 2;
        min-width: 105px;
        padding: 14px 18px;
        border-radius: 12px;
        background: rgba(255,255,255,0.09);
        border: 1px solid rgba(255,255,255,0.13);
        text-align: center;
    }


    .count-number {
        display: block;
        color: #FDB913;
        font-size: 25px;
        font-weight: 800;
        line-height: 1;
        margin-bottom: 5px;
    }


    .count-label {
        display: block;
        color: rgba(255,255,255,0.72);
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }


    /* =====================================================
       TOOLBAR
    ====================================================== */

    .modern-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 22px;
        padding: 6px;
        flex-wrap: wrap;
    }


    .modern-filters {
        display: flex;
        align-items: center;
        gap: 6px;
        padding: 5px;
        background: #f1f4f8;
        border: 1px solid #e2e7ee;
        border-radius: 12px;
    }


    .modern-filter {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 15px;
        border-radius: 8px;
        color: #607086;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 650;
        white-space: nowrap;
        transition: all 0.2s ease;
    }


        .modern-filter i {
            font-size: 13px;
        }


        .modern-filter:hover {
            color: #001B44;
            background: #ffffff;
        }


        .modern-filter.active {
            color: #001B44;
            background: #FDB913;
            box-shadow: 0 3px 8px rgba(253,185,19,0.25);
        }


    /* =====================================================
       SEARCH
    ====================================================== */

    .modern-search {
        width: 310px;
        height: 44px;
        position: relative;
        flex-shrink: 0;
    }


        .modern-search > i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a8798;
            font-size: 14px;
            pointer-events: none;
            z-index: 2;
        }


        .modern-search input {
            width: 100%;
            height: 100%;
            box-sizing: border-box;
            padding: 0 42px;
            border: 1px solid #dce2ea;
            border-radius: 11px;
            background: #ffffff;
            color: #26364a;
            font-size: 13px;
            outline: none;
            transition: all 0.2s ease;
            box-shadow: 0 2px 8px rgba(0,0,0,0.03);
        }


            .modern-search input:focus {
                border-color: #001B44;
                box-shadow: 0 0 0 3px rgba(0,27,68,0.08);
            }


            .modern-search input::placeholder {
                color: #9aa5b3;
            }


    .modern-search-clear {
        position: absolute;
        right: 8px;
        top: 50%;
        transform: translateY(-50%);
        width: 29px;
        height: 29px;
        border: 0;
        border-radius: 7px;
        background: transparent;
        color: #8b96a4;
        display: none;
        align-items: center;
        justify-content: center;
        cursor: pointer;
    }


        .modern-search-clear:hover {
            background: #eef1f5;
            color: #001B44;
        }


    /* =====================================================
       SUBMISSION LIST
    ====================================================== */

    .submissions-list {
        display: flex;
        flex-direction: column;
        gap: 17px;
    }


    /* =====================================================
       CARD
    ====================================================== */

    .modern-submission-card {
        background: #ffffff;
        border: 1px solid #e4e8ee;
        border-radius: 16px;
        padding: 22px 24px 20px;
        box-shadow: 0 4px 14px rgba(16, 37, 63, 0.055);
        transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    }


        .modern-submission-card:hover {
            transform: translateY(-2px);
            border-color: #d5dce5;
            box-shadow: 0 10px 28px rgba(16, 37, 63, 0.09);
        }


    /* =====================================================
       CARD HEADER
    ====================================================== */

    .submission-card-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 20px;
    }


    .submission-main {
        display: flex;
        align-items: center;
        gap: 15px;
        min-width: 0;
    }


    .submission-type-icon {
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }


    .proposal-icon {
        background: #edf3fb;
        color: #155aa8;
    }


    .evaluation-icon {
        background: #fff5d9;
        color: #a56b00;
    }


    .submission-title-area {
        min-width: 0;
    }


    .submission-category {
        margin-bottom: 4px;
        color: #8a96a5;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 1px;
    }


    .submission-title-area h3 {
        margin: 0;
        color: #1c2b3d;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
        word-break: break-word;
    }


    /* =====================================================
       STATUS
    ====================================================== */

    .modern-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 11px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 750;
        white-space: nowrap;
    }


        .modern-status > span {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            display: inline-block;
        }


    .status-approved {
        color: #217047;
        background: #eaf7ef;
    }


        .status-approved > span {
            background: #35a768;
        }


    .status-pending {
        color: #8a6300;
        background: #fff7dd;
    }


        .status-pending > span {
            background: #e5ad17;
        }


    .status-revision {
        color: #8c5710;
        background: #fff0dc;
    }


        .status-revision > span {
            background: #d88a18;
        }


    .status-rejected {
        color: #a23a3a;
        background: #fdecec;
    }


        .status-rejected > span {
            background: #d95353;
        }


    /* =====================================================
       DIVIDER
    ====================================================== */

    .submission-divider {
        height: 1px;
        background: #edf0f4;
        margin: 20px 0;
    }


    /* =====================================================
       DETAILS
    ====================================================== */

    .modern-submission-details {
        display: grid;
        grid-template-columns: minmax(170px, 0.9fr) minmax(280px, 1.7fr) minmax(150px, 0.8fr) minmax(160px, 0.9fr) minmax(180px, 1fr) minmax(150px, 0.8fr);
        gap: 18px;
    }


    .detail-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        min-width: 0;
    }


    .detail-icon {
        width: 30px;
        height: 30px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #f4f6f9;
        color: #617086;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
    }


    .detail-item > div:last-child {
        min-width: 0;
    }


    .detail-item span {
        display: block;
        margin-bottom: 4px;
        color: #98a2af;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.55px;
    }


    .detail-item strong {
        display: block;
        color: #35465a;
        font-size: 12px;
        font-weight: 650;
        line-height: 1.4;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }


    /* =====================================================
       FEEDBACK
    ====================================================== */

    .modern-feedback {
        display: flex;
        align-items: flex-start;
        gap: 13px;
        margin-top: 20px;
        padding: 14px 16px;
        background: #fffbef;
        border: 1px solid #f5e5ae;
        border-left: 4px solid #FDB913;
        border-radius: 10px;
    }


    .feedback-icon {
        width: 32px;
        height: 32px;
        flex-shrink: 0;
        border-radius: 8px;
        background: #fff1bf;
        color: #9b7000;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }


    .feedback-content {
        min-width: 0;
    }


        .feedback-content > span {
            display: block;
            margin-bottom: 4px;
            color: #745900;
            font-size: 11px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.6px;
        }


        .feedback-content p {
            margin: 0;
            color: #5c5140;
            font-size: 13px;
            line-height: 1.55;
        }


    /* =====================================================
       FOOTER
    ====================================================== */

    .modern-submission-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-top: 21px;
        padding-top: 17px;
        border-top: 1px solid #edf0f4;
    }


    .submission-footer-info {
        color: #8a96a5;
        font-size: 11px;
        font-weight: 600;
    }


        .submission-footer-info i {
            margin-right: 5px;
            color: #001B44;
        }


    .modern-actions {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
        justify-content: flex-end;
    }


    .modern-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        min-height: 36px;
        padding: 8px 13px;
        border-radius: 8px;
        text-decoration: none !important;
        font-size: 12px;
        font-weight: 700;
        transition: all 0.2s ease;
        white-space: nowrap;
    }


    .primary-action {
        background: #001B44;
        color: #ffffff !important;
        border: 1px solid #001B44;
        box-shadow: 0 3px 8px rgba(0,27,68,0.12);
    }


