@{
        ViewBag.Title = "Proposal";
        Layout = "~/Views/Shared/_StudentLayout.cshtml";
}


<div class="page-header">

    <h2>
        <i class="fa-solid fa-file-lines"></i>
        Research Proposal
    </h2>

    <p>
        Upload your research proposal and monitor its review progress.
    </p>

</div>



<div class="card-section">


    <div style="display:flex; justify-content:space-between; align-items:center;">

        <h3>
            My Proposals
        </h3>


        <a href="@Url.Action("NewProposal","Student")"
           class="btn btn-warning">

            <i class="fa-solid fa-upload"></i>
            Upload New Proposal

        </a>


    </div>


    <br />


    <<table class="table">

    <tr>

        <th>
            Document
        </th>

        <th>
            Research Title
        </th>

        <th>
            Date Submitted
        </th>

        <th>
            Status
        </th>

        <th>
            Feedback
        </th>

        <th>
            Action
        </th>

    </tr>


    <tr>

        <td colspan="6">

            No proposal submitted yet.

        </td>

    </tr>


</table>


</div>

