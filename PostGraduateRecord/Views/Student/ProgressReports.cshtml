@model IEnumerable<PostGraduateRecord.Models.ProgressReport>

@{
    ViewBag.Title = "Progress Reports";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="progress-reports-page">

    <div class="progress-reports-header">
        <div>
            <div class="progress-reports-label">
                <i class="fa-solid fa-chart-line"></i>
                RESEARCH PROGRESS
            </div>

            <h1>Progress Reports</h1>

            <p>
                View progress reports issued by your supervisor.
            </p>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="progress-reports-list">

            @foreach (var report in Model)
            {
                <div class="progress-report-card">

                    <div class="progress-report-card-top">

                        <div>
                            <span class="progress-report-number">
                                PROGRESS REPORT
                                @if (report.ReportNumber.HasValue)
                                {
                                    @report.ReportNumber.Value
                                }
                            </span>

                            <h2>
                                @if (report.Proposal != null)
                                {
                                    @report.Proposal.Title
                                }
                                else
                                {
                                    @:Research Progress Report
                                }
                            </h2>
                        </div>

                        <span class="progress-report-status">
                            @report.Status
                        </span>

                    </div>


                    <div class="progress-report-details">

                        <div class="progress-detail">
                            <span>
                                <i class="fa-regular fa-calendar"></i>
                                Report Date
                            </span>

                            <strong>
                                @if (report.ReportDate.HasValue)
                                {
                                    @report.ReportDate.Value.ToString("dd MMMM yyyy")
                                }
                                else
                                {
                                    @:Not specified
                                }
                            </strong>
                        </div>


                        <div class="progress-detail">
                            <span>
                                <i class="fa-solid fa-calendar-days"></i>
                                Reporting Period
                            </span>

                            <strong>
                                @report.ReportingPeriod
                            </strong>
                        </div>


                        <div class="progress-detail">
                            <span>
                                <i class="fa-solid fa-file-lines"></i>
                                Report Number
                            </span>

                            <strong>
                                @if (report.ReportNumber.HasValue)
                                {
                                    @report.ReportNumber.Value
                                }
                                else
                                {
                                    @:—
                                }
                            </strong>
                        </div>

                    </div>


                    <div class="progress-report-summary">

                        <span>Progress Summary</span>

                        <p>
                            @if (!string.IsNullOrWhiteSpace(report.Summary))
                            {
                                if (report.Summary.Length > 220)
                                {
                                    @report.Summary.Substring(0, 220)
                                    @:...
                                }
                                else
                                {
                                    @report.Summary
                                }
                            }
                            else
                            {
                                @:No progress summary provided.
                            }
                        </p>

                    </div>


                    <div class="progress-report-actions">

                        <a href="@Url.Action(
                            "ViewProgressReport",
                            "Student",
                            new { id = report.ProgressReportID })"
                           class="view-progress-report-button">

                            <i class="fa-solid fa-eye"></i>

                            View Report

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <div class="no-progress-reports">

            <div class="no-progress-icon">
                <i class="fa-solid fa-chart-line"></i>
            </div>

            <h2>No Progress Reports Yet</h2>

            <p>
                Your supervisor has not issued a progress report yet.
                Once a report is issued, it will appear here.
            </p>

        </div>
    }

</div>

<style>

    .progress-reports-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 30px;
    }

    .progress-reports-header {
        margin-bottom: 30px;
    }

    .progress-reports-label {
        color: #001B44;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .progress-reports-header h1 {
        margin: 0;
        color: #001B44;
        font-size: 32px;
        font-weight: 700;
    }

    .progress-reports-header p {
        margin-top: 8px;
        color: #6b7280;
        font-size: 15px;
    }

    .progress-reports-list {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .progress-report-card {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 5px 18px rgba(0, 27, 68, 0.07);
    }

    .progress-report-card-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e5e7eb;
    }

    .progress-report-number {
        color: #FDB913;
        background: #001B44;
        display: inline-block;
        padding: 5px 10px;
        border-radius: 5px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .8px;
        margin-bottom: 10px;
    }

    .progress-report-card h2 {
        margin: 0;
        color: #001B44;
        font-size: 20px;
        font-weight: 700;
    }

    .progress-report-status {
        background: #FDB913;
        color: #001B44;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .progress-report-details {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        padding: 20px 0;
    }

    .progress-detail {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .progress-detail span {
            color: #6b7280;
            font-size: 12px;
            font-weight: 600;
        }

            .progress-detail span i {
                margin-right: 5px;
            }

        .progress-detail strong {
            color: #001B44;
            font-size: 14px;
        }

    .progress-report-summary {
        background: #f8fafc;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
    }

        .progress-report-summary span {
            color: #001B44;
            font-size: 13px;
            font-weight: 700;
        }

        .progress-report-summary p {
            color: #4b5563;
            margin: 8px 0 0;
            line-height: 1.6;
            font-size: 14px;
        }

    .progress-report-actions {
        display: flex;
        justify-content: flex-end;
    }

    .view-progress-report-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        background: #001B44;
        color: #ffffff;
        text-decoration: none;
        border-radius: 8px;
        font-size: 14px;
        font-weight: 600;
    }

        .view-progress-report-button:hover {
            background: #FDB913;
            color: #001B44;
            text-decoration: none;
        }

    .no-progress-reports {
        background: #ffffff;
        border: 1px solid #e5e7eb;
        border-radius: 16px;
        padding: 60px 30px;
        text-align: center;
        box-shadow: 0 5px 18px rgba(0, 27, 68, 0.06);
    }

    .no-progress-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: #001B44;
        color: #FDB913;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .no-progress-reports h2 {
        color: #001B44;
        font-size: 22px;
        margin-bottom: 8px;
    }

    .no-progress-reports p {
        color: #6b7280;
        max-width: 550px;
        margin: 0 auto;
        line-height: 1.6;
    }

    @@media (max-width: 768px) {

        .progress-reports-page {
            padding: 20px;
        }

        .progress-report-card-top {
            flex-direction: column;
        }

        .progress-report-details {
            grid-template-columns: 1fr;
        }

        .progress-report-actions {
            justify-content: stretch;
        }

        .view-progress-report-button {
            width: 100%;
            justify-content: center;
        }
    }
</style>