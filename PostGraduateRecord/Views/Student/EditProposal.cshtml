@model PostGraduateRecord.ViewModels.ProposalViewModel

@{
    ViewBag.Title = "Edit Proposal";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<h2>Edit Research Proposal</h2>

<hr />

@using (Html.BeginForm("EditProposal",
                       "Student",
                       FormMethod.Post,
                       new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    @Html.HiddenFor(m => m.ProposalID)

    <div class="form-group">
        <label>Proposal Title</label>
        @Html.TextBoxFor(m => m.Title,
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Research Field</label>
        @Html.TextBoxFor(m => m.ResearchField,
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Abstract</label>
        @Html.TextAreaFor(m => m.Abstract,
            new { @class = "form-control", rows = 6 })
    </div>

    <div class="form-group">
        <label>Keywords</label>
        @Html.TextBoxFor(m => m.Keywords,
            new { @class = "form-control" })
    </div>

    <div class="form-group">
        <label>Replace Proposal Document (optional)</label>

        <input type="file"
               name="ProposalFile"
               class="form-control"
               accept=".pdf,.doc,.docx" />
    </div>

    <br />

    <button type="submit"
            class="btn btn-success">

        <i class="fa-solid fa-floppy-disk"></i>
        Save Changes

    </button>

    <a href="@Url.Action("Proposal")"
       class="btn btn-secondary">

        Cancel

    </a>
}

