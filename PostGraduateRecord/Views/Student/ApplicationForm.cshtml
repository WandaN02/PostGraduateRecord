@{
    ViewBag.Title = "Application Form";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<style>

    /* =========================================
       APPLICATION FORM PAGE
    ========================================= */

    .application-form-page {
        width: 100%;
        margin: 0;
        padding: 10px 20px 40px 20px;
        box-sizing: border-box;
        text-align: left;
    }

    .application-header {
        margin-bottom: 25px;
        text-align: left;
    }

        .application-header h2 {
            font-size: 32px;
            font-weight: 600;
            color: #001B44;
            margin: 0 0 8px 0;
            text-align: left;
        }

        .application-header p {
            margin: 0;
            color: #6c757d;
            font-size: 15px;
            text-align: left;
        }

    .application-card {
        width: 100%;
        max-width: 900px;
        margin: 0 auto;
        background: #ffffff;
        border-radius: 12px;
        border: 1px solid #e1e5ea;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        overflow: hidden;
        box-sizing: border-box;
    }

    .application-card-header {
        background: #001B44;
        color: white;
        padding: 22px 28px;
    }

    .application-card-header h3 {
        margin: 0;
        font-size: 20px;
        font-weight: 600;
    }

    .application-card-header i {
        margin-right: 8px;
    }

    .application-body {
        padding: 30px;
    }

    .form-group {
        margin-bottom: 22px;
    }

    .form-group label {
        display: block;
        font-size: 14px;
        font-weight: 600;
        color: #001B44;
        margin-bottom: 8px;
    }

    .form-control {
        width: 100%;
        padding: 12px 14px;
        border: 1px solid #ced4da;
        border-radius: 7px;
        font-size: 15px;
        box-sizing: border-box;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .form-control:focus {
        border-color: #001B44;
        outline: none;
        box-shadow: 0 0 0 3px rgba(0, 27, 68, 0.10);
    }

    .field-help {
        display: block;
        margin-top: 6px;
        color: #6c757d;
        font-size: 12px;
        line-height: 1.5;
    }

    .info-box {
        background: #f8f9fb;
        border-left: 4px solid #FDB913;
        padding: 15px 18px;
        border-radius: 7px;
        margin-bottom: 25px;
    }

    .info-box strong {
        color: #001B44;
    }

    .info-box p {
        margin: 5px 0 0 0;
        color: #555;
        font-size: 14px;
        line-height: 1.5;
    }

    .upload-box {
        background: #f8f9fb;
        border: 1px dashed #b8bec5;
        border-radius: 8px;
        padding: 15px;
    }

    .upload-box .form-control {
        background: white;
    }

    .submit-section {
        margin-top: 30px;
        padding-top: 20px;
        border-top: 1px solid #e5e5e5;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .btn-submit {
        background: #FDB913;
        color: #001B44;
        border: none;
        padding: 12px 24px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

    .btn-submit:hover {
        background: #001B44;
        color: white;
    }

    .btn-cancel {
        background: #6c757d;
        color: white;
        border: none;
        padding: 12px 24px;
        border-radius: 7px;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
    }

    .btn-cancel:hover {
        background: #495057;
        color: white;
        text-decoration: none;
    }

    .alert-success {
        max-width: 900px;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 7px;
        background: #d1e7dd;
        color: #0f5132;
        border: 1px solid #badbcc;
    }

    .alert-error {
        max-width: 900px;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 7px;
        background: #f8d7da;
        color: #842029;
        border: 1px solid #f5c2c7;
    }

    @@media (max-width: 768px) {

        .application-form-page {
            padding: 10px 15px 40px 15px;
        }

        .application-header h2 {
            font-size: 26px;
        }

        .application-body {
            padding: 20px;
        }

        .submit-section {
            flex-direction: column;
        }

        .btn-submit,
        .btn-cancel {
            width: 100%;
            text-align: center;
        }
    }

</style>


<div class="application-form-page">

    <!-- PAGE HEADER -->

    <div class="application-header">

        <h2>
            <i class="fa-solid fa-file-circle-plus"></i>
            Submit New Application
        </h2>

        <p>
            Submit your postgraduate research application for administrator review.
        </p>

    </div>


    <!-- SUCCESS MESSAGE -->
  
    @if (ViewBag.Message != null)
    {
        <div class="alert-error">
            <i class="fa-solid fa-circle-xmark"></i>
            @ViewBag.Message
        </div>
    }
    <!-- APPLICATION CARD -->

    <div class="application-card">

        <!-- CARD HEADER -->

        <div class="application-card-header">

            <h3>

                <i class="fa-solid fa-graduation-cap"></i>

                Postgraduate Research Application

            </h3>

        </div>


        <!-- CARD BODY -->

        <div class="application-body">


            <!-- INFORMATION BOX -->

            <div class="info-box">

                <strong>

                    <i class="fa-solid fa-circle-info"></i>

                    Before you submit

                </strong>

                <p>

                    Your application will first be sent to the administrator
                    for review. You will only be able to continue to the
                    proposal and ethics stages after your application has
                    been approved.

                </p>

            </div>


            <!-- APPLICATION FORM -->

            @using (Html.BeginForm(
                "ApplicationForm",
                "Student",
                FormMethod.Post,
                new { enctype = "multipart/form-data" }))
            {


                <!-- RESEARCH TITLE -->

                <div class="form-group">

                    <label for="ResearchTitle">

                        Research Title

                    </label>

                    <input type="text"
                           id="ResearchTitle"
                           name="ResearchTitle"
                           class="form-control"
                           placeholder="Enter your proposed research title"
                           value="@ViewBag.ResearchTitle"
                           required />

                    <small class="field-help">

                        Enter the title of your proposed postgraduate research.

                    </small>

                </div>


                <!-- DEGREE TYPE -->

                <div class="form-group">

                    <label for="DegreeType">

                        Degree Type

                    </label>

                    <select id="DegreeType"
                            name="DegreeType"
                            class="form-control"
                            required>

                        <option value="">
                            -- Select Degree Type --
                        </option>

                        <option value="Masters"
                                @(ViewBag.DegreeType == "Masters" ? "selected" : "")>
                            Masters
                        </option>

                        <option value="PhD"
                                @(ViewBag.DegreeType == "PhD" ? "selected" : "")>
                            PhD
                        </option>

                    </select>

                </div>


                <!-- RESEARCH FIELD -->

                <div class="form-group">

                    <label for="ResearchField">

                        Research Field

                    </label>

                    <input type="text"
                           id="ResearchField"
                           name="ResearchField"
                           class="form-control"
                           placeholder="e.g. Information Technology"
                           value="@ViewBag.ResearchField"
                           required />

                    <small class="field-help">

                        Enter the main field in which your research will be conducted.

                    </small>

                </div>


                <!-- SUPPORTING DOCUMENT -->

                <div class="form-group">

                    <label for="SupportingDocument">

                        Upload Transcript 

                    </label>

                    <div class="upload-box">

                        <input type="file"
                               id="SupportingDocument"
                               name="SupportingDocument"
                               class="form-control"
                               accept=".pdf,.doc,.docx"
                               required />

                        <small class="field-help">

                            <i class="fa-solid fa-file-lines"></i>

                            Only PDF and Microsoft Word documents are allowed.

                            <br />

                            Accepted formats:
                            <strong>.pdf, .doc, .docx</strong>

                        </small>

                        <div id="applicationFileError"
                             class="text-danger"
                             style="display:none; margin-top:8px;">

                            <i class="fa-solid fa-circle-exclamation"></i>

                            Unsupported file type.
                            Please upload a PDF, DOC, or DOCX file.

                        </div>
                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="submit-section">

                    <a href="@Url.Action("Dashboard", "Student")"
                       class="btn-cancel">

                        <i class="fa-solid fa-arrow-left"></i>

                        Cancel

                    </a>

                    <button type="submit"
                            id="applicationSubmitButton"
                            class="btn-submit">

                        <i class="fa-solid fa-paper-plane"></i>

                        Submit Application

                    </button>

                </div>

            }

        </div>

    </div>

</div>
<script src="~/Content/ApplicationForm.js"></script>