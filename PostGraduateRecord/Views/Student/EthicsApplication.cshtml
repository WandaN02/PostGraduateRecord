@{
    ViewBag.Title = "Ethics Application";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}



<div class="page-header">

    <h2>
        <i class="fa-solid fa-file-circle-check"></i>
        New Ethics Application
    </h2>

</div>



<div class="card-section">


    <form>


        <label>
            Research Title
        </label>

        <input type="text"
               class="form-control" />


        <br />


        <label>
            Research Methodology
        </label>

        <textarea class="form-control"
                  rows="4"></textarea>


        <br />


        <label>
            Participant Information
        </label>

        <textarea class="form-control"
                  rows="4"></textarea>


        <br />


        <label>
            Upload Ethics Document
        </label>

        <input type="file"
               class="form-control" />


        <br />


        <button class="btn btn-warning">

            Submit Ethics Application

        </button>


    </form>


</div>