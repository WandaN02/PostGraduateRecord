
@model PostGraduateRecord.ViewModels.EthicsApplicationViewModel

@{
    ViewBag.Title = "Ethics";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}

<div class="page-header">
    <h2>
        <i class="fa-solid fa-file-circle-check"></i>
        Ethics
    </h2>
</div>

<div class="card-section">


    @using (Html.BeginForm("EthicsApplication", "Student", FormMethod.Post))
    {
        @Html.AntiForgeryToken()

        <!-- ==============================
             ETHICS QUESTION
        =============================== -->

        <div class="form-group">

            <label>
                Did you submit an ethics application?
            </label>

            <div style="margin-top: 10px;">

                <label style="margin-right: 25px;">
                    @Html.RadioButtonFor(
                        m => m.EthicsSubmitted,
                        true,
                        new { id = "ethicsYes" }
                    )
                    Yes
                </label>

                <label>
                    @Html.RadioButtonFor(
                        m => m.EthicsSubmitted,
                        false,
                        new { id = "ethicsNo" }
                    )
                    No
                </label>

            </div>

            @Html.ValidationMessageFor(
                m => m.EthicsSubmitted,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <!-- ==============================
             ETHICS NUMBER
        =============================== -->

        <div id="ethicsNumberSection"
             class="form-group"
             style="display:none;">

            <label>
                Ethics Number
            </label>

            @Html.TextBoxFor(
                m => m.EthicsNumber,
                new
                {
                    @class = "form-control",
                    placeholder = "Enter your Ethics Number",
                    autocomplete = "off"
                }
            )

            <small class="text-muted">
                Enter the Ethics Number provided for your ethics approval.
            </small>

            @Html.ValidationMessageFor(
                m => m.EthicsNumber,
                "",
                new { @class = "text-danger" }
            )

        </div>

        <br />

        <button type="submit" class="btn btn-warning">
            <i class="fa-solid fa-floppy-disk"></i>
            Save Ethics Information
        </button>
    }

</div>
<script src="~/Content/Ethics.js"></script>

