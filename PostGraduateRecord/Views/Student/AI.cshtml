
@{
    ViewBag.Title = "AI Research Assistant";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    var chatHistory = Session["AIChatHistory"] as List<Dictionary<string, string>>;
}

<div class="ai-page">

    <!-- PAGE HEADER -->
    <div class="ai-page-header">

        <div class="ai-page-icon">
            <i class="fa-solid fa-robot"></i>
        </div>

        <div>
            <h1>AI Research Assistant</h1>

            <p>
                Get helpful guidance throughout your postgraduate research journey.
            </p>
        </div>

    </div>


    <!-- AI CHAT CARD -->
    <div class="ai-chat-card">

        <!-- CHAT HEADER -->
        <div class="ai-chat-header">

            <i class="fa-solid fa-comments"></i>

            <div>
                <h2>How can I help you?</h2>

                <p>
                    Ask me a question about your research.
                </p>
            </div>

        </div>


        <!-- ERROR MESSAGE -->
        @if (TempData["AIError"] != null)
        {
            <div class="ai-error-message">

                <i class="fa-solid fa-circle-exclamation"></i>

                @TempData["AIError"]

            </div>
        }


        <!-- CHAT HISTORY -->
        @if (chatHistory != null && chatHistory.Count > 0)
        {
            <div class="ai-chat-history">

                @foreach (var message in chatHistory)
                {
                    if (message["Role"] == "User")
                    {
                        <div class="chat-message user-message">

                            <div class="message-label">
                                <i class="fa-solid fa-user"></i>
                                You
                            </div>

                            <div class="message-text">
                                @message["Message"]
                            </div>

                        </div>
                    }
                    else
                    {
                        <div class="chat-message ai-message">

                            <div class="message-label">
                                <i class="fa-solid fa-robot"></i>
                                AI Research Assistant
                            </div>

                            <div class="message-text">
                                @message["Message"]
                            </div>

                        </div>
                    }
                }

            </div>
        }


        <!-- SUGGESTIONS -->
        <div class="ai-suggestions">

            <button type="button"
                    onclick="setQuestion('Help me choose a research topic for my postgraduate project.')">

                <i class="fa-solid fa-lightbulb"></i>

                Help me choose a research topic

            </button>


            <button type="button"
                    onclick="setQuestion('Help me create research questions for my postgraduate project.')">

                <i class="fa-solid fa-question"></i>

                Help me create research questions

            </button>


            <button type="button"
                    onclick="setQuestion('Explain research methodology and help me choose one for my project.')">

                <i class="fa-solid fa-flask"></i>

                Explain research methodology

            </button>


            <button type="button"
                    onclick="setQuestion('Help me improve my academic writing.')">

                <i class="fa-solid fa-pen"></i>

                Help with academic writing

            </button>

        </div>


        <!-- ASK AI FORM -->
        @using (Html.BeginForm("AskAI", "Student", FormMethod.Post))
        {
            @Html.AntiForgeryToken()

            <div class="ai-input-area">

                <textarea id="aiQuestion"
                          name="question"
                          placeholder="Type your research question here..."></textarea>

                <button type="submit" id="askAiButton">

                    <i class="fa-solid fa-paper-plane"></i>

                    Send

                </button>

            </div>
        }


        <!-- CLEAR CHAT -->
        @if (chatHistory != null && chatHistory.Count > 0)
        {
            <div class="clear-chat-container">

                @using (Html.BeginForm("ClearAIChat", "Student", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <button type="submit" class="clear-chat-button">

                        <i class="fa-solid fa-trash"></i>

                        Clear Conversation

                    </button>
                }

            </div>
        }

    </div>

</div>


<script>

    function setQuestion(question) {

        document.getElementById("aiQuestion").value = question;

        document.getElementById("aiQuestion").focus();

    }

</script>


<style>

    /* ==========================================
       AI PAGE
       ========================================== */

    .ai-page {
        max-width: 1100px;
        margin: 0 auto;
    }


    /* ==========================================
       PAGE HEADER
       ========================================== */

    .ai-page-header {
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 30px;
    }


    .ai-page-icon {
        width: 65px;
        height: 65px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #001B44;
        color: #FDB913;
        border-radius: 50%;
        font-size: 28px;
    }


    .ai-page-header h1 {
        margin: 0;
        color: #001B44;
        font-size: 28px;
    }


    .ai-page-header p {
        margin: 6px 0 0 0;
        color: #666;
    }


    /* ==========================================
       MAIN CHAT CARD
       ========================================== */

    .ai-chat-card {
        background: white;
        border: 1px solid #e5e7eb;
        border-radius: 12px;
        padding: 30px;
        box-shadow: 0 4px 12px rgba(0, 27, 68, 0.08);
    }


    /* ==========================================
       CHAT HEADER
       ========================================== */

    .ai-chat-header {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 20px;
        border-bottom: 1px solid #eee;
    }


        .ai-chat-header > i {
            font-size: 25px;
            color: #FDB913;
        }


        .ai-chat-header h2 {
            margin: 0;
            color: #001B44;
            font-size: 20px;
        }


        .ai-chat-header p {
            margin: 5px 0 0 0;
            color: #777;
        }


    /* ==========================================
       CHAT HISTORY
       ========================================== */

    .ai-chat-history {
        margin-top: 25px;
    }


    .chat-message {
        margin-bottom: 20px;
        padding: 18px;
        border-radius: 10px;
    }


    /* STUDENT MESSAGE */

    .user-message {
        background: #001B44;
        color: white;
        margin-left: 80px;
    }


    /* AI MESSAGE */

    .ai-message {
        background: #f5f7fa;
        color: #333;
        border-left: 5px solid #FDB913;
        margin-right: 80px;
    }


    .message-label {
        font-weight: 700;
        margin-bottom: 8px;
    }


        .message-label i {
            margin-right: 7px;
            color: #FDB913;
        }


    .message-text {
        line-height: 1.6;
        white-space: pre-wrap;
    }


    /* ==========================================
       ERROR MESSAGE
       ========================================== */

    .ai-error-message {
        margin: 20px 0;
        padding: 15px;
        background: #f8d7da;
        color: #842029;
        border-radius: 8px;
    }


        .ai-error-message i {
            margin-right: 8px;
        }


    /* ==========================================
       SUGGESTIONS
       ========================================== */

    .ai-suggestions {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        margin: 25px 0;
    }


        .ai-suggestions button {
            padding: 10px 14px;
            border: 1px solid #dfe3e8;
            border-radius: 8px;
            background: #f8f9fb;
            color: #001B44;
            cursor: pointer;
            font-size: 13px;
        }


            .ai-suggestions button:hover {
                background: #001B44;
                color: white;
            }


        .ai-suggestions i {
            margin-right: 6px;
        }


    /* ==========================================
       INPUT AREA
       ========================================== */

    .ai-input-area {
        display: flex;
        gap: 12px;
        align-items: flex-end;
    }


        .ai-input-area textarea {
            flex: 1;
            min-height: 100px;
            padding: 14px;
            border: 1px solid #d9dde3;
            border-radius: 8px;
            resize: vertical;
            font-family: inherit;
            font-size: 14px;
        }


            .ai-input-area textarea:focus {
                outline: none;
                border-color: #001B44;
            }


    /* ==========================================
       SEND BUTTON
       ========================================== */

    #askAiButton {
        padding: 13px 20px;
        border: none;
        border-radius: 8px;
        background: #001B44;
        color: white;
        cursor: pointer;
        font-weight: 600;
    }


        #askAiButton:hover {
            background: #00316f;
        }


    /* ==========================================
       CLEAR CHAT
       ========================================== */

    .clear-chat-container {
        margin-top: 20px;
        text-align: right;
    }


    .clear-chat-button {
        padding: 9px 14px;
        border: 1px solid #ddd;
        border-radius: 7px;
        background: white;
        color: #666;
        cursor: pointer;
    }


        .clear-chat-button:hover {
            background: #f5f5f5;
            color: #333;
        }


    /* ==========================================
       MOBILE
       ========================================== */

    @@media (max-width: 768px) {

        .ai-page-header {
            align-items: flex-start;
        }

        .ai-chat-card {
            padding: 20px;
        }

        .user-message {
            margin-left: 0;
        }

        .ai-message {
            margin-right: 0;
        }

        .ai-input-area {
            flex-direction: column;
            align-items: stretch;
        }

        #askAiButton {
            width: 100%;
        }
    }
</style>

