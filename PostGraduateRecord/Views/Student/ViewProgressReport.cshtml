@model PostGraduateRecord.Models.ProgressReport

@{
    ViewBag.Title = "Progress Report";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";

    string progressStatus = Model.ProgressStatus ?? "Not specified";

    string statusClass = "status-neutral";
    string statusIcon = "fa-circle-info";

    if (progressStatus.Equals("On Track", StringComparison.OrdinalIgnoreCase))
    {
        statusClass = "status-on-track";
        statusIcon = "fa-circle-check";
    }
    else if (progressStatus.Equals("At Risk", StringComparison.OrdinalIgnoreCase))
    {
        statusClass = "status-at-risk";
        statusIcon = "fa-triangle-exclamation";
    }
    else if (progressStatus.Equals("Delayed", StringComparison.OrdinalIgnoreCase))
    {
        statusClass = "status-delayed";
        statusIcon = "fa-clock";
    }
    else if (progressStatus.Equals("Completed", StringComparison.OrdinalIgnoreCase))
    {
        statusClass = "status-completed";
        statusIcon = "fa-circle-check";
    }
}

<style>

    .progress-report-page {
        max-width: 1100px;
        margin: 0 auto;
        padding: 30px;
    }

    /* =====================================================
       HEADER
       ===================================================== */

    .progress-report-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 20px;
        margin-bottom: 25px;
    }

    .progress-report-label {
        color: #001B44;
        font-size: 13px;
        font-weight: 700;
        letter-spacing: 1.5px;
        margin-bottom: 8px;
    }

    .progress-report-header h1 {
        margin: 0;
        color: #001B44;
        font-size: 32px;
        font-weight: 700;
    }

    .progress-report-header p {
        margin-top: 8px;
        color: #6b7280;
    }

    .progress-back-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        background: #001B44;
        color: white;
        text-decoration: none;
        border-radius: 8px;
        font-weight: 600;
    }

        .progress-back-button:hover {
            background: #FDB913;
            color: #001B44;
            text-decoration: none;
        }

    /* =====================================================
       MAIN CARD
       ===================================================== */

    .progress-report-card {
        background: #ffffff;
        border-radius: 16px;
        box-shadow: 0 5px 20px rgba(0, 27, 68, 0.08);
        overflow: hidden;
        border: 1px solid #e5e7eb;
    }

    /* =====================================================
       CARD HEADER
       ===================================================== */

    .progress-report-card-header {
        background: #001B44;
        color: white;
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

        .progress-report-card-header small {
            display: block;
            color: #FDB913;
            font-weight: 700;
            letter-spacing: 1px;
            margin-bottom: 5px;
        }

        .progress-report-card-header h2 {
            margin: 0;
            font-size: 24px;
            font-weight: 700;
        }

    .report-status {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: rgba(255, 255, 255, 0.12);
        border: 1px solid rgba(255, 255, 255, 0.2);
        color: white;
        padding: 8px 15px;
        border-radius: 20px;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
    }

    /* =====================================================
       PROGRESS STATUS
       ===================================================== */

    .research-status-card {
        margin-bottom: 30px;
        padding: 22px 25px;
        border-radius: 14px;
        border: 1px solid #e5e7eb;
        background: #f8fafc;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .research-status-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .research-status-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }

    .research-status-title {
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .8px;
        margin-bottom: 4px;
    }

    .research-status-value {
        color: #001B44;
        font-size: 22px;
        font-weight: 800;
    }

    .research-status-description {
        color: #6b7280;
        font-size: 13px;
        margin-top: 3px;
    }

    /* ON TRACK */

    .status-on-track {
        background: #ecfdf5;
        border-color: #a7f3d0;
    }

        .status-on-track .research-status-icon {
            background: #d1fae5;
            color: #047857;
        }

        .status-on-track .research-status-value {
            color: #047857;
        }

    /* AT RISK */

    .status-at-risk {
        background: #fffbeb;
        border-color: #fde68a;
    }

        .status-at-risk .research-status-icon {
            background: #fef3c7;
            color: #b45309;
        }

        .status-at-risk .research-status-value {
            color: #b45309;
        }

    /* DELAYED */

    .status-delayed {
        background: #fef2f2;
        border-color: #fecaca;
    }

        .status-delayed .research-status-icon {
            background: #fee2e2;
            color: #b91c1c;
        }

        .status-delayed .research-status-value {
            color: #b91c1c;
        }

    /* COMPLETED */

    .status-completed {
        background: #eff6ff;
        border-color: #bfdbfe;
    }

        .status-completed .research-status-icon {
            background: #dbeafe;
            color: #1d4ed8;
        }

        .status-completed .research-status-value {
            color: #1d4ed8;
        }

    /* NEUTRAL */

    .status-neutral {
        background: #f8fafc;
        border-color: #e5e7eb;
    }

        .status-neutral .research-status-icon {
            background: #e5e7eb;
            color: #475569;
        }

        .status-neutral .research-status-value {
            color: #475569;
        }

    /* =====================================================
       BODY
       ===================================================== */

    .progress-report-body {
        padding: 30px;
    }

    /* =====================================================
       INFORMATION GRID
       ===================================================== */

    .progress-info-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .progress-info-item {
        background: #f8fafc;
        border-radius: 10px;
        padding: 18px;
        border: 1px solid #e5e7eb;
    }

    .progress-info-label {
        display: block;
        color: #6b7280;
        font-size: 12px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .7px;
        margin-bottom: 7px;
    }

    .progress-info-value {
        display: block;
        color: #001B44;
        font-size: 15px;
        font-weight: 600;
        line-height: 1.5;
    }

    /* =====================================================
       SECTIONS
       ===================================================== */

    .progress-section {
        margin-bottom: 25px;
        padding-bottom: 25px;
        border-bottom: 1px solid #e5e7eb;
    }

        .progress-section:last-child {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }

        .progress-section h3 {
            margin: 0 0 12px 0;
            color: #001B44;
            font-size: 18px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .progress-section h3 i {
                color: #FDB913;
            }

        .progress-section p {
            margin: 0;
            color: #374151;
            font-size: 15px;
            line-height: 1.8;
            white-space: pre-line;
        }

    /* =====================================================
       MOBILE
       ===================================================== */

    @@media (max-width: 768px) {

        .progress-report-page {
            padding: 20px;
        }

        .progress-report-header {
            flex-direction: column;
        }

        .progress-report-card-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .research-status-card {
            flex-direction: column;
            align-items: flex-start;
        }

        .progress-info-grid {
            grid-template-columns: 1fr;
        }

        .progress-report-body {
            padding: 20px;
        }
    }
</style>


<div class="progress-report-page">

    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="progress-report-header">

        <div>

            <div class="progress-report-label">
                <i class="fa-solid fa-chart-line"></i>
                RESEARCH PROGRESS
            </div>

            <h1>Progress Report</h1>

            <p>
                Review the research progress assessment issued by your supervisor.
            </p>

        </div>

        <a href="@Url.Action("Dashboard", "Student")"
           class="progress-back-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>


    <!-- =====================================================
         REPORT CARD
         ===================================================== -->

    <div class="progress-report-card">

        <!-- =================================================
             CARD HEADER
             ================================================= -->

        <div class="progress-report-card-header">

            <div>

                <small>SUPERVISOR REPORT</small>

                <h2>

                    Progress Report

                    @if (Model.ReportNumber.HasValue)
                    {
                        <span>#@Model.ReportNumber.Value</span>
                    }

                </h2>

            </div>


            <span class="report-status">

                <i class="fa-solid fa-file-circle-check"></i>

                @(string.IsNullOrWhiteSpace(Model.Status)
                    ? "Issued"
                    : Model.Status)

            </span>

        </div>


        <div class="progress-report-body">


            <!-- =================================================
                 RESEARCH PROGRESS STATUS
                 ================================================= -->

            <div class="research-status-card @statusClass">

                <div class="research-status-left">

                    <div class="research-status-icon">

                        <i class="fa-solid @statusIcon"></i>

                    </div>


                    <div>

                        <div class="research-status-title">
                            Research Progress Status
                        </div>

                        <div class="research-status-value">
                            @progressStatus
                        </div>

                        <div class="research-status-description">

                            @if (progressStatus.Equals(
                                "On Track",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                @:Your research is progressing according to the expected plan.
                            }
                            else if (progressStatus.Equals(
                                "At Risk",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                @:Your research is progressing, but some areas may require attention.
                            }
                            else if (progressStatus.Equals(
                                "Delayed",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                @:Your research is currently behind the expected progress.
                            }
                            else if (progressStatus.Equals(
                                "Completed",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                @:The research activities covered by this report have been completed.
                            }
                            else
                            {
                                @:Your supervisor has not specified a progress status for this report.
                            }

                        </div>

                    </div>

                </div>

            </div>


            <!-- =================================================
                 REPORT INFORMATION
                 ================================================= -->

            <div class="progress-info-grid">


                <div class="progress-info-item">

                    <span class="progress-info-label">
                        Report Date
                    </span>

                    <span class="progress-info-value">

                        @if (Model.ReportDate.HasValue)
                        {
                            @Model.ReportDate.Value.ToString("dd MMMM yyyy")
                        }
                        else
                        {
                            @:Not specified
                        }

                    </span>

                </div>


                <div class="progress-info-item">

                    <span class="progress-info-label">
                        Reporting Period
                    </span>

                    <span class="progress-info-value">

                        @(string.IsNullOrWhiteSpace(Model.ReportingPeriod)
                            ? "Not specified"
                            : Model.ReportingPeriod)

                    </span>

                </div>


                <div class="progress-info-item">

                    <span class="progress-info-label">
                        Research Title
                    </span>

                    <span class="progress-info-value">

                        @if (Model.Proposal != null)
                        {
                            @Model.Proposal.Title
                        }
                        else
                        {
                            @:Research Project
                        }

                    </span>

                </div>

            </div>


            <!-- =================================================
                 PROGRESS SUMMARY
                 ================================================= -->

            <div class="progress-section">

                <h3>

                    <i class="fa-solid fa-align-left"></i>

                    Progress Summary

                </h3>

                <p>

                    @(
                        string.IsNullOrWhiteSpace(Model.Summary)
                            ? "No progress summary was provided."
                            : Model.Summary
                    )

                </p>

            </div>


            <!-- =================================================
                 CURRENT PROGRESS
                 ================================================= -->

            <div class="progress-section">

                <h3>

                    <i class="fa-solid fa-chart-line"></i>

                    Current Progress

                </h3>

                <p>

                    @(
                        string.IsNullOrWhiteSpace(Model.CurrentProgress)
                            ? "No current progress details were provided."
                            : Model.CurrentProgress
                    )

                </p>

            </div>


            <!-- =================================================
                 CHALLENGES
                 ================================================= -->

            <div class="progress-section">

                <h3>

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    Challenges

                </h3>

                <p>

                    @(
                        string.IsNullOrWhiteSpace(Model.Challenges)
                            ? "No challenges were recorded."
                            : Model.Challenges
                    )

                </p>

            </div>


            <!-- =================================================
                 SUPERVISOR COMMENTS
                 ================================================= -->

            <div class="progress-section">

                <h3>

                    <i class="fa-solid fa-comment-dots"></i>

                    Supervisor Comments

                </h3>

                <p>

                    @(
                        string.IsNullOrWhiteSpace(Model.SupervisorComments)
                            ? "No additional comments were provided."
                            : Model.SupervisorComments
                    )

                </p>

            </div>


            <!-- =================================================
                 NEXT STEPS
                 ================================================= -->

            <div class="progress-section">

                <h3>

                    <i class="fa-solid fa-list-check"></i>

                    Next Steps

                </h3>

                <p>

                    @(
                        string.IsNullOrWhiteSpace(Model.NextSteps)
                            ? "No next steps were recorded."
                            : Model.NextSteps
                    )

                </p>

            </div>


        </div>

    </div>

</div>