@{
    ViewBag.Title = "New Proposal";
    Layout = "~/Views/Shared/_StudentLayout.cshtml";
}



<div class="page-header">

    <h2>
        <i class="fa-solid fa-upload"></i>
        Upload Research Proposal
    </h2>

</div>



<div class="card-section">


    <form>


        <label>
            Proposal Title
        </label>

        <input type="text"
               class="form-control" />


        <br />


        <label>
            Research Field
        </label>

        <input type="text"
               class="form-control" />


        <br />


        <label>
            Abstract
        </label>

        <textarea class="form-control"
                  rows="5"></textarea>


        <br />


        <label>
            Upload Proposal Document
        </label>

        <input type="file"
               class="form-control" />


        <br />


        <button class="btn btn-warning">

            Submit Proposal

        </button>


    </form>


</div>

