@model PostGraduateRecord.ViewModels.EvaluatorReviewViewModel

@{
    ViewBag.Title = "Evaluate Proposal";
    Layout = "~/Views/Shared/_EvaluatorLayout.cshtml";

    bool isCompleted = Model.IsCompleted;

    int criteriaCount = Model.Criteria != null
        ? Model.Criteria.Count
        : 0;

    decimal maximumScore = Model.Criteria != null
        ? Model.Criteria.Sum(x => x.MaxScore)
        : 0;
}

<div class="evaluator-review-page">

    @if (TempData["Success"] != null)
    {
        <div class="evaluation-success-message">
            <div class="success-message-icon">
                <i class="fa-solid fa-check"></i>
            </div>

            <div>
                <strong>Evaluation Submitted Successfully</strong>
                <span>@TempData["Success"]</span>
            </div>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="evaluation-error-message">
            <div class="error-message-icon">
                <i class="fa-solid fa-circle-exclamation"></i>
            </div>

            <div>
                <strong>Evaluation Notice</strong>
                <span>@TempData["Error"]</span>
            </div>
        </div>
    }


    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="review-header">

        <div>
            <div class="header-label">
                <i class="fa-solid fa-clipboard-check"></i>
                EVALUATOR REVIEW
            </div>

            <h2>Evaluate Research Proposal</h2>

            <p>
                Review each criterion and award a mark from 1 to 5.
                Provide comments when a rating of 1, 2 or 3 is awarded.
            </p>
        </div>

        <div class="header-icon">
            <i class="fa-solid fa-file-circle-check"></i>
        </div>

    </div>


    <!-- =========================================================
         COMPLETED NOTICE
         ========================================================= -->

    @if (isCompleted)
    {
        <div class="completed-notice">

            <div class="completed-icon">
                <i class="fa-solid fa-check"></i>
            </div>

            <div>
                <strong>Evaluation Submitted</strong>

                <span>
                    This evaluation has already been completed and is available for review.
                </span>
            </div>

        </div>
    }


    <!-- =========================================================
         PROPOSAL INFORMATION
         ========================================================= -->

    <div class="card-section">

        <div class="section-title">

            <div class="section-icon">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <div>
                <h3>Research Proposal</h3>

                <p>
                    Proposal information
                </p>
            </div>

        </div>


        @if (Model.Proposal != null)
        {
            <div class="proposal-content">

                <div class="research-title">

                    <label>RESEARCH TITLE</label>

                    <h2>
                        @Model.Proposal.Title
                    </h2>

                </div>


                <div class="proposal-details">

                    <!-- STUDENT -->

                    <div class="detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-user-graduate"></i>
                        </div>

                        <div>

                            <label>STUDENT</label>

                            <strong>

                                @if (Model.Proposal.Student != null &&
                                     Model.Proposal.Student.User != null)
                                {
                                    @Model.Proposal.Student.User.FirstName
                                    @: @Model.Proposal.Student.User.LastName
                                }
                                else
                                {
                                    <span>Not available</span>
                                }

                            </strong>

                        </div>

                    </div>


                    <!-- QUALIFICATION -->

                    <div class="detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-graduation-cap"></i>
                        </div>

                        <div>

                            <label>QUALIFICATION</label>

                            <strong>

                                @if (Model.Proposal.Student != null)
                                {
                                    @Model.Proposal.Student.Qualification
                                }
                                else
                                {
                                    <span>Not available</span>
                                }

                            </strong>

                        </div>

                    </div>


                    <!-- STUDY TYPE -->

                    <div class="detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-book-open"></i>
                        </div>

                        <div>

                            <label>STUDY TYPE</label>

                            <strong>

                                @if (Model.Proposal.Student != null)
                                {
                                    @Model.Proposal.Student.StudyType
                                }
                                else
                                {
                                    <span>Not available</span>
                                }

                            </strong>

                        </div>

                    </div>


                    <!-- STATUS -->

                    <div class="detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-circle-info"></i>
                        </div>

                        <div>

                            <label>STATUS</label>

                            <strong>
                                <span class="status-badge">
                                    @Model.Proposal.Status
                                </span>
                            </strong>

                        </div>

                    </div>

                </div>

            </div>
        }

    </div>


    <!-- =========================================================
         PROPOSAL DOCUMENT
         ========================================================= -->

    <div class="card-section proposal-document-section">

        <div class="section-title">

            <div class="section-icon">
                <i class="fa-solid fa-file-pdf"></i>
            </div>

            <div>

                <h3>Proposal Document</h3>

                <p>
                    View the research proposal submitted by the student.
                </p>

            </div>

        </div>


        <div class="proposal-document-content">

            @if (Model.Proposal != null &&
                 !string.IsNullOrWhiteSpace(Model.Proposal.DocumentPath))
            {
                <div class="document-info">

                    <div class="document-icon">
                        <i class="fa-solid fa-file-lines"></i>
                    </div>

                    <div class="document-details">

                        <strong>
                            Research Proposal Document
                        </strong>

                        <span>
                            Open the submitted proposal document to review
                            the student's research before completing the evaluation.
                        </span>

                    </div>

                    <a href="@Url.Action(
            "ViewDocument",
            "Evaluators",
            new { id = Model.Proposal.ProposalID })"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="view-document-button">

                        <i class="fa-solid fa-arrow-up-right-from-square"></i>

                        View Proposal

                    </a>
                </div>
            }
            else
            {
                <div class="no-proposal-document">

                    <i class="fa-solid fa-file-circle-exclamation"></i>

                    <div>

                        <strong>
                            Proposal document not available
                        </strong>

                        <span>
                            No proposal document has been uploaded for this proposal.
                        </span>

                    </div>

                </div>
            }

        </div>

    </div>



    <!-- =========================================================
         EVALUATION
         ========================================================= -->

    <div class="card-section">

        <div class="section-title">

            <div class="section-icon gold">
                <i class="fa-solid fa-list-check"></i>
            </div>

            <div>

                <h3>Evaluation Criteria</h3>

                <p>
                    Award a rating from 1 to 5 for each criterion.
                    Ratings of 1, 2 and 3 require an explanatory comment.
                </p>

            </div>

        </div>


        @using (Html.BeginForm(
            "Review",
            "Evaluators",
            FormMethod.Post,
            new { id = "evaluationForm" }))
        {
            @Html.AntiForgeryToken()

            @Html.HiddenFor(m => m.EvaluationID)
            @Html.HiddenFor(m => m.ProposalID)

            @Html.ValidationSummary(
                true,
                "",
                new { @class = "validation-summary" })


            <!-- =================================================
                 CRITERIA
                 ================================================= -->

            if (Model.Criteria != null && Model.Criteria.Any())
            {
                for (int i = 0; i < Model.Criteria.Count; i++)
                {
                    var criterion = Model.Criteria[i];

                    <div class="criterion">

                        <div class="criterion-top">

                            <div class="criterion-number">
                                @(i + 1)
                            </div>

                            <div class="criterion-heading">

                                <h4>
                                    @criterion.CriterionName
                                </h4>

                                @if (!string.IsNullOrWhiteSpace(criterion.Description))
                                {
                                    <p>
                                        @criterion.Description
                                    </p>
                                }

                            </div>

                            <div class="max-score">

                                <span>MAX MARK</span>

                                <strong>
                                    @criterion.MaxScore.ToString("0.##")
                                </strong>

                            </div>

                        </div>


                        @Html.HiddenFor(
                            m => m.Criteria[i].CriterionID)


                        <!-- =================================================
                             RATING
                             ================================================= -->

                        <div class="rating-area">

                            <div class="rating-header">

                                <label class="input-label">
                                    Award Rating
                                </label>

                                <span class="rating-help">
                                    1 = Poor &nbsp; | &nbsp;
                                    3 = Satisfactory &nbsp; | &nbsp;
                                    5 = Excellent
                                </span>

                            </div>


                            @if (!isCompleted)
                            {
                                <div class="rating-options">

                                    @for (int mark = 1; mark <= 5; mark++)
                                    {
                                        <label class="rating-option">

                                            @Html.RadioButtonFor(
                                                m => m.Criteria[i].Rating,
                                                mark,
                                                new
                                                {
                                                    @class = "rating-radio",
                                                    data_index = i
                                                })

                                            <span class="rating-number">
                                                @mark
                                            </span>

                                        </label>
                                    }

                                </div>


                                <div class="rating-conversion">

                                    <i class="fa-solid fa-circle-info"></i>

                                    <span>
                                        Criterion rating:
                                    </span>

                                    <strong class="criterion-score-display"
                                            data-index="@i">

                                        @(criterion.Rating.HasValue
                                            ? criterion.Rating.Value.ToString("0")
                                            : "—")

                                    </strong>

                                    <span>
                                        / 5
                                    </span>

                                </div>


                                @Html.ValidationMessageFor(
                                    m => m.Criteria[i].Rating,
                                    "",
                                    new { @class = "field-error" })
                            }
                            else
                            {
                                <div class="completed-rating">

                                    <i class="fa-solid fa-star"></i>

                                    <strong>
                                        @(criterion.Rating.HasValue
                                            ? criterion.Rating.Value.ToString("0")
                                            : "—")
                                    </strong>

                                    <span>
                                        / 5
                                    </span>

                                </div>
                            }

                        </div>


                        <!-- =================================================
                             CRITERION COMMENTS
                             ================================================= -->

                        @if (!isCompleted)
                        {
                            <div class="criterion-comments"
                                 data-comment-section="@i">

                                <label class="input-label criterion-note-label">

                                    <i class="fa-solid fa-comment"></i>

                                    Evaluator's Note

                                    <span class="comment-requirement"
                                          data-comment-label="@i">
                                        Optional for ratings 4–5
                                    </span>

                                </label>

                                <p class="comment-help"
                                   data-comment-help="@i">
                                    Add a short explanation supporting the mark awarded.
                                </p>


                                @Html.TextAreaFor(
                                    m => m.Criteria[i].Comments,
                                    new
                                    {
                                        @class = "criterion-comment-input",
                                        rows = 3,
                                        data_comment_input = i,
                                        placeholder = "Write a note explaining the mark awarded..."
                                    })

                                <span class="criterion-comment-error"
                                      data-comment-error="@i">
                                </span>

                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(criterion.Comments))
                        {
                            <div class="existing-comment">

                                <label>

                                    <i class="fa-solid fa-comment"></i>

                                    Evaluator's Note

                                </label>

                                <p>
                                    @criterion.Comments
                                </p>

                            </div>
                        }

                    </div>
                }
            }
            else
            {
                <div class="no-criteria">

                    <i class="fa-solid fa-circle-exclamation"></i>

                    <h4>
                        No Evaluation Criteria Available
                    </h4>

                    <p>
                        Evaluation criteria have not yet been configured.
                    </p>

                </div>
            }


            <!-- =================================================
                 SCORE SUMMARY
                 ================================================= -->

            <div class="score-summary">

                <div class="score-summary-header">

                    <div>

                        <label>
                            EVALUATION SCORE
                        </label>

                        <h3>
                            Automatically calculated from criterion ratings
                        </h3>

                    </div>

                    <i class="fa-solid fa-calculator"></i>

                </div>


                <div class="score-grid">

                    <!-- TOTAL MARKS -->

                    <div class="score-box">

                        <span>
                            TOTAL MARKS
                        </span>

                        <strong id="totalRating">
                            @(Model.TotalScore.HasValue
                                ? Model.TotalScore.Value.ToString("0.##")
                                : "0")
                        </strong>

                        <small>
                            / @maximumScore.ToString("0.##")
                        </small>

                    </div>


                    <!-- CRITERIA -->

                    <div class="score-box">

                        <span>
                            CRITERIA
                        </span>

                        <strong id="criteriaCount">
                            @criteriaCount
                        </strong>

                        <small>
                            / @criteriaCount
                        </small>

                    </div>


                    <!-- FINAL MARK -->

                    <div class="score-box">

                        <span>
                            FINAL MARK
                        </span>

                        <strong id="finalMark">
                            @(Model.ConvertedScore.HasValue
                                ? Model.ConvertedScore.Value.ToString("0.00")
                                : "0.00")
                        </strong>

                        <small>
                            / 10
                        </small>

                    </div>


                    <!-- PERCENTAGE -->

                    <div class="score-box main-score">

                        <span>
                            PERCENTAGE
                        </span>

                        <strong id="overallScore">
                            @(Model.OverallScore.HasValue
                                ? Model.OverallScore.Value.ToString("0.00")
                                : "0.00")
                        </strong>

                        <small>
                            %
                        </small>

                    </div>

                </div>


                <div class="score-explanation">

                    <i class="fa-solid fa-circle-info"></i>

                    <span>
                        Each criterion carries a maximum of 5 marks.
                        The @criteriaCount criteria produce a maximum of
                        @maximumScore.ToString("0.##") marks.
                        The total is converted to a final mark out of 10
                        and displayed as a percentage.
                    </span>

                </div>

            </div>


            <!-- =================================================
                 RECOMMENDATION
                 ================================================= -->

            <div class="form-section">

                <div class="form-title">

                    <h3>
                        <i class="fa-solid fa-gavel"></i>
                        Recommendation
                    </h3>

                    <p>
                        Select the final recommendation for this research proposal.
                    </p>

                </div>


                @if (!isCompleted)
                {
                    <div class="recommendations">

                        <!-- APPROVED -->

                        <label class="recommendation">

                            @Html.RadioButtonFor(
                                m => m.Recommendation,
                                "Approved")

                            <span class="recommendation-icon approved-icon">
                                <i class="fa-solid fa-check"></i>
                            </span>

                            <span class="recommendation-text">

                                <strong>
                                    Approved
                                </strong>

                                <small>
                                    Proposal meets the required standards and may proceed.
                                </small>

                            </span>

                        </label>


                        <!-- APPROVED WITH CHANGES -->

                        <label class="recommendation">

                            @Html.RadioButtonFor(
                                m => m.Recommendation,
                                "Approved with Changes")

                            <span class="recommendation-icon changes-icon">
                                <i class="fa-solid fa-check-double"></i>
                            </span>

                            <span class="recommendation-text">

                                <strong>
                                    Approved with Changes
                                </strong>

                                <small>
                                    Minor changes are required, but the student does not resubmit.
                                </small>

                            </span>

                        </label>


                        <!-- REVISION REQUIRED -->

                        <label class="recommendation">

                            @Html.RadioButtonFor(
                                m => m.Recommendation,
                                "Revision Required")

                            <span class="recommendation-icon revision-icon">
                                <i class="fa-solid fa-rotate"></i>
                            </span>

                            <span class="recommendation-text">

                                <strong>
                                    Revision Required
                                </strong>

                                <small>
                                    Significant changes are required and the proposal must be resubmitted.
                                </small>

                            </span>

                        </label>


                        <!-- REJECTED -->

                        <label class="recommendation">

                            @Html.RadioButtonFor(
                                m => m.Recommendation,
                                "Rejected")

                            <span class="recommendation-icon rejected-icon">
                                <i class="fa-solid fa-xmark"></i>
                            </span>

                            <span class="recommendation-text">

                                <strong>
                                    Rejected
                                </strong>

                                <small>
                                    The proposal is not accepted in its current form.
                                </small>

                            </span>

                        </label>

                    </div>


                    <div class="recommendation-guide">

                        <div class="recommendation-guide-title">
                            <i class="fa-solid fa-circle-info"></i>
                            Recommendation Guide
                        </div>

                        <div class="recommendation-guide-grid">

                            <div>
                                <strong>Approved with Changes</strong>
                                <span>
                                    Minor corrections may be communicated to the student.
                                    No resubmission for evaluator review is required.
                                </span>
                            </div>

                            <div>
                                <strong>Revision Required</strong>
                                <span>
                                    Significant changes are required. The student must revise
                                    and resubmit the proposal for further evaluation.
                                </span>
                            </div>

                            <div>
                                <strong>Rejected</strong>
                                <span>
                                    The proposal is not accepted. Any future submission follows
                                    the applicable new proposal process.
                                </span>
                            </div>

                        </div>

                    </div>


                    @Html.ValidationMessageFor(
                        m => m.Recommendation,
                        "",
                        new { @class = "field-error" })
                }
                else
                {
                    <div class="completed-recommendation">

                        <span class="recommendation-status">

                            <i class="fa-solid fa-circle-check"></i>

                        </span>

                        <div>

                            <label>
                                FINAL RECOMMENDATION
                            </label>

                            <strong>
                                @Model.Recommendation
                            </strong>

                        </div>

                    </div>
                }

            </div>


            <!-- =================================================
                 OVERALL COMMENTS
                 ================================================= -->

            <div class="form-section">

                <div class="form-title">

                    <h3>
                        <i class="fa-solid fa-comment-dots"></i>
                        Evaluator Comments
                    </h3>

                    <p>
                        Provide your overall feedback on the proposal.
                        Overall comments are required for every recommendation.
                    </p>

                </div>


                @if (!isCompleted)
                {
                    @Html.TextAreaFor(
                        m => m.Comments,
                        new
                        {
                            @class = "overall-comments",
                            rows = 5,
                            placeholder = "Enter your overall evaluation comments..."
                        })

                    @Html.ValidationMessageFor(
                        m => m.Comments,
                        "",
                        new { @class = "field-error" })
                }
                else
                {
                    <div class="completed-comments">

                        @if (!string.IsNullOrWhiteSpace(Model.Comments))
                        {
                            @Model.Comments
                        }
                        else
                        {
                            <span>
                                No comments were provided.
                            </span>
                        }

                    </div>
                }

            </div>


            <!-- =================================================
                 ACTIONS
                 ================================================= -->

            <div class="evaluation-actions">

                <a href="@Url.Action("Proposals", "Evaluators")"
                   class="back-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Back to Proposals

                </a>


                @if (!isCompleted)
                {
                    <button type="submit"
                            class="submit-button"
                            id="submitEvaluationButton">

                        <i class="fa-solid fa-paper-plane"></i>

                        Submit Evaluation

                    </button>
                }

            </div>

        }

    </div>

</div>


<style>

    /* =========================================================
       PAGE
       ========================================================= */

    .evaluator-review-page {
        max-width: 1050px;
        margin: 0 auto;
        padding: 28px 15px 55px;
        color: #26384d;
        font-family: Arial, Helvetica, sans-serif;
    }


    /* =========================================================
       SUCCESS / ERROR
       ========================================================= */

    .evaluation-success-message,
    .evaluation-error-message {
        display: flex;
        align-items: center;
        gap: 13px;
        border-radius: 10px;
        padding: 14px 16px;
        margin-bottom: 20px;
    }

    .evaluation-success-message {
        background: #eef8f2;
        border: 1px solid #cfe5d7;
    }

    .evaluation-error-message {
        background: #fff1f1;
        border: 1px solid #efcaca;
    }

    .success-message-icon,
    .error-message-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .success-message-icon {
        background: #d8f0e0;
        color: #267a49;
    }

    .error-message-icon {
        background: #f9dddd;
        color: #a94442;
    }

    .evaluation-success-message strong,
    .evaluation-error-message strong {
        display: block;
        font-size: 13px;
    }

    .evaluation-success-message strong {
        color: #21683f;
    }

    .evaluation-error-message strong {
        color: #9f3432;
    }

    .evaluation-success-message span,
    .evaluation-error-message span {
        display: block;
        font-size: 12px;
        margin-top: 3px;
        line-height: 1.45;
    }

    .evaluation-success-message span {
        color: #4f6e5d;
    }

    .evaluation-error-message span {
        color: #7e4b4b;
    }


    /* =========================================================
       HEADER
       ========================================================= */

    .review-header {
        background: #001B44;
        color: #ffffff;
        border-radius: 14px;
        padding: 27px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .header-label {
        color: #FDB913;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1.1px;
        margin-bottom: 7px;
    }

    .review-header h2 {
        margin: 0;
        font-size: 26px;
        font-weight: 700;
        line-height: 1.25;
    }

    .review-header p {
        margin: 8px 0 0;
        color: #e1e9f2;
        font-size: 13px;
        line-height: 1.5;
    }

    .header-icon {
        width: 55px;
        height: 55px;
        border-radius: 11px;
        background: #FDB913;
        color: #001B44;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }


    /* =========================================================
       COMPLETED
       ========================================================= */

    .completed-notice {
        display: flex;
        align-items: center;
        gap: 13px;
        background: #eef8f2;
        border: 1px solid #cfe5d7;
        border-radius: 10px;
        padding: 13px 16px;
        margin-bottom: 20px;
    }

    .completed-icon {
        width: 37px;
        height: 37px;
        border-radius: 50%;
        background: #d8f0e0;
        color: #267a49;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
    }

    .completed-notice strong {
        display: block;
        color: #21683f;
        font-size: 13px;
    }

    .completed-notice span {
        display: block;
        color: #4f6e5d;
        font-size: 12px;
        margin-top: 3px;
        line-height: 1.45;
    }


    /* =========================================================
       CARDS
       ========================================================= */

    .card-section {
        background: #ffffff;
        border: 1px solid #dfe5eb;
        border-radius: 13px;
        overflow: hidden;
        margin-bottom: 20px;
    }

    .section-title {
        display: flex;
        align-items: center;
        gap: 12px;
        background: #fafbfd;
        border-bottom: 1px solid #e3e8ed;
        padding: 18px 22px;
    }

    .section-icon {
        width: 40px;
        height: 40px;
        border-radius: 8px;
        background: #eaf0f7;
        color: #001B44;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 15px;
    }

        .section-icon.gold {
            background: #fff4d5;
            color: #b87900;
        }

    .section-title h3 {
        margin: 0;
        font-size: 17px;
