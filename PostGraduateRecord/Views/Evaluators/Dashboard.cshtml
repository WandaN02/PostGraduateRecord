
@model PostGraduateRecord.ViewModels.EvaluatorDashboardViewModel

@{
    ViewBag.Title = "Evaluator Dashboard";
    Layout = "~/Views/Shared/_EvaluatorLayout.cshtml";
}

<link href="~/Content/Supervisor.css" rel="stylesheet" />

<div class="evaluator-dashboard">

    <!-- =========================
         PAGE HEADER
    ========================== -->

    <div class="dashboard-header">

        <div>

            <h2>
                Evaluator Dashboard
            </h2>

            <p>
                Review and evaluate postgraduate research proposals assigned to you.
            </p>

        </div>

    </div>


    <!-- =========================
         DASHBOARD CARDS
    ========================== -->

    <div class="dashboard-cards">

        <a href="@Url.Action("Proposals", "Evaluators")"
           class="dashboard-card">

            <div class="card-icon">
                <i class="fa-solid fa-file-lines"></i>
            </div>

            <div class="card-content">

                <span class="card-number">
                    @Model.AssignedProposals
                </span>

                <span class="card-label">
                    Assigned Proposals
                </span>

            </div>

            <div class="card-arrow">
                <i class="fa-solid fa-chevron-right"></i>
            </div>

        </a>


        <a href="@Url.Action("Proposals", "Evaluators", new { status = "Pending" })"
           class="dashboard-card pending-card">

            <div class="card-icon">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div class="card-content">

                <span class="card-number">
                    @Model.PendingReviews
                </span>

                <span class="card-label">
                    Pending Reviews
                </span>

            </div>

            <div class="card-arrow">
                <i class="fa-solid fa-chevron-right"></i>
            </div>

        </a>


        <a href="@Url.Action("CompletedReviews", "Evaluators")"
           class="dashboard-card completed-card">

            <div class="card-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="card-content">

                <span class="card-number">
                    @Model.CompletedReviews
                </span>

                <span class="card-label">
                    Completed Reviews
                </span>

            </div>

            <div class="card-arrow">
                <i class="fa-solid fa-chevron-right"></i>
            </div>

        </a>


        <a href="@Url.Action("Deadlines", "Evaluators")"
           class="dashboard-card deadline-card">

            <div class="card-icon">
                <i class="fa-solid fa-calendar-days"></i>
            </div>

            <div class="card-content">

                <span class="card-number">
                    @Model.UpcomingDeadlines
                </span>

                <span class="card-label">
                    Upcoming Deadlines
                </span>

            </div>

            <div class="card-arrow">
                <i class="fa-solid fa-chevron-right"></i>
            </div>

        </a>

    </div>


    <!-- =========================
         MAIN DASHBOARD CONTENT
    ========================== -->

    <div class="dashboard-sections">


        <!-- =========================
             PENDING REVIEWS
        ========================== -->

        <div class="dashboard-section">

            <div class="section-header">

                <div>

                    <h3>
                        <i class="fa-solid fa-clock"></i>
                        Pending Reviews
                    </h3>

                    <p>
                        Proposals that require your evaluation.
                    </p>

                </div>

                <a href="@Url.Action("Proposals", "Evaluators", new { status = "Pending" })">

                    View All

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            @if (Model.Evaluations != null &&
                 Model.Evaluations.Any(x =>
                     string.IsNullOrWhiteSpace(x.Recommendation)))
            {

                <div class="evaluation-list">

                    @foreach (var evaluation in Model.Evaluations
                        .Where(x => string.IsNullOrWhiteSpace(x.Recommendation))
                        .Take(5))
                    {

                        <div class="evaluation-item">

                            <div class="evaluation-icon">

                                <i class="fa-solid fa-file-lines"></i>

                            </div>


                            <div class="evaluation-info">

                                <h4>

                                    @(evaluation.Proposal != null
                                        ? evaluation.Proposal.Title
                                        : "Research Proposal")

                                </h4>

                                @if (evaluation.Proposal != null &&
                                     evaluation.Proposal.Student != null &&
                                     evaluation.Proposal.Student.User != null)
                                {

                                    <p>

                                        Student:
                                        @evaluation.Proposal.Student.User.FirstName
                                        @evaluation.Proposal.Student.User.LastName

                                    </p>

                                }

                            </div>


                            <div class="evaluation-action">

                                <a href="@Url.Action(
                                    "Review",
                                    "Evaluators",
                                    new { id = evaluation.EvaluationID })"
                                   class="btn-review">

                                    <i class="fa-solid fa-clipboard-check"></i>

                                    Review

                                </a>

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-dashboard">

                    <i class="fa-solid fa-circle-check"></i>

                    <h4>
                        No pending reviews
                    </h4>

                    <p>
                        You currently have no proposals waiting for evaluation.
                    </p>

                </div>

            }

        </div>


        <!-- =========================
             COMPLETED REVIEWS
        ========================== -->

        <div class="dashboard-section">

            <div class="section-header">

                <div>

                    <h3>
                        <i class="fa-solid fa-circle-check"></i>
                        Completed Reviews
                    </h3>

                    <p>
                        Evaluations you have already completed.
                    </p>

                </div>

                <a href="@Url.Action("Proposals", "Evaluators")">

                    View All

                    <i class="fa-solid fa-arrow-right"></i>

                </a>

            </div>


            @if (Model.Evaluations != null &&
                 Model.Evaluations.Any(x =>
                     !string.IsNullOrWhiteSpace(x.Recommendation)))
            {

                <div class="evaluation-list">

                    @foreach (var evaluation in Model.Evaluations
                        .Where(x => !string.IsNullOrWhiteSpace(x.Recommendation))
                        .Take(5))
                    {

                        <div class="evaluation-item">

                            <div class="evaluation-icon completed">

                                <i class="fa-solid fa-check"></i>

                            </div>


                            <div class="evaluation-info">

                                <h4>

                                    @(evaluation.Proposal != null
                                        ? evaluation.Proposal.Title
                                        : "Research Proposal")

                                </h4>


                                @if (evaluation.Proposal != null &&
                                     evaluation.Proposal.Student != null &&
                                     evaluation.Proposal.Student.User != null)
                                {

                                    <p>

                                        Student:
                                        @evaluation.Proposal.Student.User.FirstName
                                        @evaluation.Proposal.Student.User.LastName

                                    </p>

                                }


                                <span class="recommendation">

                                    @evaluation.Recommendation

                                </span>

                            </div>


                            <div class="evaluation-action">

                                <a href="@Url.Action(
                                    "Review",
                                    "Evaluators",
                                    new { id = evaluation.EvaluationID })"
                                   class="btn-view">

                                    <i class="fa-solid fa-eye"></i>

                                    View

                                </a>

                            </div>

                        </div>

                    }

                </div>

            }
            else
            {

                <div class="empty-dashboard">

                    <i class="fa-solid fa-folder-open"></i>

                    <h4>
                        No completed reviews
                    </h4>

                    <p>
                        Your completed evaluations will appear here.
                    </p>

                </div>

            }

        </div>

    </div>

</div>


<!-- =========================================================
     AI ASSISTANT BUTTON
========================================================= -->

<button type="button"
        id="openEvaluatorAI"
        class="ai-floating-button"
        title="Open SPGS AI Assistant">

    <span class="ai-sparkle">
        ✦
    </span>

    <span>
        AI Assistant
    </span>

</button>


<!-- =========================================================
     AI ASSISTANT PANEL
========================================================= -->

<div id="evaluatorAI"
     class="ai-assistant-panel">

    <div class="ai-header">

        <div class="ai-header-title">

            <div class="ai-icon">
                ✦
            </div>

            <div>

                <strong>
                    SPGS AI Assistant
                </strong>

                <small>
                    Evaluator Assistant
                </small>

            </div>

        </div>


        <button type="button"
                id="closeEvaluatorAI"
                class="ai-close"
                title="Close">

            <i class="fa-solid fa-xmark"></i>

        </button>

    </div>


    <div class="ai-status">

        <span class="ai-online-dot"></span>

        Ready to assist

    </div>


    <div id="evaluatorAIChat"
         class="ai-chat-body">

        <div class="ai-message ai-message-bot">

            <div class="ai-message-icon">
                ✦
            </div>

            <div class="ai-message-content">

                <strong>
                    Hello!
                </strong>

                <p>
                    I'm your SPGS Evaluator AI Assistant.
                    I can help you with assigned proposals,
                    evaluation criteria, scores and deadlines.
                </p>

            </div>

        </div>


        <div class="ai-suggestions">

            <button type="button"
                    class="ai-suggestion"
                    data-question="Show me my pending evaluations.">

                Show my pending evaluations

            </button>


            <button type="button"
                    class="ai-suggestion"
                    data-question="What evaluation criteria should I use?">

                What are my evaluation criteria?

            </button>


            <button type="button"
                    class="ai-suggestion"
                    data-question="Which evaluations are due soon?">

                Which evaluations are due soon?

            </button>


            <button type="button"
                    class="ai-suggestion"
                    data-question="How many evaluations have I completed?">

                How many evaluations have I completed?

            </button>

        </div>

    </div>


    <div class="ai-input-area">

        <input type="text"
               id="evaluatorAIInput"
               placeholder="Ask the AI Assistant..."
               autocomplete="off" />

        <button type="button"
                id="evaluatorAISend"
                title="Send">

            <i class="fa-solid fa-paper-plane"></i>

        </button>

    </div>

</div>


<!-- =========================================================
     AI STYLING
========================================================= -->

<style>

    /* =====================================================
       AI FLOATING BUTTON
    ====================================================== */

    .ai-floating-button {
        position: fixed;
        right: 30px;
        bottom: 30px;
        z-index: 9998;
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 13px 19px;
        border: none;
        border-radius: 30px;
        background: #001B44;
        color: #ffffff;
        font-size: 14px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: 0 8px 25px rgba(0, 27, 68, 0.30);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }

        .ai-floating-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 30px rgba(0, 27, 68, 0.38);
        }

    .ai-sparkle {
        color: #FDB913;
        font-size: 19px;
    }


    /* =====================================================
       AI PANEL
    ====================================================== */

    .ai-assistant-panel {
        position: fixed;
        right: 30px;
        bottom: 88px;
        width: 390px;
        height: 570px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 15px 45px rgba(0, 0, 0, 0.22);
        overflow: hidden;
        z-index: 9999;
        display: none;
        flex-direction: column;
        border: 1px solid #e0e5ec;
    }

        .ai-assistant-panel.ai-open {
            display: flex;
            animation: aiPanelOpen 0.2s ease;
        }

    @@keyframes aiPanelOpen {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =====================================================
       HEADER
    ====================================================== */

    .ai-header {
        background: #001B44;
        color: #ffffff;
        padding: 15px 17px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .ai-header-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .ai-icon {
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #FDB913;
        color: #001B44;
        font-size: 20px;
        font-weight: bold;
    }

    .ai-header-title strong {
        display: block;
        font-size: 14px;
    }

    .ai-header-title small {
        display: block;
        margin-top: 2px;
        opacity: 0.75;
        font-size: 11px;
    }

    .ai-close {
        width: 34px;
        height: 34px;
        border: none;
        border-radius: 50%;
        background: transparent;
        color: #ffffff;
        cursor: pointer;
        font-size: 16px;
    }

        .ai-close:hover {
            background: rgba(255,255,255,0.12);
        }


    /* =====================================================
       STATUS
    ====================================================== */

    .ai-status {
        padding: 8px 17px;
        font-size: 11px;
        color: #667085;
        border-bottom: 1px solid #edf0f4;
    }

    .ai-online-dot {
        display: inline-block;
        width: 7px;
        height: 7px;
        margin-right: 5px;
        border-radius: 50%;
        background: #20a464;
    }


    /* =====================================================
       CHAT BODY
    ====================================================== */

    .ai-chat-body {
        flex: 1;
        padding: 17px;
        overflow-y: auto;
        background: #f7f9fc;
    }

    .ai-message {
        display: flex;
        gap: 9px;
        margin-bottom: 15px;
    }

    .ai-message-icon {
        flex-shrink: 0;
        width: 28px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #001B44;
        color: #FDB913;
        font-size: 14px;
    }

    .ai-message-content {
        max-width: 285px;
        background: #ffffff;
        padding: 11px 13px;
        border-radius: 4px 13px 13px 13px;
        box-shadow: 0 2px 7px rgba(0,0,0,0.05);
        color: #333333;
        font-size: 13px;
        line-height: 1.5;
    }

        .ai-message-content strong {
            color: #001B44;
        }

        .ai-message-content p {
            margin: 4px 0 0;
        }


    /* =====================================================
       SUGGESTIONS
    ====================================================== */

    .ai-suggestions {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-left: 37px;
    }

    .ai-suggestion {
        width: 100%;
        text-align: left;
        padding: 9px 11px;
        border: 1px solid #dce3ed;
        border-radius: 9px;
        background: #ffffff;
        color: #001B44;
        font-size: 12px;
        cursor: pointer;
        transition: all 0.15s ease;
    }

        .ai-suggestion:hover {
            border-color: #001B44;
            background: #f1f5fa;
        }


    /* =====================================================
       USER MESSAGE
    ====================================================== */

    .ai-user-message {
        justify-content: flex-end;
        position: relative;
    }

        .ai-user-message .ai-message-content {
            position: relative;
            background: #001B44;
            color: #ffffff;
            border-radius: 13px 4px 13px 13px;
            /* Extra space at bottom for the hidden pencil */
            padding: 11px 13px 30px 13px;
        }

            .ai-user-message .ai-message-content strong {
                color: #FDB913;
            }


    /* =====================================================
       CHATGPT-STYLE HOVER EDIT BUTTON
    ====================================================== */

    .ai-edit-button {
        position: absolute;
        right: 7px;
        bottom: 6px;
        width: 25px;
        height: 25px;
        padding: 0;
        margin: 0;
        border: none;
        outline: none;
        border-radius: 6px;
        background: transparent;
        color: rgba(255, 255, 255, 0.60);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        line-height: 1;
        cursor: pointer;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.15s ease, visibility 0.15s ease, background 0.15s ease, color 0.15s ease;
    }


    /*
       Pencil appears when hovering over the
       user's message.
    */

    .ai-user-message:hover .ai-edit-button {
        opacity: 1;
        visibility: visible;
    }


    /*
       Pencil hover state.
    */

    .ai-edit-button:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #ffffff;
    }


    .ai-edit-button:active {
        background: rgba(255, 255, 255, 0.18);
    }


    /*
       Keyboard accessibility.
    */

    .ai-edit-button:focus-visible {
        opacity: 1;
        visibility: visible;
        box-shadow: 0 0 0 2px rgba(253, 185, 19, 0.35);
    }


    /* =====================================================
       EDITING INPUT
    ====================================================== */

    .ai-input-area input.ai-editing {
        border-color: #FDB913 !important;
        box-shadow: 0 0 0 3px rgba(253, 185, 19, 0.15) !important;
    }


    /* =====================================================
       INPUT
    ====================================================== */

    .ai-input-area {
        display: flex;
        padding: 11px;
        background: #ffffff;
        border-top: 1px solid #e5e9ef;
    }

        .ai-input-area input {
            flex: 1;
            height: 42px;
            border: 1px solid #d6dce5;
            border-radius: 10px 0 0 10px;
            padding: 0 12px;
            outline: none;
            font-size: 13px;
        }

            .ai-input-area input:focus {
                border-color: #001B44;
            }

        .ai-input-area button {
            width: 45px;
            border: none;
            border-radius: 0 10px 10px 0;
            background: #001B44;
            color: #FDB913;
            cursor: pointer;
        }

            .ai-input-area button:hover {
                background: #002b5c;
            }


    /* =====================================================
       RESPONSIVE
    ====================================================== */

    @@media (max-width: 600px) {

        .ai-assistant-panel {
            right: 10px;
            left: 10px;
            bottom: 78px;
            width: auto;
            height: 70vh;
            border-radius: 15px;
        }

        .ai-floating-button {
            right: 15px;
            bottom: 15px;
        }

        .ai-message-content {
            max-width: calc(100vw - 100px);
        }

        .ai-user-message .ai-message-content {
            max-width: calc(100vw - 75px);
        }
        /*
           Keep the pencil available on touch devices.
        */

        .ai-user-message:focus-within .ai-edit-button {
            opacity: 1;
            visibility: visible;
        }
    }
</style>

<!-- =========================================================
     AI JAVASCRIPT
========================================================= -->

<script>
    var evaluatorAIUrl = '@Url.Action("Ask", "AI")';
</script>

<script src="@Url.Content("~/Content/evaluator-ai.js")"></script>