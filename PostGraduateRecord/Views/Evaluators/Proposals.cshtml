@model IEnumerable<PostGraduateRecord.Models.Evaluation>

@{
    string currentStatus = ViewBag.CurrentStatus as string;

    bool isPendingPage =
        !string.IsNullOrWhiteSpace(currentStatus) &&
        currentStatus.Equals("Pending", StringComparison.OrdinalIgnoreCase);

    string pageTitle = isPendingPage
        ? "Pending Reviews"
        : "Assigned Proposals";

    string pageDescription = isPendingPage
        ? "Research proposals that require your evaluation."
        : "Review and evaluate postgraduate research proposals assigned to you.";

    string emptyTitle = isPendingPage
        ? "No Pending Reviews"
        : "No Assigned Proposals";

    string emptyDescription = isPendingPage
        ? "There are currently no research proposals waiting for your evaluation."
        : "There are currently no research proposals assigned to you for evaluation.";

    ViewBag.Title = pageTitle;
    Layout = "~/Views/Shared/_EvaluatorLayout.cshtml";
}


<div class="evaluator-proposals-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="page-header">

        <div>

            <div class="page-label">

                <i class="fa-solid fa-clipboard-list"></i>

                EVALUATOR WORKSPACE

            </div>

            <h2>

                @pageTitle

            </h2>

            <p>

                @pageDescription

            </p>

        </div>


        <div class="header-icon">

            @if (isPendingPage)
            {
                <i class="fa-solid fa-clock"></i>
            }
            else
            {
                <i class="fa-solid fa-file-signature"></i>
            }

        </div>

    </div>


    <!-- =====================================================
         PROPOSAL LIST
         ===================================================== -->

    @if (Model != null && Model.Any())
    {
        <div class="proposal-list">

            @foreach (var evaluation in Model)
            {
                var isEvaluated =
                    !string.IsNullOrWhiteSpace(evaluation.Recommendation);


                <div class="proposal-item">


                    <!-- =================================================
                         LEFT ICON
                         ================================================= -->

                    <div class="proposal-number">

                        <div class="proposal-icon">

                            @if (isPendingPage)
                            {
                                <i class="fa-solid fa-clock"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-file-lines"></i>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         MAIN INFORMATION
                         ================================================= -->

                    <div class="proposal-main">

                        <div class="proposal-type">

                            POSTGRADUATE RESEARCH PROPOSAL

                        </div>


                        <h3>

                            @if (evaluation.Proposal != null)
                            {
                                @evaluation.Proposal.Title
                            }
                            else
                            {
                                <span>Research Proposal</span>
                            }

                        </h3>


                        <!-- STUDENT -->

                        @if (evaluation.Proposal != null &&
                             evaluation.Proposal.Student != null &&
                             evaluation.Proposal.Student.User != null)
                        {
                            <div class="student-info">

                                <span>

                                    <i class="fa-solid fa-user-graduate"></i>

                                    @evaluation.Proposal.Student.User.FirstName
                                    @evaluation.Proposal.Student.User.LastName

                                </span>

                            </div>
                        }


                        <!-- =================================================
                             META INFORMATION
                             ================================================= -->

                        <div class="proposal-meta">


                            <!-- PROPOSAL STATUS -->

                            <div class="meta-item">

                                <span class="meta-label">

                                    Proposal Status

                                </span>


                                @if (evaluation.Proposal != null &&
                                     !string.IsNullOrWhiteSpace(
                                         evaluation.Proposal.Status))
                                {
                                    <span class="status proposal-status">

                                        @evaluation.Proposal.Status

                                    </span>
                                }
                                else
                                {
                                    <span class="status status-neutral">

                                        Not specified

                                    </span>
                                }

                            </div>


                            <!-- EVALUATION STATUS -->

                            <div class="meta-item">

                                <span class="meta-label">

                                    Evaluation

                                </span>


                                @if (isEvaluated)
                                {
                                    <span class="status evaluated">

                                        <i class="fa-solid fa-check"></i>

                                        Evaluated

                                    </span>
                                }
                                else
                                {
                                    <span class="status pending">

                                        <i class="fa-solid fa-clock"></i>

                                        Pending Evaluation

                                    </span>
                                }

                            </div>


                            <!-- DEADLINE -->

                            @if (evaluation.Deadline.HasValue)
                            {
                                <div class="meta-item">

                                    <span class="meta-label">

                                        Deadline

                                    </span>


                                    <span class="deadline">

                                        <i class="fa-solid fa-calendar"></i>

                                        @evaluation.Deadline.Value.ToString(
                                            "dd MMM yyyy")

                                    </span>

                                </div>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         ACTION
                         ================================================= -->

                    <div class="proposal-action">

                        <a href="@Url.Action(
                                    "Review",
                                    "Evaluators",
                                    new
                                    {
                                        id = evaluation.EvaluationID
                                    })"
                           class="review-button">

                            @if (isEvaluated)
                            {
                                <i class="fa-solid fa-eye"></i>

                                <span>
                                    View Evaluation
                                </span>
                            }
                            else
                            {
                                <i class="fa-solid fa-pen-to-square"></i>

                                <span>
                                    Review Proposal
                                </span>
                            }

                            <i class="fa-solid fa-arrow-right arrow"></i>

                        </a>

                    </div>

                </div>
            }

        </div>
    }
    else
    {
        <!-- =====================================================
             EMPTY STATE
             ===================================================== -->

        <div class="empty-state">

            <div class="empty-icon">

                @if (isPendingPage)
                {
                    <i class="fa-solid fa-circle-check"></i>
                }
                else
                {
                    <i class="fa-solid fa-folder-open"></i>
                }

            </div>


            <h3>

                @emptyTitle

            </h3>


            <p>

                @emptyDescription

            </p>

        </div>
    }


    <!-- =====================================================
         BACK TO DASHBOARD
         ===================================================== -->

    <div class="back-button-container">

        <a href="@Url.Action("Dashboard", "Evaluators")"
           class="back-dashboard-button">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Dashboard

        </a>

    </div>


</div>



<style>

    /* =====================================================
       PAGE
       ===================================================== */

    .evaluator-proposals-page {
        max-width: 1080px;
        margin: 0 auto;
        padding: 25px 10px 50px;
    }


    /* =====================================================
       HEADER
       ===================================================== */

    .page-header {
        background: #002b5c;
        color: white;
        border-radius: 14px;
        padding: 24px 28px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }


    .page-label {
        color: #FDB913;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 1px;
        margin-bottom: 5px;
    }


    .page-header h2 {
        margin: 0;
        color: white;
        font-size: 27px;
        font-weight: 700;
    }


    .page-header p {
        margin: 5px 0 0;
        color: #d8e3ee;
        font-size: 13px;
    }


    .header-icon {
        width: 52px;
        height: 52px;
        border-radius: 11px;
        background: #FDB913;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }


    /* =====================================================
       PROPOSAL LIST
       ===================================================== */

    .proposal-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }


    /* =====================================================
       PROPOSAL ITEM
       ===================================================== */

    .proposal-item {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 18px;
        transition: .2s ease;
    }


        .proposal-item:hover {
            border-color: #b9c7d5;
            box-shadow: 0 5px 16px rgba(0,0,0,.06);
            transform: translateY(-1px);
        }


    /* =====================================================
       ICON
       ===================================================== */

    .proposal-number {
        flex-shrink: 0;
    }


    .proposal-icon {
        width: 48px;
        height: 48px;
        border-radius: 10px;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }


    /* =====================================================
       MAIN
       ===================================================== */

    .proposal-main {
        flex: 1;
        min-width: 0;
    }


    .proposal-type {
        font-size: 9px;
        font-weight: 700;
        color: #7b8997;
        letter-spacing: .8px;
        margin-bottom: 3px;
    }


    .proposal-main h3 {
        margin: 0 0 8px;
        color: #172b4d;
        font-size: 17px;
        font-weight: 700;
        line-height: 1.35;
    }


    /* =====================================================
       STUDENT
       ===================================================== */

    .student-info {
        color: #657586;
        font-size: 12px;
        margin-bottom: 13px;
    }


        .student-info i {
            color: #002b5c;
            margin-right: 5px;
        }


    /* =====================================================
       META
       ===================================================== */

    .proposal-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
    }


    .meta-item {
        display: flex;
        align-items: center;
        gap: 7px;
    }


    .meta-label {
        color: #8793a0;
        font-size: 10px;
        font-weight: 600;
    }


    /* =====================================================
       STATUS BADGES
       ===================================================== */

    .status {
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
    }


    .proposal-status {
        background: #eaf2fa;
        color: #005a9c;
    }


    .evaluated {
        background: #e8f6ed;
        color: #278653;
    }


    .pending {
        background: #fff4d6;
        color: #9a6900;
    }


    .status-neutral {
        background: #edf0f2;
        color: #6c757d;
    }


    /* =====================================================
       DEADLINE
       ===================================================== */

    .deadline {
        color: #6d7782;
        font-size: 10px;
        font-weight: 600;
    }


        .deadline i {
            color: #002b5c;
            margin-right: 3px;
        }


    /* =====================================================
       ACTION
       ===================================================== */

    .proposal-action {
        flex-shrink: 0;
    }


    .review-button {
        display: flex;
        align-items: center;
        gap: 7px;
        background: #002b5c;
        color: white;
        padding: 10px 13px;
        border-radius: 7px;
        text-decoration: none;
        font-size: 11px;
        font-weight: 600;
        transition: .2s;
    }


        .review-button:hover {
            background: #001f43;
            color: white;
            text-decoration: none;
        }


        .review-button .arrow {
            color: #FDB913;
            margin-left: 3px;
        }


    /* =====================================================
       EMPTY STATE
       ===================================================== */

    .empty-state {
        background: white;
        border: 1px solid #e0e5ea;
        border-radius: 12px;
        text-align: center;
        padding: 55px 20px;
    }


    .empty-icon {
        width: 60px;
        height: 60px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: #eef4f9;
        color: #002b5c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }


    .empty-state h3 {
        color: #172b4d;
        font-size: 19px;
    }


    .empty-state p {
        color: #7c8996;
        font-size: 13px;
    }


    /* =====================================================
       BACK BUTTON
       ===================================================== */

    .back-button-container {
        width: 100%;
        display: flex;
        justify-content: flex-start;
        margin-top: 30px;
    }


    .back-dashboard-button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 18px;
        background: #002147;
        color: white;
        border: 1px solid #002147;
        border-radius: 6px;
        text-decoration: none !important;
        font-size: 13px;
        font-weight: 600;
        transition: all .2s ease;
    }


        .back-dashboard-button:hover {
            background: #FDB913;
            color: #002147;
            border-color: #FDB913;
            text-decoration: none !important;
        }



        .back-dashboard-button i {
            font-size: 12px;
            transition: transform .2s ease;
        }


        .back-dashboard-button:hover i {
            transform: translateX(-3px);
        }


    /* =====================================================
       RESPONSIVE
       ===================================================== */

    @@media (max-width: 800px) {

        .proposal-item {
            align-items: flex-start;
            flex-wrap: wrap;
        }


        .proposal-main {
            width: calc(100% - 70px);
        }


        .proposal-action {
            width: 100%;
            margin-left: 66px;
        }


        .review-button {
            justify-content: center;
        }


        .back-button-container {
            justify-content: stretch;
        }


        .back-dashboard-button {
            width: 100%;
        }
    }
</style>